# Dependencies & build output
node_modules/
dist/
coverage/
.turbo/

# OS / logs
.DS_Store
*.log

# Environment & secrets
.env
*.env.local

# Runtime secrets and credentials
starlingai.json
config/mail/accounts.json
# Local, machine-specific config overrides. A `*.local.jsonc` shard is loaded by the
# config globber AFTER its numbered sibling (30-auth.jsonc < 30-auth.local.jsonc), so it
# overrides — put deployment-specific secrets (e.g. a private OIDC issuer/clientId, dev
# insecureSkipTlsVerify) in e.g. config/gateway/30-auth.local.jsonc instead of editing the
# tracked shard, and they can never be committed by accident.
config/**/*.local.jsonc

# Runtime data directories (any location in the repo). Everything under a .starlingai/
# dir is runtime state (credentials, audit log, memory, auto-distilled skills) and stays
# out of git.
**/.starlingai/**
!**/.starlingai/

# Generated reports, exports, and operator-collected artifacts
artifacts/

# Claude Code local settings (per-user permission allowlist, etc.)
.claude/

# Transpiled JS in web source (accidental build artifacts)
packages/web/src/**/*.js

# Runtime artifacts
computer-remote-build.log
*.deb

# Temporary development/patch scripts (root-level only — anchored so they
# don't shadow real files like scripts/devtools/search.mjs)
/fix.cjs
/fix_parse.cjs
/fix_parse_smart.cjs
/fix_tags.cjs
/patch_*.cjs
/patch_*.mjs
/safe_patch.cjs
/search.mjs
/skip_tests*.js
/skip/

# Agent-mutable runtime overrides (local state)
workspace/runtime/runtime.overrides.json

# Agent-generated run output (decks, papers, fetched images, …). Tools root all
# generated artifacts under workspace/generated/; older builds also left a stray
# workspace/presentation/. None of it is source — keep it out of the repo.
workspace/generated/
workspace/presentation/

# Document-RAG uploads: files attached in chat or uploaded to the user/workspace
# library, plus the .registry.json manifest. Runtime user data embedded into
# engram — not source. (packages/core/workspace/ is test/dev residue.)
workspace/uploads/
packages/core/workspace/uploads/

# Test artifacts
packages/core/tmp/
# Some tests write process.cwd()-relative paths; when vitest runs from
# packages/core this lands in a doubled path. Nothing legitimate lives here.
packages/core/packages/
# Stray test/scratch output
test-output.txt
# vitest json-reporter artifact (embeds an absolute machine path — never source)
packages/core/.vitest-web-tools.json

# Eval run reports (pnpm agents:evaluate / scenes:evaluate output) — run artifacts,
# not source. Keep eval PLANS (agent-eval.jsonc) tracked; ignore the generated reports.
packages/core/baseline.json
packages/core/candidate.json
packages/core/out.json
packages/core/*.eval.json

# npm lockfiles — this is a pnpm workspace (packageManager: pnpm). A stray
# package-lock.json causes install drift and forces CI to --no-frozen-lockfile.
package-lock.json
packages/*/package-lock.json

# Per-developer editor preferences (file associations for the generated
# config). Tracking it forces every fork to carry a diff on this path.
/.vscode/settings.json

# Machine-specific workspace shards (agents/scenes/jobs that depend on services
# only this machine runs). Same convention as config/**/*.local.jsonc: loaded after
# the numbered sibling, never committed.
workspace/**/*.local.jsonc
