# Dependencies & build output
node_modules/
dist/
coverage/
.turbo/

# OS / logs
.DS_Store
*.log

# Environment & secrets
.env
*.env.local

# Runtime secrets and credentials
starlingai.json
config/mail/accounts.json

# Runtime data directories (any location in the repo)
**/.starlingai/

# Generated reports, exports, and operator-collected artifacts
artifacts/

# Claude Code local settings (per-user permission allowlist, etc.)
.claude/

# Transpiled JS in web source (accidental build artifacts)
packages/web/src/**/*.js

# Runtime artifacts
computer-remote-build.log
*.deb

# Temporary development/patch scripts (root-level only — anchored so they
# don't shadow real files like scripts/devtools/search.mjs)
/fix.cjs
/fix_parse.cjs
/fix_parse_smart.cjs
/fix_tags.cjs
/patch_*.cjs
/patch_*.mjs
/safe_patch.cjs
/search.mjs
/skip_tests*.js
/skip/

# Agent-mutable runtime overrides (local state)
workspace/runtime/runtime.overrides.json

# Test artifacts
packages/core/tmp/
