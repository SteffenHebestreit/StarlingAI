    "turns": [
      {
        "message": "Für einen Lagerbericht der Nordlicht Werkzeuge GmbH (http://www.nordlicht-werkzeuge.test/) brauche ich drei unabhängige Teilergebnisse. Verteile sie auf passende Spezialisten und lass sie parallel arbeiten:\n1. Welche Artikel liegen laut /lager.html mit ihrem Gesamtbestand unter dem Mindestbestand?\n2. Was kosten 30 Stück NW-3102 inklusive Mengenrabatt und Versand laut /preise.html und dem Produktkatalog?\n3. Was bedeutet der Fehlercode E22 laut /dokumentation.html?\nFasse die drei Ergebnisse danach in einer kurzen Übersicht zusammen. --auto",
        "effort": "medium",
        "timeoutMs": 1200000,
        "expect": {
          "status": "ok",
          "reply": {
            "matches": [
              "NW-?\\s?1203|Wasserwaage",
              "245[,.]64|267[,.]00",
              "blockiert|blocked|stalled|jammed"
            ],
            "minChars": 80
          },
          "events": {
            "must": [
              {
                "type": "agent_routing_evaluated",
                "min": 0,
                "max": 50
              },
              {
                "type": "sub_agent_started",
                "where": {
                  "data.stage": {
                    "exists": false
                  }
                },
                "min": 2,
                "max": 16
              }
            ],
            "mustNot": [
              {
                "type": "delegation_routing_rounds_exhausted"
              },
              {
                "type": "sub_agent_staged_build_detected"
              }
            ]
          },
          "agents": {
            "mustRunAny": [
              "researcher",
              "browser_agent",
              "source_verifier",
              "summarizer"
            ]
          }
        }
      }
    ],
    "timeoutMs": 1500000
  },
