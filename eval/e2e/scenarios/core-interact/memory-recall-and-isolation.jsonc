// Durable memory across sessions, and its per-user boundary.
//
// How memory is scoped (packages/core/src): with auth on, the durable USER scope lives in
// <user-memory>/users/<segment(userId)>/ (memory/service.ts memoryDirForScope -> runtime/user-scope.ts
// userScopedDir), and every session's working root — where the WORKSPACE scope lives — is
// <workspace>/users/<segment>/ (agent/session.ts:256 userWorkspaceRoot). So whichever scope the
// assistant picks, "eval" and "eval-viewer" should never share a record. Exception to watch: the
// MemGraph mirror stamps a tenant on user-scope nodes only (memory/graph-service.ts:48), and its
// always-injected "Critical Memory" layer returns every workspace-scope decision/preference node
// whatever its tenant (memory/graph-service.ts:233-237) — the viewer scenario below is the one that
// notices if a preference stored by eval in the workspace scope reaches another account that way.
//
// The two scenarios are in one file so a default run takes them in this order. Memory is durable, so
// once the first has run on a stack, the second is meaningful in every later run too; on a fresh
// stack with only the second selected it passes without proving anything.
//
// Event names verified against packages/core/src:
//   tool_call_requested {tool, args}  agent/runtime.ts:4234
//   guardrail_blocked                 agent/turn-prepare.ts:109, :125
// HTTP: GET /api/memory/entries?scope=user|workspace&query=… -> {"scope","total","returned","records"}
//   gateway/memory-graph-routes.ts:21-46 (user scope = the caller's own bucket; workspace scope = the
//   shared deployment root, not a per-user root).
[
  {
    id: "core-ix-memory-recall-new-session",
    title: "Memory: a personal preference told in one session is recalled in a new one",
    group: "core",
    tags: ["memory", "smoke"],
    description: "Turn 1 tells the assistant a synthetic preference and asks it to keep it; the turn must store it (memory_store, or user_model_update for an understanding of the user). Turn 2 runs in a fresh session of the same account — no shared history — and must name the preference. Afterwards the data layer is checked from the other account: eval-viewer's own user bucket and the shared workspace store must not hold the record. Protects: durable cross-session recall per account, and that the per-user partition keeps the record out of other accounts' stores.",
    requires: ["model"],
    identity: "eval",
    timeoutMs: 900000,
    steps: [
      {
        kind: "turn",
        id: "remember",
        message: "Bitte merke dir dauerhaft, auch für künftige Chats: Meine Lieblingsteesorte ist „Polarstern-Rooibos“. Das ist eine persönliche Vorliebe von mir.",
        timeoutMs: 300000,
        expect: {
          events: {
            must: [
              { type: "tool_call_requested", where: { "data.tool": { in: ["memory_store", "user_model_update"] } } },
            ],
            mustNot: [{ type: "guardrail_blocked" }],
          },
        },
      },
      { kind: "newSession" },
      {
        kind: "turn",
        id: "recall",
        message: "Welche Teesorte trinke ich am liebsten?",
        timeoutMs: 300000,
        expect: {
          reply: { includes: ["Polarstern"] },
        },
      },
      // The other account's views of the stores (read-only GETs, any role).
      { kind: "http", as: "eval-viewer", method: "GET", path: "/api/memory/entries?scope=user&query=polarstern", expect: { status: 200, bodyIncludes: ["\"total\":0"] } },
      { kind: "http", as: "eval-viewer", method: "GET", path: "/api/memory/entries?scope=workspace&query=polarstern", expect: { status: 200, bodyIncludes: ["\"total\":0"] } },
    ],
  },
  {
    id: "core-ix-memory-viewer-isolation",
    title: "Memory: another account cannot recall eval's preference",
    group: "core",
    tags: ["memory", "isolation", "smoke"],
    description: "Runs as eval-viewer and asks for the preference eval stored in core-ix-memory-recall-new-session. The answer must not contain it: not through memory_search/recall_context, the receptionist's memory capsule, or the per-turn memory guidance (including the MemGraph 'Critical Memory' layer, which serves workspace-scope preferences without a tenant filter). Depends on the scenario above having stored the fact at least once on this stack.",
    requires: ["model"],
    identity: "eval-viewer",
    timeoutMs: 600000,
    steps: [
      {
        kind: "turn",
        id: "ask-other-account",
        message: "Welche Teesorte trinke ich am liebsten? Wenn du dazu nichts über mich gespeichert hast, sag das einfach.",
        timeoutMs: 300000,
        expect: {
          reply: { excludes: ["Polarstern"] },
        },
      },
    ],
  },
]
