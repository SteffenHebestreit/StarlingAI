{
  "integrations": {
    "n8n": {
      "baseUrl": "http://host.docker.internal:5678",
      "apiKey": "$N8N_API_KEY",
      "leadsWebhookUrl": "http://host.docker.internal:5678/webhook/starlingai-leads",
      "markAppliedWebhookUrl": "http://host.docker.internal:5678/webhook/starlingai-apply"
    }
  },
  "webhooks": {
    "notify_ops": {
      "description": "Notify an internal webhook about important runtime events.",
      "url": "https://example.com/hooks/starlingai",
      "method": "POST",
      "headers": {
        "Authorization": "$OPS_WEBHOOK_TOKEN"
      }
    }
  },
  "sites": {
    // Stored site logins for browser-driven automation. `password` is a SECRET
    // reference ($ENV or secret:...), never a literal value. Under multi-user auth,
    // bind a site to specific accounts with `allowedUsers` (omit/empty = shared).
    "github.com": {
      "username": "your-username",
      "password": "$GITHUB_PASSWORD",
      "loginUrl": "https://github.com/login"
    }
    // A richer entry with named URLs + operator notes the agent should know:
    // ,"app.example.com": {
    //   "username": "you@example.com",
    //   "password": "$APP_EXAMPLE_PASSWORD",
    //   "loginUrl": "https://app.example.com/login",
    //   "urls": {
    //     "dashboard": "https://app.example.com/",
    //     "projects": "https://app.example.com/projects"
    //   },
    //   "notes": "Any UI hints the browser agent needs when driving this site.",
    //   "allowedUsers": ["alice"]
    // }
  },
  "approvalChannels": {
    "slack-approvals": {
      "type": "slack",
      "webhookUrl": "https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK_URL",
      "timeoutMs": 600000
    }
  }
}
