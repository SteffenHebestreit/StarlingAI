{
  "multimodal": {
    "maxUploadBytes": 20971520,
    "files": {
      "baseUrl": "http://fastapi-mcp-template:8000",
      "toolName": "file_to_markdown",
      "timeoutMs": 60000,
      // Vision LLM — same model as the primary, Qwen 3.6 is multimodal (vision + tool calling).
      // Address the llama-swap SELECTOR, not one station's local id: `qwen3.6-35b-a3b` names a
      // single instance, so pinning it forfeits the second station (the same defect a7e210e fixed
      // for the swarm). Measured: both stations decode an image and answer from it, so the
      // selector is free to route either way.
      // visionTimeoutMs is separate from timeoutMs (which is for the file-to-markdown service)
      // because local LLM inference on large screenshots can take well over 60 s.
      "visionModel": "lmstudio/qwen",
      "visionTimeoutMs": 120000
    },
    // Speech-to-text. baseUrl comes from SAI_MULTIMODAL_STT_URL at runtime.
    // Default backend assumption: Qwen3-ASR from tts-stt-playground
    // (https://github.com/SteffenHebestreit/tts-stt-playground) on its
    // default port 5002. That service exposes a custom POST /transcribe with
    // multipart `audio` field — no /v1/audio/transcriptions endpoint — so we
    // pin `api: "transcribe-only"` to skip the OpenAI-style attempt and
    // avoid the wasted 404 round-trip every transcription would otherwise
    // incur. Switch to "openai-compatible" for whisper-cpp-style endpoints,
    // or "auto" if the upstream supports both surfaces.
    "stt": {
      "baseUrl": "",
      "api": "transcribe-only",
      "model": "whisper-1",
      "timeoutMs": 60000
    },
    // Text-to-speech. baseUrl comes from SAI_MULTIMODAL_TTS_URL at runtime.
    // Default backend assumption: Qwen3-TTS from tts-stt-playground on its
    // default port 5004. That service uses the qwen-compatible surface
    // (POST /tts with JSON {text, lang, speaker, instruct}, /voices, /models,
    // /clone, /voices/save for voice cloning). Switch to "openai-compatible"
    // when targeting OpenAI's /v1/audio/speech format instead.
    "tts": {
      "baseUrl": "",
      "api": "qwen-compatible",
      "model": "",
      "defaultLanguage": "English",
      "defaultSpeaker": "Vivian",
      "defaultQuality": "medium",
      "timeoutMs": 60000
    },
    // Two tiers behind one OpenAI-compatible endpoint, POST {baseUrl}/images/generations.
    // The response carries base64 in `b64_json` — there is no file host behind it — and both
    // tiers run FIXED at 1024x1024, rejecting any other size rather than resampling.
    //
    // The tiers are a cost choice, not a quality dial:
    //   image          ~10 s, neural accelerator, costs the chat models nothing measurable
    //   image-quality  ~120 s (up to 150 s, plus ~25 s to reload weights after 10 min idle),
    //                  worker station's graphics chip, drops that station's chat throughput
    //                  by ~70% while it runs, one at a time cluster-wide
    //
    // `generate_image` defaults to the fast tier; an agent must ask for `tier: "quality"`,
    // and the tool description says what that spends.
    "imageGeneration": {
      // Left EMPTY on purpose: with api "openai-compatible" the loader fills it from
      // SAI_PRIMARY_MODEL_URL, the same variable the chat provider follows, so the two
      // cannot drift. Set it here to point images somewhere else.
      "baseUrl": "",
      "api": "openai-compatible",
      "model": "image",
      "qualityModel": "image-quality",
      // Generous for a ~10 s tier: the cluster serialises image requests, so a second caller
      // waits in a queue rather than failing, and that wait is part of this budget.
      "timeoutMs": 120000,
      // 150 s worst case + ~25 s weight reload + margin. Below ~180 s this abandons requests
      // that were going to succeed.
      "qualityTimeoutMs": 210000,
      "defaultWidth": 1024,
      "defaultHeight": 1024,
      "defaultSteps": 20,
      "defaultGuidanceScale": 7
    },
    "wakeWord": {
      "enabled": false,
      "language": "en-US",
      "keywords": [
        "Hey Guarded",
        "Okay Guarded",
        "Luna"
      ],
      "stopPhrases": [
        "stop recording",
        "end recording",
        "stop listening",
        "luna stop"
      ],
      "silenceTimeoutMs": 4000
    }
  }
}