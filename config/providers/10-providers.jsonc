{
  "providers": {
    "lmstudio": {
      // Fallback when SAI_LMSTUDIO_URL is unset. host.docker.internal reaches a
      // model server (LM Studio / Ollama / llama.cpp / vLLM) on the Docker host.
      // The gateway overlays SAI_LMSTUDIO_URL over this when set (config/loader.ts).
      "baseUrl": "http://host.docker.internal:1234/v1",
      "apiKey": "lm-studio",
      "timeoutMs": 30000,
      "maxRetries": 3
    }
  }
}