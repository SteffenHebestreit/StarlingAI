{
  "agents": {
    "performance": {
      "promptBudgetChars": 36000,
      // Leaf sub-agent timeout. The 60s default is too short for slower local
      // models (e.g. qwen3.6-35b-a3b research turns take 150s+); two timeouts trip
      // the coordinator cascade-timeout and force partial synthesis. 240s lets
      // sub-agents finish on this hardware.
      "subAgentTurnSloMs": 240000,
      // Relay long deliverables (guides/reports) in full instead of cutting them
      // off at the 10k default. qwen3.6-35b-a3b has a large context window, so 24k
      // chars of deliverable fits the relay prompt.
      "maxDelegatedResultChars": 24000,
      // Drop the 16 always-on intent-routing bullets from the base prompt and
      // rely on the per-turn intent classifier (which injects richer, intent-
      // specific guidance only when it fires). Safe to re-enable now that the
      // embedding fix restored semantic agent search/classification — eval-gated
      // with computer-use vs pentest and server-admin disambiguation cases.
      "taskConditionalPrompt": true
    }
  },
  "gateway": {
    "port": 8765,
    "restPort": 8766,
    "bindHost": "loopback",
    "sessionTtlMs": 3600000,
    "turnTimeoutMs": 1800000,
    "publicUrl": "https://starlingai.example.com",
    "corsAllowedOrigins": [
      "https://chat.starlingai.example.com"
    ]
  },
  // First-contact fast lane: trivial conversational turns ("hi") are answered by
  // the small routing-tier model (agents.defaults.model.tiers.routing) with a tiny
  // prompt, skipping the full system prompt + swarm. Fail-safe — any miss escalates
  // to the full path. Requires a routing tier to be configured.
  "receptionist": {
    "enabled": true,
    "maxResponseChars": 400,
    "alwaysEscalateTerms": []
  }
}
