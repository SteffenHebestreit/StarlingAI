{
  "agents": {
    "performance": {
      "promptBudgetChars": 36000,
      // Leaf sub-agent timeout. The 60s default is too short for slower local
      // models (e.g. qwen3.6-35b research turns take 150s+); two timeouts trip
      // the coordinator cascade-timeout and force partial synthesis. 240s lets
      // sub-agents finish on this hardware.
      "subAgentTurnSloMs": 240000,
      // Relay long deliverables (guides/reports) in full instead of cutting them
      // off at the 10k default. qwen3.6-35b has a large context window, so 24k
      // chars of deliverable fits the relay prompt.
      "maxDelegatedResultChars": 24000,
      // Drop the 16 always-on intent-routing bullets from the base prompt and
      // rely on the per-turn intent classifier (which injects richer, intent-
      // specific guidance only when it fires). Safe to re-enable now that the
      // embedding fix restored semantic agent search/classification — eval-gated
      // with computer-use vs pentest and server-admin disambiguation cases.
      "taskConditionalPrompt": true,
      // Lift the ~13KB orchestration block (Swarm Rules → Orchestration Strategy)
      // out of the always-on prompt; inject it back only on orchestration-intent
      // turns. A direct answer pays a ~half-size prompt; delegation tools + the
      // honesty/core sections stay regardless. Validating routing quality here.
      "splitOrchestrationPrompt": true,
      // ON since 2026-09-20, because the reason it was off has been fixed.
      //
      // It was turned off on 2026-09-08 with this finding: the warm-up fired
      // complete([system: leanBase, user: "."], []) — an EMPTY tools array — at 3,439 prompt
      // tokens, while every orchestrator turn carries the 36-tool block at ~13,700. The
      // server renders tools at or before the system text, so the warmed prefix was not a
      // prefix of the real one. Probed then: the real TOOLS shape took 21.83s cold, 21.46s
      // straight after the tool-less warm, and 0.42s after one identical TOOLS call. The
      // warm-up bought 0.4s of 21.8s. That note ended "re-enable only alongside warming the
      // tool block too, which is what would actually have to change."
      //
      // agent/cache-warmer.ts now sends the orchestrator's real tool array, derived from the
      // same getMainAssistantToolNames() the turn uses, so the two move together. Measured
      // against the serving model with THIS deployment's real base prompt and real 36-tool
      // block (15,508 prompt tokens), a unique marker per trial so no trial warms another:
      //   old warmer, tool-less warm then a real turn -> 17,394 ms
      //   FIXED warmer, tooled warm then the same turn ->     456 ms
      //   no warm-up at all, cold                      -> 16,887 ms
      //
      // Note the first line: the old warmer was WORSE THAN NOTHING. It burned 7.3s of GPU
      // and left the real turn slower than an unwarmed one, because it filled the cache with
      // a prefix no turn shares.
      //
      // What to watch now that it is on: the warmer costs one background completion per idle
      // window, which the 2026-09-08 audit measured at ~4.4s of GPU. It aborts the instant a
      // real turn starts, so it never queues ahead of a user — but on a busy box that GPU
      // time is not free. If first-turn TTFT does not fall to roughly a warm prefill, turn it
      // back off rather than leaving it running.
      "promptCacheWarmKeeper": true,
      // Also warm the two forced orchestration heads a source-sensitive or artifact turn switches to (record_plan,
      // then execute_plan, on lean base + orchestration module). Live probe E9, 2026-09-26, 3 of 3 reps: the two
      // forced calls reused their heads, 2.8 s of prompt each against 12.2 / 11.7 s cold, the full head stayed
      // cached, and they stayed warm after six 26k-token prompts in between. Cost: ~10.6 + 10.2 s of idle GPU once,
      // ~1.5 s per head to re-warm, only while no turn runs. After a rebuild, check that the forced calls'
      // provider_model_call rows show cacheN >= 9k; if they do not, turn this back off.
      "promptCacheWarmForcedHeads": true
    }
  },
  "gateway": {
    "port": 8765,
    "sessionTtlMs": 3600000,
    "turnTimeoutMs": 1800000,
    // EVL-401: relative session.create workspacePath overrides (gateway-routed eval
    // fixtures) resolve under the compose-mounted repo root instead of the process
    // CWD, with containment enforced. Only affects sessions that pass an explicit
    // relative workspacePath; normal sessions are untouched.
    "sessionWorkspaceRoot": "/workspace",
    "publicUrl": "https://starlingai.example.com",
    "corsAllowedOrigins": [
      "https://chat.starlingai.example.com"
    ]
  },
  // First-contact fast lane: trivial conversational turns ("hi") are answered by
  // the small routing-tier model (agents.defaults.model.tiers.routing) with a tiny
  // prompt, skipping the full system prompt + swarm. Fail-safe — any miss escalates
  // to the full path. Requires a routing tier to be configured.
  "receptionist": {
    "enabled": true,
    "maxResponseChars": 400,
    "alwaysEscalateTerms": [],
    // vLLM "Confidence" attempt — DISABLED after the de-lexicalization. Its safety premise was
    // that the Stage-0 gate (buildDynamicTurnGuidance) escalates any task/research/mail/server/
    // computer turn BEFORE the relaxed confident-answer gate. The de-lex GUTTED
    // buildDynamicTurnGuidance (it now returns null for those turns — no keyword classification),
    // so confidence-attempt lost its gate and began confidently REFUSING capability turns (live
    // eval: "read my emails" → "I can't access email", never escalated to mail_agent). With this
    // off, the receptionist is smalltalk-only and escalates any real request to the orchestrator,
    // which then delegates (its base prompt now carries the never-refuse-a-delegatable-capability
    // rule). Re-enable only once task-intent is detected semantically at intake, not by keywords.
    "confidenceAttempt": false,
    "confidenceAttemptMaxChars": 400
  }
}
