{
  // TEST ENABLEMENT — staged orchestration (docs/staged-orchestration.md).
  // Turns the staged-pipeline stages ON for THIS deployment so you can validate
  // latency + answer quality on real turns before flipping the schema defaults.
  // Safe + reversible: delete this file (then `sai config build`, or just the next
  // `sai start --build`) to revert every stage to its default (off). All three are
  // soft / fail-open and cannot block delivery.
  "orchestration": {
    // S1 — the terminal forced-synthesis call uses a compact ~1K synthesis-only
    // prompt instead of the ~24.7K orchestrator monolith. Cannot route/delegate.
    "leanSynthesisPrompt": true,

    // S3 — final QA delivery gate: after the existing correctness gates, the answer
    // is verdicted against the plan's acceptance criteria; on a FAIL the flaws go
    // back for an improvement pass, looping until it passes or maxRounds is reached.
    // Only fires when a plan with acceptance criteria exists. Watch the audit stream
    // for flow_verification_passed{reason:"qa_delivery_loop"}.
    "qaDeliveryLoop": true,
    "qaDeliveryLoopMaxRounds": 2,

    // S4 — parallel discovery prefetch: on an escalated turn, agent + workflow
    // discovery run concurrently up-front and inject a compact [CAPABILITY CANDIDATES]
    // capsule so the coordinator plans without separate search_agents/search_workflows
    // tool rounds. Watch the audit stream for the discovery_prefetch event (fires
    // early, on iteration 0 — the cheapest stage to confirm is live).
    "discoveryPrefetch": true,

    // Honesty: stop the orchestrator dressing a from-memory answer up as freshly-
    // sourced ("based on current market data…", "as of today…") when it retrieved
    // nothing this turn. Sibling of the user-profile fabrication guard. Enabled here
    // to validate on this deployment before flipping the schema default.
    "freshnessHonestyGuard": true,

    // Proactive user-profile retrieval. On a userOwnFacts turn (a question about the
    // user's OWN background/skills/fit), the RUNTIME retrieves their memory + attached
    // documents (CV/profile in the personal OR workspace library) up-front and injects
    // the evidence — or an authoritative confirmed-empty marker. Deterministic: it no
    // longer depends on the local model choosing to call recall_context (which it does
    // NOT do reliably — toolCalls=0 on real turns).
    //
    // DISABLED (2026-07): this flag is currently INERT — it gates on a userOwnFacts turn
    // signal that the de-lexicalization hardwired to false (intent-classifier.ts:269), so the
    // prefetch never fires no matter the flag. Enabling it made the eval test dead code. Leave
    // false until a STRUCTURAL userOwnFacts signal is restored in computeDynamicTurnGuidance
    // (and added to its `flags` object so the function doesn't early-return null). See
    // docs/eval-guide-2026-07.md.
    "userProfilePrefetch": false,

    // Citation-honesty guard (audit 1303e254). A sourceSensitive turn that ran NO real
    // web/research execution (no delegation, no SUCCESSFUL workflow, no direct web tool,
    // no shared findings) but whose answer carries URL citations or "verified against N
    // sources" claims is FABRICATING sources — the audited heat-pump answer shipped 7
    // invented 404 links + "auf Basis von 7 Online-Quellen verifiziert" with zero retrieval.
    // Strip the fabricated citations (links → plain label, bare URLs removed, the explicit
    // verification claim neutralized) + prepend the honest unverified caveat, so no 404 link
    // / false "verified" claim ever ships. Structural (language-free); never empties the
    // answer. Watch the audit stream for guardrail_flagged{type:"fabricated_citations_stripped"}.
    "citationHonestyGuard": true,

    // Proactive complement to citationHonestyGuard (session 29796f86: a full fabricated job
    // posting from a pasted URL that was never fetched, + the false "Ich habe die Ausschreibung
    // geladen", with zero web_fetch/delegate). When the user's message STRUCTURALLY carries an
    // actionable http(s) URL and the model tries to answer tool-free in orchestration_only mode,
    // reject once and force a real fetch (reuses the nudge → auto-research → grounded-synthesis
    // path; never dead-ends). Purely structural — a host/topic/language-agnostic URL regex, no
    // keyword table. Enabled for the fresh-instance pass^k eval; watch guardrail/audit for the
    // forced-fetch retry + guardrail_flagged{type:"url_content_unverified_no_fetch"}.
    "urlFetchEnforcement": true,

    // General (no-URL) sibling of urlFetchEnforcement — the completeness sweep (wr555g3x4)
    // found the de-lex also killed the GENERAL force-real-research invariant (only the URL
    // sub-path was restored). A factual/current-events question answered tool-free with a
    // specifics-dense draft (looksLikeUnsourcedSpecificClaims: >=4 number+unit/currency/
    // percent/year/date/code tokens over a 400-char floor — a structural fact-SHAPE count,
    // NO keyword table) is reciting current state from memory as fact (audit fe496ec5). Reject
    // once and force a real research delegation. Enabled for the fresh-instance eval — WATCH for
    // over-fire: it can convert a legitimate direct answer into an unnecessary delegation
    // (guardrail_flagged{type:"tool_free_research_answer_rejected"}); flip false if it fires on
    // general-knowledge questions that did not need research.
    "ungroundedFactualAnswerGuard": true,

    // SEMANTIC tier of the guard above (POST-DRAFT). Kept ON as the BACKSTOP for cases the UP-FRONT
    // classifier below MISSES (false negatives): if a source-sensitive question slips past up-front, the
    // model drafts, and this judge catches PROSE/named-entity fabrication the structural counter (numeric
    // only) is blind to. Cost of the safety net: a 2nd routing call on a non-source-sensitive drafted turn
    // (up-front already said no; this double-checks the draft), and a rare "answer, then research" ONLY
    // when up-front missed AND this fires (the net doing its job). WATCH
    // guardrail_flagged{type:"semantic_ungrounded_factual_detected"} — a high fire rate here means the
    // up-front classifier is missing questions it should catch.
    "semanticUngroundedFactualGuard": true,

    // UP-FRONT source-sensitivity classifier. The two guards above are POST-DRAFT: the model drafts a
    // tool-free answer, it streams, and only THEN is it rejected and research forced — the user sees
    // "answer, then research" (audit a75e1c26 follow-up). This classifies the QUESTION before the first
    // model call (cheap routing tier), and on a positive verdict forces research FIRST (draft suppressed
    // + orchestration forced) → "research, then answer". Enabled for the honesty eval — WATCH for
    // over-fire: it adds a routing call to EVERY orchestration turn (incl. ones that don't need research)
    // and can convert a legitimate direct answer into a delegation; observe
    // guardrail_flagged{type:"upfront_source_sensitive_detected"} and flip false if it fires on
    // general-knowledge/creative/coding turns that did not need research.
    "upfrontSourceSensitiveClassifier": true,

    // Failed-research honesty backstop. When real orchestration RAN this turn and FAILED
    // (forced-synthesis fired / a delegation failed / a partial source-sensitive delegation),
    // don't ship a confident training-data answer as if the research had succeeded — re-anchor
    // in whatever evidence was recovered, or replace a non-transparent draft with an honest
    // "the research did not complete" note. Fires off STRUCTURAL turn-state failure-signals only
    // (no topic/keyword classifier — the old sourceSensitive gate is dead post-de-lex). Enabled
    // for the fresh-instance eval; include a non-source-sensitive failure (e.g. a timed-out code
    // delegation) to confirm it doesn't overwrite a legitimately-useful partial answer.
    "failedResearchHonestyBackstop": true,

    // vLLM "ReMoM" — quorum early-synthesis. parallel_delegate stops blocking on the slowest
    // slice: once ceil(0.6*N) slices SUCCEED, stragglers get an 8s grace then abort, and
    // synthesis proceeds on the quorum (partial share_finding evidence preserved). Cuts
    // tail-latency on fan-outs; falls back to wait-for-all if fewer than the quorum succeed.
    "quorumEarlySynthesis": true,

    // vLLM "Fusion" — disagreement-as-signal. After a fan-out where ≥2 slices succeeded, a
    // cheap routing-tier classifier checks whether their outputs CONFLICT; on disagreement it
    // prepends a [SUB-AGENT DISAGREEMENT] marker so the orchestrator reconciles in synthesis
    // instead of silently averaging conflicting answers. No-op when the slices agree.
    "subAgentDisagreementVerify": true,

    // Run 663ac153 anti-duplication nudges — enabled here for the next pass^k test.
    //
    // write_file regeneration nudge. A builder that hits the completion-token limit mid-write often
    // RE-EMITS the whole file from the top via mode:"overwrite" instead of appending the remainder
    // (that run re-emitted a ~21-item block 3× — ~58k tokens / ~636s). On the 2nd+ near-identical
    // overwrite of a >=500-byte file (>=90% shared prefix over the first 2 KB — structural, no
    // content/topic heuristics) write_file appends a SOFT "use mode:append" nudge. Never blocks the
    // write; a divergent replacement diverges early and is never flagged. WATCH the audit stream for
    // guardrail_flagged{type:"write_file_churn_detected"}; flip false if it nudges on legitimate
    // iterative overwrites.
    "detectWriteChurnOverwrite": true,

    // Cross-agent artifact-reuse directive. Artifacts a sub-agent produces are ALREADY surfaced to
    // later delegated agents via the shared partial-results context, but as a passive "Artifacts
    // generated by this result" list — so agents re-AUTHOR the same content (that run wrote ~50
    // questions 3× across agents). Enabling this turns the list into an explicit "READ (read_file)
    // and REUSE/EXTEND these instead of re-authoring" directive. Structural (artifact paths),
    // advisory only — a later agent may still author a genuinely new variant. WATCH later agents
    // read_file the prior artifact instead of regenerating it.
    "crossAgentArtifactReuse": true,

    // Plan-driven continuation (audit 763394da + 6d3b6ca4 — THE multi-deliverable fix).
    // The post-orchestration disposition defaulted to "synthesize"/relay after the FIRST
    // successful delegation and never consulted the recorded plan, so a "1) paper 2) slides
    // 3) speaker-notes" request that recorded a 4-step plan shipped only step 1 (in run
    // 6d3b6ca4: only the research + verified images, then finishReason
    // single_deliverable_relayed — paper/slides/notes never delegated). When on, a turn that
    // recorded a plan with >=2 steps keeps orchestrating (a [CONTINUE PLAN] directive naming
    // the remaining deliverables) until every planned step has an actual completed tool
    // result this turn. Bounded by the per-turn delegate cap and only extends on SUCCESS, so
    // it cannot loop. WATCH the audit stream for guardrail_flagged{type:"plan_driven_
    // continuation"}; flip false if it over-runs a genuinely-complete single-delegation turn.
    "planDrivenContinuation": true,

    // Autonomous-mode anti-refusal (audit 763394da). `--auto` sets autoApprove but never told
    // the model "execute autonomously, don't ask" — one run answered an --auto artifact build
    // with a clarifying question + "I can't create files" refusal + a false "I verified" claim,
    // zero tool calls. When on, an autoApprove turn whose deliverable-intent saw an artifact
    // request forces the first tool call (existing forceToolChoice path), so a tool-free refusal
    // can't happen. No-op when the model already delegates (e.g. the Opus run). Structural.
    "autonomousModeAntiRefusal": true
  }
}
