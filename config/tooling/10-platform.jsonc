{
  "retrieval": {
    "search": {
      "backend": "searxng",
      "searxngBaseUrl": "http://search.k2o",
      "timeoutMs": 15000
    }
  },
  "computerUse": {
    "enabled": true,
    "visionModel": "lmstudio/qwen3.6-35b-a3b",
    "adapters": {
      "local_vscode": {
        "codePath": "code"
      }
    },
    "remoteAccessService": {
      "baseUrl": "http://computer-remote:8890",
      "authToken": "$SAI_COMPUTER_REMOTE_TOKEN",
      "timeoutMs": 20000,
      "label": "Remote access sidecar"
    },
    "nodes": {
      "desktop": {
        "adapter": "remote_vnc",
        "host": "computer-desktop",
        "port": 5901,
        "protocol": "vnc",
        "credentials": "starling",
        "label": "Ephemeral VNC desktop"
      },
      "win-workstation": {
        "adapter": "remote_rdp",
        "host": "10.10.0.2",
        "port": 3389,
        "protocol": "rdp",
        "credentials": "$SAI_WIN_WORKSTATION_RDP_CREDENTIALS",
        "displayResolution": "1920x1080",
        "label": "Windows PC (10.10.0.2)"
      },
      "n8n-server": {
        "adapter": "remote_ssh",
        "host": "n8n.k2o",
        "port": 22,
        "username": "Steffen",
        "authMethod": "password",
        "credentials": "$SAI_N8N_SSH_PASSWORD",
        "label": "n8n-server"
      }
    },
    "recordingEnabled": true
  },
  "infrastructure": {
    "automation": {
      "profiles": {
        "local_cli": {
          "type": "local-cli",
          "terraformBinary": "terraform",
          "ansibleBinary": "ansible",
          "ansiblePlaybookBinary": "ansible-playbook"
        }
      }
    },
    "virtualization": {
      "profiles": {
        "lab_proxmox": {
          "type": "proxmox",
          "apiUrl": "https://proxmox.example.com:8006",
          "node": "pve-01",
          "tokenId": "root@pam!starlingai",
          "tokenSecret": "$PROXMOX_TOKEN_SECRET"
        }
      }
    }
  },
  "pentest": {
    "serviceUrl": "http://kali-pentest:5010"
  },
  "mcp": {
    "servers": {
      "playwright": {
        "transport": "docker",
        "image": "mcp/playwright:latest",
        "network": "bridge",
        "autoStart": true
      },
      "filesystem": {
        "transport": "stdio",
        "command": "npx",
        "args": [
          "-y",
          "@modelcontextprotocol/server-filesystem",
          "/workspace"
        ],
        "autoStart": true
      }
    }
  }
}