{
  "retrieval": {
    "search": {
      "backend": "searxng",
      // Endpoint comes from the SEARXNG_BASE_URL env (docker-compose defaults it to
      // the bundled self-hosted service, http://searxng:8080). Set SEARXNG_BASE_URL
      // in .env to point at an external instance instead (e.g. http://searxng.example.com).
      "timeoutMs": 15000
    },
    // Cross-encoder reranker (the `reranker` GPU sidecar serving Qwen3-Reranker-0.6B,
    // shared with engram). mode "tei" = POST /rerank {query,texts}.
    "reranker": {
      "enabled": true,
      "mode": "tei",
      "baseUrl": "http://reranker:80",
      "model": "Qwen/Qwen3-Reranker-0.6B",
      "timeoutMs": 15000,
      "topK": 6
    },
    // Document RAG over attached files via the engram graph-RAG service. Files are
    // extracted to Markdown, ingested into engram, and relevant excerpts retrieved
    // per turn (a hint + the few best chunks, not the whole file inlined).
    "documentRag": {
      "enabled": true,
      "engramBaseUrl": "http://engram:8088",
      "autoIngestAttachments": true,
      "injectContext": true,
      // Doc-RAG search BLOCKS first-token, so keep this tight: a healthy engram answers a
      // query in well under 1s. 25s meant a hung/unreachable engram stalled EVERY profile
      // turn for 25s before the model even started (fresh-instance eval, session 9b0414e3).
      // 8s is a fast-fail safety net — if engram genuinely needs longer, it is unhealthy.
      "searchTimeoutMs": 8000,
      "retrievalTopK": 6,
      "candidateTopK": 30,
      "maxContextChars": 6000,
      // Inline the FULL text of small files attached this turn instead of a top-k sample.
      // A CV, offer, or invoice is 2–6k chars: well under the threshold, and semantic
      // top-k over one short document is strictly worse than just reading it — it drops
      // whole sections, and rewriting a CV from a partial sample invents dates and loses
      // roles. Large and prior-turn documents still take the lean retrieval path below.
      "inlineSmallDocuments": true,
      "inlineThresholdChars": 20000,
      // Search the signed-in user's personal library in every conversation (not
      // just the session a file was attached to). Files uploaded on the Documents
      // page → Personal library become available across all of that user's chats.
      "includeUserDocs": true,
      // Search the shared WORKSPACE library in every conversation too. Files uploaded
      // on the Documents page → Workspace library (e.g. a CV/profile shared for the
      // whole workspace) are otherwise invisible to retrieval — the assistant cannot
      // see them via recall_context, the per-turn RAG, or the profile prefetch.
      "includeWorkspaceDocs": true,
      "workspaceName": "workspace",
      // ── July 2026 engram-flag eval round (docs/engram-reevaluation-2026-07.md §5) ──
      // CRAG confidence demotion: when engram reports weak retrieval confidence, the
      // injected [DOCUMENT CONTEXT] is framed as possibly-relevant instead of
      // authoritative. Demote-only — excerpts are never suppressed, the retrieval-
      // failure/existence honesty notes are untouched. Two signals: score_gap (near-tie
      // top hits) and top_rerank_score (best hit weak). MEASURED (2026-07-06, live): the
      // shipped Qwen3-Reranker emits raw LOGITS with WIDE query variance — a strong match
      // scores ~+10, a vaguer phrasing of the same topic ~+0.4, a clearly-irrelevant query
      // ~−11 — and minRerankScore=0 already drops the negatives. So the top_rerank
      // threshold needs per-corpus tuning (see docs/engram-reevaluation-2026-07.md §5 "CRAG
      // tuning") and is left OFF here; score_gap demotion is on but rarely fires on a small
      // corpus. WATCH: false-negative class ("you have no CV") must NOT reappear.
      "confidenceDemotion": true,
      "confidenceMinTopRerank": null,
      // Server-side scope filter: /search carries the active scope sources so the
      // engram store filters in-store (engram v0.9.0+). The client post-filter stays
      // on as defense-in-depth. WATCH:
      // cross-session/cross-user doc isolation (0-leak) + no recall regression on
      // in-scope docs.
      "serverSideScopeFilter": true
    },
    // Knowledge bases: named corpora recursively crawled from documentation sites
    // (wikis, standards like W3C/WAI, product manuals) into engram under kb:<id>
    // sources, then queried with search_knowledge_base. Requires documentRag above.
    // The crawler is deterministic (no LLM in the loop): bounded BFS with robots.txt
    // respect, per-host politeness, and the web_fetch SSRF guard. Defaults below are
    // the safety rails; per-KB bounds (maxPages/maxDepth/patterns) live on each KB.
    "knowledgeBases": {
      "enabled": true,
      "userAgent": "StarlingAI-KBCrawler/1.0",
      "defaultMaxPages": 150,
      "maxPagesCap": 1000,
      "defaultMaxDepth": 4,
      "maxDepthCap": 8,
      "concurrency": 2,
      "requestDelayMs": 300,
      "pageTimeoutMs": 15000,
      "maxPageBytes": 2000000,
      "maxCrawlMs": 1800000,
      "maxConcurrentCrawls": 2,
      // Allow crawling private/internal hosts (RFC1918, *.internal). OFF applies the
      // SSRF guard per redirect hop. Turn ON only to index a trusted internal wiki.
      "allowPrivateHosts": false
    }
  },
  // Document rendering for render_pdf. The renderer is the Chrome that already runs in
  // the browser-vnc container, driven over raw CDP — no extra image, no extra dependency.
  // The HTML is pushed into the page with Page.setDocumentContent and the PDF comes back
  // base64 on the same socket, so nothing is served over HTTP and no volume is shared.
  // Disable this (or point cdpUrl elsewhere) in a deployment that drops browser-vnc;
  // render_pdf then returns a clear error telling the agent to use generate_docx instead.
  "render": {
    "pdf": {
      "enabled": true,
      "cdpUrl": "http://browser-vnc:9222",
      "timeoutMs": 30000,
      "settleMs": 400
    }
  },
  "computerUse": {
    "enabled": true,
    "visionModel": "lmstudio/qwen/qwen3.6-35b-a3b",
    "adapters": {
      "local_vscode": {
        "codePath": "code"
      }
    },
    "remoteAccessService": {
      "baseUrl": "http://computer-remote:8890",
      "authToken": "$SAI_COMPUTER_REMOTE_TOKEN",
      "timeoutMs": 20000,
      "label": "Remote access sidecar"
    },
    "nodes": {
      // The bundled ephemeral VNC desktop (starts with the `computer-desktop` profile).
      "desktop": {
        "adapter": "remote_vnc",
        "host": "computer-desktop",
        "port": 5901,
        "protocol": "vnc",
        "credentials": "starling",
        "label": "Ephemeral VNC desktop"
      }
      // Add your own remote machines below. Bind each to specific accounts with
      // `allowedUsers` under multi-user auth, and store passwords as secrets
      // ($ENV or secret:...), never inline. Example RDP + SSH nodes:
      // ,"win-workstation": {
      //   "adapter": "remote_rdp",
      //   "host": "192.0.2.10",
      //   "port": 3389,
      //   "protocol": "rdp",
      //   "credentials": "$SAI_WIN_WORKSTATION_RDP_CREDENTIALS",
      //   "displayResolution": "1920x1080",
      //   "label": "Windows workstation",
      //   "allowedUsers": ["alice"]
      // }
      // ,"example-server": {
      //   "adapter": "remote_ssh",
      //   "host": "server.example.com",
      //   "port": 22,
      //   "username": "admin",
      //   "authMethod": "password",
      //   "credentials": "$SAI_EXAMPLE_SSH_PASSWORD",
      //   "label": "Example SSH server",
      //   "allowedUsers": ["alice"]
      // }
    },
    "recordingEnabled": true
  },
  "infrastructure": {
    "automation": {
      "profiles": {
        "local_cli": {
          "type": "local-cli",
          "terraformBinary": "terraform",
          "ansibleBinary": "ansible",
          "ansiblePlaybookBinary": "ansible-playbook"
        }
      }
    },
    "virtualization": {
      "profiles": {
        "lab_proxmox": {
          "type": "proxmox",
          "apiUrl": "https://proxmox.example.com:8006",
          "node": "pve-01",
          "tokenId": "root@pam!starlingai",
          "tokenSecret": "$PROXMOX_TOKEN_SECRET"
        }
      }
    }
  },
  "pentest": {
    "serviceUrl": "http://kali-pentest:5010"
  },
  "mcp": {
    "servers": {
      // Connects to the headed browser-vnc Chrome over CDP instead of launching
      // its own headless browser, so the browser the swarm drives is the same one
      // the operator can take over in the dashboard (human reCAPTCHA handoff).
      // On starlingai-public to reach browser-vnc:9222 (and the internet).
      "playwright": {
        "transport": "docker",
        "image": "mcp/playwright:latest",
        // Must be the EXPLICIT network name (no compose project-prefix): the
        // starlingai-public network is declared `name: starlingai-public` in
        // docker-compose.yml so raw `docker run --network` can attach to it.
        // The prefixed form `starlingai_starlingai-public` does not exist, so the
        // MCP docker child exited immediately with "Connection closed" and every
        // browser_* tool failed with "Playwright MCP server is not connected".
        "network": "starlingai-public",
        "args": ["--cdp-endpoint", "http://browser-vnc:9222"],
        "autoStart": true
      },
      "filesystem": {
        "transport": "stdio",
        "command": "npx",
        "args": [
          "-y",
          "@modelcontextprotocol/server-filesystem",
          "/workspace"
        ],
        "autoStart": true
      }
    },
    "expose": {
      "enabled": true,
      "exposeTools": [],
      "exposeAgents": [],
      "exposeScenes": [],
      "allowTier2": false,
      "http": {
        "enabled": true,
        "requireAuth": true
      }
    }
  },
  // Skill-lift measurement (dev-plan Phase 0 item 7 / P1 self-improvement finding):
  // hold out the top matching skill on 15% of eligible turns so injected-vs-held-out
  // outcomes measure whether a skill CAUSES success, instead of promoting on raw
  // success rate. Schema default stays 0; this deployment opts into measurement.
  "skillLibrary": {
    "holdoutRate": 0.15
  }
}