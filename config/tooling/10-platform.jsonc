{
  "retrieval": {
    "search": {
      "backend": "searxng",
      // Endpoint comes from the SEARXNG_BASE_URL env (docker-compose defaults it to
      // the bundled self-hosted service, http://searxng:8080). Set SEARXNG_BASE_URL
      // in .env to point at an external instance instead (e.g. http://search.k2o).
      "timeoutMs": 15000
    },
    // Cross-encoder reranker (the `reranker` GPU sidecar serving Qwen3-Reranker-0.6B,
    // shared with engram). mode "tei" = POST /rerank {query,texts}.
    "reranker": {
      "enabled": true,
      "mode": "tei",
      "baseUrl": "http://reranker:80",
      "model": "Qwen/Qwen3-Reranker-0.6B",
      "timeoutMs": 15000,
      "topK": 6
    },
    // Document RAG over attached files via the engram graph-RAG service. Files are
    // extracted to Markdown, ingested into engram, and relevant excerpts retrieved
    // per turn (a hint + the few best chunks, not the whole file inlined).
    "documentRag": {
      "enabled": true,
      "engramBaseUrl": "http://engram:8088",
      "autoIngestAttachments": true,
      "injectContext": true,
      // Doc-RAG search BLOCKS first-token, so keep this tight: a healthy engram answers a
      // query in well under 1s. 25s meant a hung/unreachable engram stalled EVERY profile
      // turn for 25s before the model even started (fresh-instance eval, session 9b0414e3).
      // 8s is a fast-fail safety net — if engram genuinely needs longer, it is unhealthy.
      "searchTimeoutMs": 8000,
      "retrievalTopK": 6,
      "candidateTopK": 30,
      "maxContextChars": 6000,
      // Search the signed-in user's personal library in every conversation (not
      // just the session a file was attached to). Files uploaded on the Documents
      // page → Personal library become available across all of that user's chats.
      "includeUserDocs": true,
      // Search the shared WORKSPACE library in every conversation too. Files uploaded
      // on the Documents page → Workspace library (e.g. a CV/profile shared for the
      // whole workspace) are otherwise invisible to retrieval — the assistant cannot
      // see them via recall_context, the per-turn RAG, or the profile prefetch.
      "includeWorkspaceDocs": true,
      "workspaceName": "workspace",
      // ── July 2026 engram-flag eval round (docs/engram-reevaluation-2026-07.md §5) ──
      // CRAG confidence demotion: when engram reports weak retrieval confidence
      // (score_gap < threshold), the injected [DOCUMENT CONTEXT] is framed as
      // possibly-relevant instead of authoritative. Demote-only — excerpts are never
      // suppressed, the retrieval-failure/existence honesty notes are untouched.
      // WATCH: false-negative class ("you have no CV") must NOT reappear; the demoted
      // framing should show only on genuinely weak matches.
      "confidenceDemotion": true,
      // Server-side scope filter: /search carries the active scope sources so the
      // engram store filters in-store (engram feat/sources-scope-filter, pinned
      // @049cec2). The client post-filter stays on as defense-in-depth. WATCH:
      // cross-session/cross-user doc isolation (0-leak) + no recall regression on
      // in-scope docs.
      "serverSideScopeFilter": true
    }
  },
  "computerUse": {
    "enabled": true,
    "visionModel": "lmstudio/qwen/qwen3.6-35b-a3b",
    "adapters": {
      "local_vscode": {
        "codePath": "code"
      }
    },
    "remoteAccessService": {
      "baseUrl": "http://computer-remote:8890",
      "authToken": "$SAI_COMPUTER_REMOTE_TOKEN",
      "timeoutMs": 20000,
      "label": "Remote access sidecar"
    },
    "nodes": {
      "desktop": {
        "adapter": "remote_vnc",
        "host": "computer-desktop",
        "port": 5901,
        "protocol": "vnc",
        "credentials": "starling",
        "label": "Ephemeral VNC desktop",
        "allowedUsers": ["Steffen"]
      },
      "win-workstation": {
        "adapter": "remote_rdp",
        "host": "10.10.0.2",
        "port": 3389,
        "protocol": "rdp",
        "credentials": "$SAI_WIN_WORKSTATION_RDP_CREDENTIALS",
        "displayResolution": "1920x1080",
        "label": "Windows PC (10.10.0.2)",
        "allowedUsers": ["Steffen"]
      },
      "n8n-server": {
        "adapter": "remote_ssh",
        "host": "n8n.k2o",
        "port": 22,
        "username": "Steffen",
        "authMethod": "password",
        "credentials": "$SAI_N8N_SSH_PASSWORD",
        "label": "n8n-server",
        "allowedUsers": ["Steffen"]
      }
    },
    "recordingEnabled": true
  },
  "infrastructure": {
    "automation": {
      "profiles": {
        "local_cli": {
          "type": "local-cli",
          "terraformBinary": "terraform",
          "ansibleBinary": "ansible",
          "ansiblePlaybookBinary": "ansible-playbook"
        }
      }
    },
    "virtualization": {
      "profiles": {
        "lab_proxmox": {
          "type": "proxmox",
          "apiUrl": "https://proxmox.example.com:8006",
          "node": "pve-01",
          "tokenId": "root@pam!starlingai",
          "tokenSecret": "$PROXMOX_TOKEN_SECRET"
        }
      }
    }
  },
  "pentest": {
    "serviceUrl": "http://kali-pentest:5010"
  },
  "mcp": {
    "servers": {
      // Connects to the headed browser-vnc Chrome over CDP instead of launching
      // its own headless browser, so the browser the swarm drives is the same one
      // the operator can take over in the dashboard (human reCAPTCHA handoff).
      // On starlingai-public to reach browser-vnc:9222 (and the internet).
      "playwright": {
        "transport": "docker",
        "image": "mcp/playwright:latest",
        "network": "starlingai_starlingai-public",
        "args": ["--cdp-endpoint", "http://browser-vnc:9222"],
        "autoStart": true
      },
      "filesystem": {
        "transport": "stdio",
        "command": "npx",
        "args": [
          "-y",
          "@modelcontextprotocol/server-filesystem",
          "/workspace"
        ],
        "autoStart": true
      }
    },
    "expose": {
      "enabled": true,
      "exposeTools": [],
      "exposeAgents": [],
      "exposeScenes": [],
      "allowTier2": false,
      "http": {
        "enabled": true,
        "requireAuth": true
      }
    }
  }
}