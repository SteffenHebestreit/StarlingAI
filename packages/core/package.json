{
  "name": "@starlingai/core",
  "version": "0.26.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../scripts/clean-path.mjs dist && tsc -p tsconfig.build.json",
    "security:pack": "node ../../scripts/check-package-artifacts.mjs .",
    "dev": "tsx watch src/index.ts",
    "dev:computer-remote": "tsx watch src/computer-remote-main.ts",
    "dev:scene-worker": "tsx watch src/scene-worker-main.ts",
    "dev:mcp-stdio": "tsx src/mcp-stdio.ts",
    "start": "node dist/index.js",
    "start:computer-remote": "node dist/computer-remote-main.js",
    "start:scene-worker": "node dist/scene-worker-main.js",
    "start:mcp-stdio": "node dist/mcp-stdio.js",
    "test": "vitest run",
    "test:qwen-speech-smoke": "tsx src/scripts/qwen-speech-smoke.ts",
    "runtime-guidance:evaluate": "tsx src/scripts/runtime-guidance-live-eval.ts",
    "test:watch": "vitest",
    "check": "tsc --noEmit",
    "lint": "eslint src",
    "agents:evaluate": "tsx src/agent/evaluation-cli.ts",
    "scenes:evaluate": "tsx src/agent/scene-evaluation-cli.ts",
    "worker:scene": "tsx src/scene-worker-main.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.11.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.215.0",
    "@opentelemetry/resources": "^2.7.0",
    "@opentelemetry/sdk-node": "^0.215.0",
    "@opentelemetry/sdk-trace-base": "^2.7.0",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "bcryptjs": "^3.0.3",
    "cron": "^3.2.0",
    "docx": "^9.6.1",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.41.0",
    "grammy": "^1.34.0",
    "hono": "^4.7.0",
    "imapflow": "^1.0.169",
    "ioredis": "^5.3.2",
    "joi": "^17.13.3",
    "jose": "^6.0.8",
    "json5": "^2.2.3",
    "jsonschema": "^1.4.1",
    "mysql2": "^3.22.0",
    "neo4j-driver": "^6.0.1",
    "node-fetch": "^3.3.2",
    "nodemailer": "^6.9.16",
    "openai": "^4.89.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.14.1",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "pptxgenjs": "^4.0.1",
    "uuid": "^11.1.0",
    "ws": "^8.18.1",
    "xlsx": "^0.18.5",
    "yazl": "^3.3.1",
    "zod": "^3.24.2"
  },
  "optionalDependencies": {
    "@nut-tree-fork/nut-js": "^4.2.4",
    "@types/bcryptjs": "^3.0.0",
    "@types/pg": "^8.18.0",
    "screenshot-desktop": "^1.15.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/nodemailer": "^6.4.17",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.13",
    "@types/yazl": "^3.3.0",
    "drizzle-kit": "^0.30.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.6"
  }
}
