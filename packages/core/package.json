{
  "name": "@starlingai/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/index.ts",
    "dev:scene-worker": "tsx watch src/scene-worker-main.ts",
    "start": "node dist/index.js",
    "start:scene-worker": "node dist/scene-worker-main.js",
    "test": "vitest run",
    "test:qwen-speech-smoke": "tsx src/scripts/qwen-speech-smoke.ts",
    "runtime-guidance:evaluate": "tsx src/scripts/runtime-guidance-live-eval.ts",
    "test:watch": "vitest",
    "check": "tsc --noEmit",
    "lint": "eslint src",
    "agents:evaluate": "tsx src/agent/evaluation-cli.ts",
    "worker:scene": "tsx src/scene-worker-main.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.11.0",
    "bcryptjs": "^3.0.3",
    "cron": "^3.2.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.41.0",
    "grammy": "^1.34.0",
    "imapflow": "^1.0.169",
    "nodemailer": "^6.9.16",
    "hono": "^4.7.0",
    "ioredis": "^5.3.2",
    "jose": "^6.0.8",
    "json5": "^2.2.3",
    "jsonschema": "^1.4.1",
    "node-fetch": "^3.3.2",
    "openai": "^4.89.0",
    "pg": "^8.14.1",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "uuid": "^11.1.0",
    "ws": "^8.18.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^22.10.7",
    "@types/pg": "^8.11.10",
    "@types/uuid": "^10.0.0",
    "@types/nodemailer": "^6.4.17",
    "@types/ws": "^8.5.13",
    "drizzle-kit": "^0.30.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.6"
  }
}
