{
  "name": "@starlingai/core",
  "version": "0.43.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../scripts/clean-path.mjs dist && tsc -p tsconfig.build.json",
    "security:pack": "node ../../scripts/check-package-artifacts.mjs .",
    "dev": "tsx watch src/index.ts",
    "dev:computer-remote": "tsx watch src/computer-remote-main.ts",
    "dev:scene-worker": "tsx watch src/scene-worker-main.ts",
    "dev:mcp-stdio": "tsx src/mcp-stdio.ts",
    "start": "node dist/index.js",
    "start:computer-remote": "node dist/computer-remote-main.js",
    "start:scene-worker": "node dist/scene-worker-main.js",
    "start:mcp-stdio": "node dist/mcp-stdio.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:qwen-speech-smoke": "tsx src/scripts/qwen-speech-smoke.ts",
    "runtime-guidance:evaluate": "tsx src/scripts/runtime-guidance-live-eval.ts",
    "test:watch": "vitest",
    "check": "tsc --noEmit",
    "lint": "eslint src",
    "memory:vault": "tsx src/cli/memory-vault.ts",
    "agents:evaluate": "tsx src/agent/evaluation-cli.ts",
    "scenes:evaluate": "tsx src/agent/scene-evaluation-cli.ts",
    "worker:scene": "tsx src/scene-worker-main.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.217.0",
    "@opentelemetry/resources": "^2.9.0",
    "@opentelemetry/sdk-node": "^0.217.0",
    "@opentelemetry/sdk-trace-base": "^2.9.0",
    "@opentelemetry/semantic-conventions": "^1.42.0",
    "bcryptjs": "^3.0.3",
    "cron": "^3.5.0",
    "docx": "^9.7.1",
    "dotenv": "^17.4.2",
    "grammy": "^1.44.0",
    "hono": "^4.12.28",
    "imapflow": "^1.4.6",
    "ioredis": "^5.11.1",
    "joi": "^17.13.4",
    "jose": "^6.2.3",
    "json5": "^2.2.3",
    "jsonschema": "^1.5.0",
    "mysql2": "^3.22.6",
    "neo4j-driver": "^6.2.0",
    "node-fetch": "^3.3.2",
    "nodemailer": "^9.0.3",
    "openai": "^4.104.0",
    "openid-client": "^6.8.4",
    "pdf-lib": "^1.17.1",
    "pg": "^8.22.0",
    "pino": "^9.14.0",
    "pino-pretty": "^13.1.3",
    "pptxgenjs": "^4.0.1",
    "uuid": "^11.1.1",
    "ws": "^8.21.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "yazl": "^3.3.1",
    "zod": "^3.25.76"
  },
  "optionalDependencies": {
    "@nut-tree-fork/nut-js": "^4.2.6",
    "@types/pg": "^8.20.0",
    "screenshot-desktop": "^1.15.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/nodemailer": "^8.0.1",
    "@types/uuid": "^11.0.0",
    "@types/ws": "^8.18.1",
    "@types/yazl": "^3.3.1",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3",
    "vitest": "3.2.6"
  }
}
