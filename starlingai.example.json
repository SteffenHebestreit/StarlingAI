// StarlingAI configuration example
// Copy this file to the project root as starlingai.json and adjust for your environment.
{
  "providers": {
    "lmstudio": {
      "baseUrl": "http://host.docker.internal:1234/v1",
      "apiKey": "lm-studio",
      "timeoutMs": 30000,
      "maxRetries": 3
    }
    //,
    // "openaiCompatible": {
    //   "coder_vllm": {
    //     "baseUrl": "http://host.docker.internal:8000/v1",
    //     "apiKey": "local-vllm"
    //   }
    // }
    // "anthropic": {
    //   "apiKey": "$ANTHROPIC_API_KEY"
    // }
  },

  "agents": {
    "defaults": {
      "model": {
        "primary": "lmstudio/qwen/qwen3.5-35b-a3b",
        "fallback": "lmstudio/qwen/qwen3.5-9b",
        "contextWindow": 32768,
        "temperature": 0.3,
        "maxTokens": 4096,
        "embeddingModel": "lmstudio/text-embedding-qwen3-embedding-8b"
      }
    },
    "rateLimit": {
      "requestsPerMinute": 60,
      "toolCallsPerTurn": 20,
      "concurrentSessions": 10
    }
  },

  "retrieval": {
    "search": {
      "backend": "auto"
    }
    //,
    // "search": {
    //   "backend": "searxng",
    //   "searxngBaseUrl": "http://search.k2o",
    //   "timeoutMs": 12000
    // },
    // "reranker": {
    //   "enabled": true,
    //   "baseUrl": "http://host.docker.internal:1234/v1",
    //   "apiKey": "lm-studio",
    //   "model": "Qwen/Qwen3-Reranker-4B"
    // }
  },

  "infrastructure": {
    "automation": {
      "profiles": {
        "local_cli": {
          "type": "local-cli",
          "terraformBinary": "terraform",
          "ansibleBinary": "ansible",
          "ansiblePlaybookBinary": "ansible-playbook"
        }
        //,
        // "ops_webhook": {
        //   "type": "webhook",
        //   "url": "https://ops.example.com/automation",
        //   "headers": {
        //     "Authorization": "Bearer $INFRA_AUTOMATION_TOKEN"
        //   },
        //   "timeoutMs": 45000
        // }
      }
      //,
      // "defaultProfile": "ops_webhook"
    },
    "virtualization": {
      "profiles": {
        "lab_proxmox": {
          "type": "proxmox",
          "apiUrl": "https://proxmox.example.com:8006",
          "node": "pve-01",
          "tokenId": "root@pam!starlingai",
          "tokenSecret": "$PROXMOX_TOKEN_SECRET"
        }
        //,
        // "lab_webhook": {
        //   "type": "webhook",
        //   "url": "https://n8n.example.com/webhook/vm-manage",
        //   "headers": {
        //     "Authorization": "Bearer $INFRA_WEBHOOK_TOKEN"
        //   }
        // }
      }
    }
  },

  "pentest": {
    "serviceUrl": "http://kali-pentest:5010"
    //,
    // "defaultProfile": "ops_webhook",
    // "profiles": {
    //   "ops_webhook": {
    //     "type": "webhook",
    //     "url": "https://ops.example.com/pentest",
    //     "headers": {
    //       "Authorization": "Bearer $PENTEST_WEBHOOK_TOKEN"
    //     },
    //     "timeoutMs": 45000
    //   },
    //   "local_kali": {
    //     "type": "kali-service",
    //     "serviceUrl": "http://kali-pentest:5010"
    //   }
    // }
  },

  "subAgents": {
    "researcher": {
      "description": "Web research expert for documentation and public web lookup.",
      "capabilities": ["web research", "documentation lookup"],
      "tags": ["research", "docs"],
      "model": {
        "primary": "lmstudio/qwen/qwen3.5-9b",
        "temperature": 0.2,
        "maxTokens": 4096
      },
      "maxIterations": 4,
      "tools": [
        "web_search",
        "web_fetch",
        "read_file",
        "write_file"
      ]
    },
    "code_analyst": {
      "description": "Code analysis specialist for workspace inspection and bug diagnosis.",
      "capabilities": ["code reading", "architecture review"],
      "tags": ["code", "analysis"],
      "model": {
        "primary": "lmstudio/qwen/qwen3.5-9b",
        "temperature": 0.1,
        "maxTokens": 8192
      },
      "maxIterations": 5,
      "tools": [
        "read_file",
        "list_files",
        "write_file",
        "mcp__filesystem__read_file",
        "mcp__filesystem__list_directory"
      ]
    },
    "browser_agent": {
      "description": "Browser automation specialist using Playwright MCP tools.",
      "capabilities": ["browser automation", "form submission"],
      "tags": ["browser", "playwright"],
      "model": {
        "primary": "lmstudio/qwen/qwen3.5-35b-a3b",
        "temperature": 0.2,
        "maxTokens": 4096
      },
      "maxIterations": 12,
      "tools": [
        "get_site_credentials",
        "mcp__docker_gateway__browser_navigate",
        "mcp__docker_gateway__browser_click",
        "mcp__docker_gateway__browser_type",
        "mcp__docker_gateway__browser_snapshot",
        "mcp__docker_gateway__browser_screenshot",
        "mcp__docker_gateway__browser_select_option",
        "mcp__docker_gateway__browser_wait_for",
        "write_file"
      ]
    },
    "infrastructure_agent": {
      "description": "Infrastructure automation specialist for provisioning systems and deploying applications with Proxmox, Terraform, readiness checks, Ansible, SSH, and SCP file transfers.",
      "capabilities": ["infrastructure automation", "vm provisioning", "terraform workflows", "terraform plan review", "service readiness checks", "ansible playbooks", "ansible tasks", "ansible vault", "ssh execution", "ssh uploads", "ssh downloads", "docker deployment"],
      "tags": ["infrastructure", "ops", "terraform", "ansible", "vault", "ssh", "scp", "docker", "proxmox", "readiness"],
      "model": {
        "primary": "lmstudio/qwen/qwen3.5-35b-a3b",
        "temperature": 0.1,
        "maxTokens": 8192
      },
      "maxIterations": 10,
      "systemPrompt": "You are an infrastructure automation specialist. Prefer vm_manage for generalized VM lifecycle actions across configured backends, proxmox_vm when you explicitly need the Proxmox-specialized path, terraform_exec for declarative infrastructure changes and saved-plan workflows, service_check to wait for HTTP, TCP, SSH, or DNS readiness between provisioning steps, ansible_task or ansible_playbook for host configuration depending on scope including Vault-backed playbooks, ssh_upload for transferring local deployment artifacts, ssh_download for collecting remote logs or generated files, and SSH for targeted remote execution and verification. When using terraform_exec with action=output, rely on the structured output values for downstream steps instead of reparsing the JSON manually. Prefer complete end-to-end deployments over partial setup.",
      "tools": [
        "vm_manage",
        "proxmox_vm",
        "terraform_exec",
        "service_check",
        "ansible_playbook",
        "ansible_task",
        "ssh_exec",
        "ssh_upload",
        "ssh_download",
        "read_file",
        "write_file"
      ]
    },
    "image_creator": {
      "description": "Image generation specialist for prompt refinement and final image creation.",
      "capabilities": ["image generation", "prompt refinement"],
      "tags": ["image", "design", "multimodal"],
      "model": {
        "primary": "lmstudio/qwen/qwen3.5-35b-a3b",
        "temperature": 0.45,
        "maxTokens": 4096
      },
      "maxIterations": 5,
      "tools": [
        "generate_image",
        "analyze_image",
        "read_file",
        "write_file"
      ]
    },
    "coder": {
      "description": "JS and TS sandbox execution specialist.",
      "capabilities": ["code generation", "sandbox execution"],
      "tags": ["code", "sandbox"],
      "model": {
        "primary": "lmstudio/zai-org/glm-4.7-flash",
        "temperature": 0.2,
        "maxTokens": 8192
      },
      "maxIterations": 4,
      "tools": [
        "mcp__docker_gateway__run_js",
        "mcp__docker_gateway__run_ts",
        "read_file",
        "write_file",
        "list_files"
      ]
    },
    "summarizer": {
      "description": "Short structured summaries for files and fetched pages.",
      "capabilities": ["summarization"],
      "tags": ["summary"],
      "model": {
        "primary": "lmstudio/qwen/qwen3.5-9b",
        "temperature": 0.15,
        "maxTokens": 4096
      },
      "maxIterations": 3,
      "tools": [
        "web_fetch",
        "read_file",
        "write_file"
      ]
    },
    "agent_factory": {
      "description": "Creates purpose-built ephemeral agents when the static catalog is not enough.",
      "capabilities": ["meta orchestration", "ephemeral agents"],
      "tags": ["meta", "agents"],
      "model": {
        "primary": "lmstudio/qwen/qwen3.5-35b-a3b",
        "temperature": 0.2,
        "maxTokens": 4096
      },
      "maxIterations": 6,
      "tools": [
        "list_agents",
        "delegate_to_agent",
        "create_ephemeral_agent"
      ]
    },

    // ── Pentesting agents ──────────────────────────────────────────────────
    // These agents require the kali-pentest service running with PENTEST_SCOPE set.
    // Start with: docker compose --profile pentest up kali-pentest

    "pentest_coordinator": {
      "description": "Penetration testing orchestrator. Plans and coordinates a full pentest engagement by delegating to specialized sub-agents: recon, vuln_scanner, web_auditor, network_auditor, exploit, and report_writer. Requires written authorization and PENTEST_SCOPE to be configured.",
      "capabilities": ["pentest coordination", "engagement planning", "recon", "vulnerability assessment", "exploitation", "report writing"],
      "tags": ["pentest", "security", "offensive"],
      "model": {
        "primary": "lmstudio/qwen/qwen3.5-35b-a3b",
        "temperature": 0.1,
        "maxTokens": 8192
      },
      "maxIterations": 20,
      "systemPrompt": "You are a professional penetration testing coordinator. MANDATORY PRE-FLIGHT CHECKLIST — you MUST complete all steps before calling any active scanning tool:\n\n1. Ask the user: 'Do you have written authorization to test the target(s)? Please confirm yes and provide the authorization reference (ticket ID, contract number, or letter date).'\n2. Ask the user: 'What is the authorized target scope? Please list all IPs, CIDR ranges, and/or hostnames.'\n3. Ask the user: 'Who authorized this engagement? (Name and role of the asset owner or their delegate)'\n4. Call pentest_set_scope with the collected details — this unlocks active scanning.\n5. Confirm to the user: 'Scope configured. Starting engagement: [name].'\n\nOnly after completing the above, structure the engagement as: Recon → Vulnerability Scanning → Web/Network Auditing → Exploitation (only with explicit additional approval per exploit) → Report.\n\nDelegate each phase to the appropriate specialist agent. Always capture findings via share_finding so report_writer_agent can build a comprehensive report. Never proceed past step 4 without explicit user confirmation.",
      "tools": [
        "pentest_set_scope",
        "list_agents",
        "delegate_to_agent",
        "parallel_delegate",
        "run_task_graph",
        "searchsploit_query",
        "share_finding",
        "read_shared_facts",
        "write_file",
        "read_file"
      ]
    },

    "recon_agent": {
      "description": "Passive and active reconnaissance specialist. Performs port scanning, service enumeration, OS detection, and Exploit-DB searches to map the attack surface of authorized targets.",
      "capabilities": ["network reconnaissance", "port scanning", "service enumeration", "OS fingerprinting", "CVE lookup"],
      "tags": ["pentest", "recon", "nmap", "security"],
      "model": {
        "primary": "lmstudio/qwen/qwen3.5-35b-a3b",
        "temperature": 0.1,
        "maxTokens": 8192
      },
      "maxIterations": 10,
      "systemPrompt": "You are a recon specialist. Start with a quick nmap scan, then escalate to full port scan and service version detection. Use searchsploit_query to look up CVEs for discovered services. Store all findings using share_finding with structured JSON: {target, port, service, version, cves: [], notes}.",
      "tools": [
        "nmap_scan",
        "searchsploit_query",
        "pentest_exec",
        "share_finding",
        "read_shared_facts",
        "write_file"
      ]
    },

    "web_auditor_agent": {
      "description": "Web application security auditor. Tests web services for directory traversal, SQL injection, misconfigurations, and known vulnerabilities using Nikto, Gobuster, and SQLMap.",
      "capabilities": ["web vulnerability scanning", "directory brute-force", "SQL injection", "web reconnaissance"],
      "tags": ["pentest", "web", "nikto", "sqlmap", "gobuster", "security"],
      "model": {
        "primary": "lmstudio/qwen/qwen3.5-35b-a3b",
        "temperature": 0.1,
        "maxTokens": 8192
      },
      "maxIterations": 12,
      "systemPrompt": "You are a web application penetration tester. For each web target: (1) run nikto_scan for server misconfigurations and CVEs, (2) run gobuster_scan to discover hidden paths, (3) test discovered endpoints for SQL injection with sqlmap_scan at risk=1 level=1. Always use pentest_exec for supplemental tools like whatweb or wafw00f. Store findings via share_finding.",
      "tools": [
        "nikto_scan",
        "gobuster_scan",
        "sqlmap_scan",
        "pentest_exec",
        "searchsploit_query",
        "share_finding",
        "read_shared_facts",
        "write_file"
      ]
    },

    "network_auditor_agent": {
      "description": "Network security auditor. Performs in-depth network service assessment including UDP scanning, NSE script execution, and credential brute-force on exposed services.",
      "capabilities": ["network auditing", "service exploitation", "credential testing", "NSE scripting"],
      "tags": ["pentest", "network", "nmap", "hydra", "security"],
      "model": {
        "primary": "lmstudio/qwen/qwen3.5-35b-a3b",
        "temperature": 0.1,
        "maxTokens": 8192
      },
      "maxIterations": 10,
      "systemPrompt": "You are a network penetration tester. Run deep nmap scans with vuln and default NSE scripts on discovered services. Use hydra_attack for credential testing only when the coordinator has explicitly authorized it. Enumerate SMB, FTP, SSH, and RDP services. Store all findings via share_finding.",
      "tools": [
        "nmap_scan",
        "hydra_attack",
        "pentest_exec",
        "searchsploit_query",
        "share_finding",
        "read_shared_facts",
        "write_file"
      ]
    },

    "exploit_agent": {
      "description": "Exploitation specialist using Metasploit Framework. Executes verified exploits against authorized targets. Requires explicit per-engagement approval from the user before running any exploit module.",
      "capabilities": ["exploit execution", "metasploit", "payload delivery", "post-exploitation"],
      "tags": ["pentest", "exploit", "metasploit", "security"],
      "model": {
        "primary": "lmstudio/qwen/qwen3.5-35b-a3b",
        "temperature": 0.05,
        "maxTokens": 8192
      },
      "maxIterations": 8,
      "systemPrompt": "You are an exploitation specialist. Only run exploits that: (1) have confirmed vulnerable service versions from recon data, (2) have been explicitly approved by the user for this engagement. Prefer check commands before running exploits. After exploitation, limit post-ex to whoami, hostname, and network interface enumeration — do not exfiltrate data. Always record what was done via share_finding with full command details.",
      "tools": [
        "metasploit_exec",
        "pentest_exec",
        "read_shared_facts",
        "share_finding",
        "write_file"
      ]
    },

    "report_writer_agent": {
      "description": "Penetration test report writer. Collects all shared findings from the swarm and generates a professional Markdown pentest report with executive summary, severity ratings, evidence, and remediation guidance.",
      "capabilities": ["report writing", "finding aggregation", "risk rating", "remediation guidance"],
      "tags": ["pentest", "reporting", "security"],
      "model": {
        "primary": "lmstudio/qwen/qwen3.5-35b-a3b",
        "temperature": 0.2,
        "maxTokens": 8192
      },
      "maxIterations": 6,
      "systemPrompt": "You are a professional penetration test report writer. Read all shared findings via read_shared_facts, structure them by severity (Critical → High → Medium → Low → Informational), assign CVSS scores where applicable, write clear remediation guidance for each finding, and produce a complete report using pentest_report. The executive summary should be suitable for a non-technical audience.",
      "tools": [
        "read_shared_facts",
        "pentest_report",
        "write_file",
        "read_file"
      ]
    }
  },

  "scenes": {
    "apply_jobs": {
      "description": "Run the application pipeline for one ranked freelance lead.",
      "task": "Run the application_pipeline agent for one unchecked lead with rating 0.7 or higher.",
      "webhookKey": "$SCENE_APPLY_JOBS_KEY",
      "allowedAgents": ["application_pipeline", "proposal_writer", "browser_agent"],
      "humanInLoopSteps": ["get_site_credentials", "mcp__docker_gateway__browser_navigate"],
      "approvalChannel": "slack-approvals",
      "params": {
        "minRating": {
          "description": "Minimum lead rating to accept",
          "default": "0.7"
        }
      }
    }
  },

  "channels": {
    "webchat": {
      "enabled": true,
      "port": 3001
    },
    "telegram": {
      "enabled": false,
      "botToken": "$TELEGRAM_BOT_TOKEN",
      "allowedUserIds": []
    },
    "slack": {
      "enabled": false,
      "botToken": "$SLACK_BOT_TOKEN",
      "signingSecret": "$SLACK_SIGNING_SECRET",
      "appToken": "$SLACK_APP_TOKEN",
      "dmPolicy": "pairing",
      "allowFrom": []
    },
    "discord": {
      "enabled": false,
      "token": "$DISCORD_BOT_TOKEN",
      "guildIds": [],
      "dmPolicy": "pairing",
      "allowFrom": []
    },
    "whatsapp": {
      "enabled": false,
      "accessToken": "$WHATSAPP_ACCESS_TOKEN",
      "phoneNumberId": "$WHATSAPP_PHONE_NUMBER_ID",
      "verifyToken": "$WHATSAPP_VERIFY_TOKEN",
      "appSecret": "$WHATSAPP_APP_SECRET",
      "dmPolicy": "pairing",
      "allowFrom": []
    },
    "email": {
      "enabled": false,
      "imapHost": "imap.example.com",
      "imapPort": 993,
      "imapUser": "$EMAIL_IMAP_USER",
      "imapPassword": "$EMAIL_IMAP_PASSWORD",
      "smtpHost": "smtp.example.com",
      "smtpPort": 587,
      "smtpUser": "$EMAIL_SMTP_USER",
      "smtpPassword": "$EMAIL_SMTP_PASSWORD",
      "smtpFrom": "StarlingAI <bot@example.com>",
      "dmPolicy": "allowlist",
      "allowFrom": ["ops@example.com"]
    },
    "signal": {
      "enabled": false,
      "account": "+49123456789",
      "signalCliPath": "signal-cli",
      "dmPolicy": "disabled",
      "allowFrom": []
    }
  },

  "gateway": {
    "port": 8765,
    "restPort": 8766,
    "bindHost": "loopback",
    "sessionTtlMs": 3600000,
    "turnTimeoutMs": 900000,
    "publicUrl": "https://starlingai.example.com"
  },

  "multimodal": {
    "maxUploadBytes": 20971520,
    "files": {
      "baseUrl": "http://fastapi-mcp-template:8000",
      "toolName": "file_to_markdown",
      "timeoutMs": 60000
    },
    "stt": {
      "baseUrl": "http://qwen3-asr-service:5002",
      "model": "Qwen/Qwen3-ASR-1.7B",
      "timeoutMs": 60000
    },
    "tts": {
      "baseUrl": "http://qwen3-tts-service:5004",
      "model": "Qwen/Qwen3-TTS-12Hz-0.6B-Instruct",
      "defaultLanguage": "English",
      "defaultSpeaker": "Vivian",
      "voiceSamplePath": "samples/assistant-voice.wav",
      "voiceSampleText": "Hello, this is the reference voice sample used by StarlingAI.",
      "defaultQuality": "medium",
      "timeoutMs": 60000
    },
    "imageGeneration": {
      "baseUrl": "http://image-generation-service:5005",
      "model": "black-forest-labs/FLUX.1-schnell",
      "timeoutMs": 120000,
      "defaultWidth": 768,
      "defaultHeight": 768,
      "defaultSteps": 4,
      "defaultGuidanceScale": 0,
      "cpuOffload": true
    },
    "wakeWord": {
      "enabled": false,
      "language": "en-US",
      "keywords": ["Hey Guarded", "Okay Guarded", "Luna"],
      "stopPhrases": ["stop recording", "end recording", "stop listening", "luna stop"],
      "silenceTimeoutMs": 4000
    }
  },

  "guardrails": {
    "promptInjectionBlock": true,
    "outputSecretScan": true,
    "maxInputLength": 32000,
    "sandboxShellExec": true
  },

  "mcp": {
    "servers": {
      "docker_gateway": {
        "transport": "stdio",
        "command": "docker",
        "args": ["mcp", "gateway", "run"],
        "autoStart": true
      },
      "filesystem": {
        "transport": "stdio",
        "command": "npx",
        "args": ["-y", "@modelcontextprotocol/server-filesystem", "/workspace"],
        "autoStart": true
      }
    }
  },

  "approvalChannels": {
    "slack-approvals": {
      "type": "slack",
      "webhookUrl": "https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK_URL",
      "timeoutMs": 600000
    }
  },

  "integrations": {
    "n8n": {
      "baseUrl": "http://host.docker.internal:5678",
      "apiKey": "$N8N_API_KEY",
      "leadsWebhookUrl": "http://host.docker.internal:5678/webhook/starlingai-leads",
      "markAppliedWebhookUrl": "http://host.docker.internal:5678/webhook/starlingai-apply"
    }
  },

  "webhooks": {
    "notify_ops": {
      "description": "Notify an internal webhook about important runtime events.",
      "url": "https://example.com/hooks/starlingai",
      "method": "POST",
      "headers": {
        "Authorization": "$OPS_WEBHOOK_TOKEN"
      }
    }
  },

  "sites": {
    "github.com": {
      "username": "your-username",
      "password": "$GITHUB_PASSWORD",
      "loginUrl": "https://github.com/login"
    },
    "app.example.com": {
      "username": "ops@example.com",
      "password": "secret:app_example_password",
      "loginUrl": "https://app.example.com/login",
      "urls": {
        "dashboard": "https://app.example.com/dashboard"
      },
      "notes": "Use the local account rather than SSO."
    }
  },

  "workspacePath": "/workspace"
}
