// StarlingAI configuration example
// Copy this file to the project root as starlingai.json and adjust for your environment.
{
  "providers": {
    "lmstudio": {
      "baseUrl": "http://10.10.0.2:1234/v1",
      "apiKey": "lm-studio",
      "timeoutMs": 30000,
      "maxRetries": 3
    }
    //,
    // "openaiCompatible": {
    //   "coder_vllm": {
    //     "baseUrl": "http://host.docker.internal:8000/v1",
    //     "apiKey": "local-vllm"
    //   }
    // }
    // "anthropic": {
    //   "apiKey": "$ANTHROPIC_API_KEY"
    // }
  },

  "agents": {
    "mainAssistant": {
      "toolMode": "hybrid"
    },
    "defaults": {
      "model": {
        "primary": "lmstudio/qwen/qwen3.5-35b-a3b",
        "fallback": "lmstudio/qwen3.5-4b",
        "contextWindow": 32768,
        "temperature": 0.3,
        "maxTokens": 4096,
        "embeddingModel": "lmstudio/text-embedding-qwen3-embedding-0.6b"
      }
    },
    "ephemeralGeneration": {
      "enabled": true,
      "skillMatchThreshold": 0.75,
      "architectAgentName": "agent_architect"
    },
    "rateLimit": {
      "requestsPerMinute": 60,
      "toolCallsPerTurn": 20,
      "concurrentSessions": 10
    }
  },

  "retrieval": {
    "search": {
      "backend": "auto"
    }
    //,
    // "search": {
    //   "backend": "searxng",
    //   "searxngBaseUrl": "http://search.k2o",
    //   "timeoutMs": 12000
    // },
    // "reranker": {
    //   "enabled": true,
    //   "baseUrl": "http://host.docker.internal:1234/v1",
    //   "apiKey": "lm-studio",
    //   "model": "Qwen/Qwen3-Reranker-4B"
    // }
  },

  "computerUse": {
    "enabled": true,
    // "visionModel": "lmstudio/qwen2-vl-7b-instruct",
    "adapters": {
      "local_vscode": {
        "codePath": "code"
      }
    },
    // Optional: route remote VNC/RDP/SSH through the bundled sidecar.
    // This keeps native remote-access dependencies out of the gateway.
    "remoteAccessService": {
      "baseUrl": "http://computer-remote:8890",
      "authToken": "$SAI_COMPUTER_REMOTE_TOKEN",
      "timeoutMs": 20000,
      "label": "Remote access sidecar"
    },
    // ── Named nodes — manage multiple machines simultaneously ──
    // Each entry is a named target the agent can connect to.
    // Use computer_list_nodes to see available targets,
    // computer_session_start with node="<name>" to connect.
    "nodes": {
      // ── Example: ephemeral VNC desktop container (--computer-desktop) ──
      // "desktop": {
      //   "adapter": "remote_vnc",
      //   "host": "computer-desktop",
      //   "port": 5901,
      //   "protocol": "vnc",
      //   "credentials": "starling",
      //   "label": "Ephemeral VNC desktop"
      // }
      //,
      // ── Example: Windows PC via VNC ──
      // "win-workstation": {
      //   "adapter": "remote_vnc",
      //   "host": "10.10.0.2",
      //   "port": 5900,
      //   "protocol": "vnc",
      //   "credentials": "vnc-password",
      //   "label": "Windows PC (10.10.0.2)"
      // }
      //,
      // ── Example: Windows PC via RDP ──
      // "win-rdp": {
      //   "adapter": "remote_rdp",
      //   "host": "10.10.0.2",
      //   "port": 3389,
      //   "protocol": "rdp",
      //   "credentials": "Administrator:password",
      //   "displayResolution": "1920x1080",
      //   "label": "Windows RDP (10.10.0.2)"
      // }
      //,
      // ── Example: Linux server via SSH ──
      // "linux-server": {
      //   "adapter": "remote_ssh",
      //   "host": "10.10.0.5",
      //   "port": 22,
      //   "username": "admin",
      //   "credentials": "/home/agent/.ssh/id_rsa",
      //   "authMethod": "key",
      //   "label": "Linux web server"
      // }
    },
    "recordingEnabled": true
  },

  "infrastructure": {
    "automation": {
      "profiles": {
        "local_cli": {
          "type": "local-cli",
          "terraformBinary": "terraform",
          "ansibleBinary": "ansible",
          "ansiblePlaybookBinary": "ansible-playbook"
        }
        //,
        // "ops_webhook": {
        //   "type": "webhook",
        //   "url": "https://ops.example.com/automation",
        //   "headers": {
        //     "Authorization": "Bearer $INFRA_AUTOMATION_TOKEN"
        //   },
        //   "timeoutMs": 45000
        // }
      }
      //,
      // "defaultProfile": "ops_webhook"
    },
    "virtualization": {
      "profiles": {
        "lab_proxmox": {
          "type": "proxmox",
          "apiUrl": "https://proxmox.example.com:8006",
          "node": "pve-01",
          "tokenId": "root@pam!starlingai",
          "tokenSecret": "$PROXMOX_TOKEN_SECRET"
        }
        //,
        // "lab_webhook": {
        //   "type": "webhook",
        //   "url": "https://n8n.example.com/webhook/vm-manage",
        //   "headers": {
        //     "Authorization": "Bearer $INFRA_WEBHOOK_TOKEN"
        //   }
        // }
      }
    }
  },

  "pentest": {
    "serviceUrl": "http://kali-pentest:5010"
    //,
    // "defaultProfile": "ops_webhook",
    // "profiles": {
    //   "ops_webhook": {
    //     "type": "webhook",
    //     "url": "https://ops.example.com/pentest",
    //     "headers": {
    //       "Authorization": "Bearer $PENTEST_WEBHOOK_TOKEN"
    //     },
    //     "timeoutMs": 45000
    //   },
    //   "local_kali": {
    //     "type": "kali-service",
    //     "serviceUrl": "http://kali-pentest:5010"
    //   }
    // }
  },

  "subAgents": {
    "computer_use_agent": {
      "description": "Desktop automation specialist. Controls the user's computer via keyboard, mouse, and screen analysis.",
      "capabilities": ["desktop automation", "computer use", "window management"],
      "tags": ["computer", "desktop", "vscode", "automation"],
      "maxIterations": 15,
      "systemPrompt": "You are a computer-use automation specialist. Use only general computer tools. On Windows, mouse clicks are the default way to secure keyboard focus. Once a snapshot shows the correct input field focused, stop changing focus and type the requested text immediately. Never ask for or reveal stored usernames or passwords; use get_site_credentials for metadata and computer_type_credential when a login form needs stored credentials typed securely. Do not return narrated future intent such as 'let me take a snapshot' as your final result.",
      "tools": [
        "computer_session_start", "computer_session_attach", "computer_session_stop",
        "computer_snapshot", "computer_click", "computer_type", "computer_type_credential", "computer_hotkey",
        "computer_scroll", "computer_drag", "computer_wait_for",
        "computer_list_windows", "computer_focus_window",
        "computer_capture_region", "computer_clipboard_read", "computer_clipboard_write",
        "computer_upload_file", "computer_download_file",
        "get_site_credentials",
        "share_finding"
      ]
    },
    "researcher": {
      "description": "Web research expert for documentation and public web lookup.",
      "capabilities": ["web research", "documentation lookup"],
      "tags": ["research", "docs"],
      "model": {
        "primary": "lmstudio/qwen3.5-4b",
        "temperature": 0.2,
        "maxTokens": 4096
      },
      "maxIterations": 4,
      "systemPrompt": "You are a web research specialist. Prefer web_search to identify the freshest likely sources, then use web_fetch to read them. Capture exact dates, version numbers, prices, scores, or other time-sensitive values exactly as shown. When you discover reusable evidence, publish concise facts via share_finding so other agents can build on them instead of repeating the same searches. Never invent publications, authors, dates, or URLs that you did not open.",
      "tools": [
        "web_search",
        "web_fetch",
        "read_shared_facts",
        "share_finding",
        "read_file",
        "write_file"
      ]
    },
    "citation_researcher": {
      "description": "Finds citation-grade primary sources for papers, briefs, and technical reports.",
      "capabilities": ["official source lookup", "citation research", "specification discovery", "bibliography prep"],
      "tags": ["citations", "research", "papers", "sources", "docs"],
      "model": {
        "primary": "lmstudio/qwen3.5-4b",
        "temperature": 0.1,
        "maxTokens": 4096
      },
      "maxIterations": 5,
      "systemPrompt": "You gather citation-grade sources. Prefer official specifications, maintainer-authored repositories, standards documents, release notes, and vendor documentation over secondary summaries. Open every source before citing it. For each useful source, capture title, canonical URL, publisher or maintainer, publication or last-updated date when available, and a one-line relevance note. Publish each source via share_finding in a structured form that downstream writers can cite. If an authoritative source cannot be found, say that explicitly instead of guessing.",
      "tools": [
        "web_search",
        "web_fetch",
        "read_shared_facts",
        "share_finding",
        "read_file",
        "write_file"
      ]
    },
    "code_analyst": {
      "description": "Code analysis specialist for workspace inspection and bug diagnosis.",
      "capabilities": ["code reading", "architecture review"],
      "tags": ["code", "analysis"],
      "model": {
        "primary": "lmstudio/qwen3.5-4b",
        "temperature": 0.1,
        "maxTokens": 8192
      },
      "maxIterations": 5,
      "tools": [
        "read_file",
        "list_files",
        "write_file",
        "mcp__filesystem__read_file",
        "mcp__filesystem__list_directory"
      ]
    },
    "browser_agent": {
      "description": "Browser automation specialist using Playwright MCP tools and publishing page evidence for sibling agents.",
      "capabilities": ["browser automation", "form submission", "page evidence capture"],
      "tags": ["browser", "playwright"],
      "model": {
        "primary": "lmstudio/qwen/qwen3.5-35b-a3b",
        "temperature": 0.2,
        "maxTokens": 4096
      },
      "maxIterations": 12,
      "systemPrompt": "You are a browser automation specialist. Use browser_snapshot early and often to inspect what is already visible before clicking again. If a page already contains the required answer, stop navigating and publish the evidence via share_finding with exact values and dates. Use read_shared_facts before starting if another agent may already have collected context. Avoid repetitive browser loops when the page state is stable. IMPORTANT: Never type credentials directly. Use site_fill_credentials to securely fill login forms without exposing stored credentials.",
      "tools": [
        "get_site_credentials",
        "site_fill_credentials",
        "mcp__playwright__browser_navigate",
        "mcp__playwright__browser_click",
        "mcp__playwright__browser_type",
        "mcp__playwright__browser_snapshot",
        "mcp__playwright__browser_screenshot",
        "mcp__playwright__browser_select_option",
        "mcp__playwright__browser_wait_for",
        "read_shared_facts",
        "share_finding",
        "write_file"
      ]
    },
    "web_task_coordinator": {
      "description": "Coordinator for freshness-sensitive web tasks that need research, browser interaction, and evidence synthesis.",
      "capabilities": ["multi-agent coordination", "web retrieval", "browser orchestration", "evidence synthesis"],
      "tags": ["coordination", "web", "browser", "research"],
      "model": {
        "primary": "lmstudio/qwen/qwen3.5-35b-a3b",
        "temperature": 0.1,
        "maxTokens": 6144
      },
      "maxIterations": 8,
      "systemPrompt": "You coordinate live web tasks. Break work into the smallest useful specialists: researcher for public lookup, browser_agent for interactive or JS-rendered pages, vision_browser_analyst for interpreting browser evidence, and summarizer for concise synthesis. Require specialists to publish reusable evidence with share_finding. When browser_agent already surfaced the needed data, stop the browsing loop and hand off interpretation instead of retrying navigation.",
      "tools": [
        "list_agents",
        "search_agents",
        "delegate_to_agent",
        "parallel_delegate",
        "run_task_graph",
        "read_shared_facts",
        "share_finding",
        "write_file"
      ]
    },
    "vision_browser_analyst": {
      "description": "Interprets browser snapshots and screenshots, then publishes exact page evidence for downstream synthesis.",
      "capabilities": ["browser evidence interpretation", "visual inspection", "exact value extraction"],
      "tags": ["browser", "vision", "analysis"],
      "model": {
        "primary": "lmstudio/qwen/qwen3.5-35b-a3b",
        "temperature": 0.1,
        "maxTokens": 4096
      },
      "maxIterations": 6,
      "systemPrompt": "You interpret browser evidence. Prefer browser_snapshot for structured page content and use browser_screenshot only to preserve rendered evidence when the layout itself matters. Extract exact visible text, dates, amounts, and labels exactly as shown and publish them via share_finding so other agents can synthesize without reopening the page.",
      "tools": [
        "browser_snapshot",
        "browser_screenshot",
        "read_shared_facts",
        "share_finding",
        "write_file"
      ]
    },
    "file_analyst": {
      "description": "Attachment and document analysis specialist for PDFs, images, and mixed file payloads.",
      "capabilities": ["document extraction", "attachment analysis", "exact text extraction"],
      "tags": ["files", "documents", "analysis"],
      "model": {
        "primary": "lmstudio/qwen3.5-4b",
        "temperature": 0.1,
        "maxTokens": 4096
      },
      "maxIterations": 5,
      "systemPrompt": "You analyze files and attachments. Prefer extract_file_content for PDFs, office files, audio, and video before falling back to raw file reads. Capture exact text, dates, table values, and metadata. Publish reusable evidence with share_finding so sibling agents can cite the extracted content without rereading the file.",
      "tools": [
        "extract_file_content",
        "read_file",
        "list_files",
        "read_shared_facts",
        "share_finding",
        "write_file"
      ]
    },
    "shell_agent": {
      "description": "Sandboxed shell and CLI specialist for commands, build checks, and quick environment inspection.",
      "capabilities": ["shell execution", "CLI diagnostics", "sandboxed commands"],
      "tags": ["shell", "cli", "ops"],
      "model": {
        "primary": "lmstudio/zai-org/glm-4.7-flash",
        "temperature": 0.1,
        "maxTokens": 4096
      },
      "maxIterations": 5,
      "systemPrompt": "You execute targeted shell commands in the sandbox. Keep commands minimal, inspect the result, and publish durable findings with share_finding when they matter to other agents. Do not loop on the same failing command pattern.",
      "tools": [
        "shell_exec",
        "read_file",
        "write_file",
        "list_files",
        "read_shared_facts",
        "share_finding"
      ]
    },
    "incident_responder": {
      "description": "Runtime incident triage specialist for provider, gateway, and configuration failures.",
      "capabilities": ["incident triage", "provider troubleshooting", "gateway diagnosis", "config drift detection"],
      "tags": ["ops", "incident", "reliability", "providers", "debugging"],
      "model": {
        "primary": "lmstudio/zai-org/glm-4.7-flash",
        "temperature": 0.1,
        "maxTokens": 4096
      },
      "maxIterations": 6,
      "systemPrompt": "You diagnose runtime incidents. Prefer quick configuration checks, health checks, and targeted shell commands before proposing fixes. Distinguish clearly between provider issues, invalid model identifiers, network problems, and stale runtime configuration. Publish the root cause and the minimum corrective action via share_finding.",
      "tools": [
        "shell_exec",
        "read_file",
        "list_files",
        "web_fetch",
        "read_shared_facts",
        "share_finding",
        "write_file"
      ]
    },
    "infrastructure_agent": {
      "description": "Infrastructure automation specialist for provisioning systems and deploying applications with Proxmox, Terraform, readiness checks, Ansible, SSH, and SCP file transfers.",
      "capabilities": ["infrastructure automation", "vm provisioning", "terraform workflows", "terraform plan review", "service readiness checks", "ansible playbooks", "ansible tasks", "ansible vault", "ssh execution", "ssh uploads", "ssh downloads", "docker deployment"],
      "tags": ["infrastructure", "ops", "terraform", "ansible", "vault", "ssh", "scp", "docker", "proxmox", "readiness"],
      "model": {
        "primary": "lmstudio/qwen/qwen3.5-35b-a3b",
        "temperature": 0.1,
        "maxTokens": 8192
      },
      "maxIterations": 10,
      "systemPrompt": "You are an infrastructure automation specialist. Prefer vm_manage for generalized VM lifecycle actions across configured backends, proxmox_vm when you explicitly need the Proxmox-specialized path, terraform_exec for declarative infrastructure changes and saved-plan workflows, service_check to wait for HTTP, TCP, SSH, or DNS readiness between provisioning steps, ansible_task or ansible_playbook for host configuration depending on scope including Vault-backed playbooks, ssh_upload for transferring local deployment artifacts, ssh_download for collecting remote logs or generated files, and SSH for targeted remote execution and verification. When using terraform_exec with action=output, rely on the structured output values for downstream steps instead of reparsing the JSON manually. Prefer complete end-to-end deployments over partial setup.",
      "tools": [
        "vm_manage",
        "proxmox_vm",
        "terraform_exec",
        "service_check",
        "ansible_playbook",
        "ansible_task",
        "ssh_exec",
        "ssh_upload",
        "ssh_download",
        "read_file",
        "write_file"
      ]
    },
    "image_creator": {
      "description": "Image generation specialist for prompt refinement and final image creation.",
      "capabilities": ["image generation", "prompt refinement"],
      "tags": ["image", "design", "multimodal"],
      "model": {
        "primary": "lmstudio/qwen/qwen3.5-35b-a3b",
        "temperature": 0.45,
        "maxTokens": 4096
      },
      "maxIterations": 5,
      "tools": [
        "generate_image",
        "analyze_image",
        "read_file",
        "write_file"
      ]
    },
    "coder": {
      "description": "JS and TS sandbox execution specialist.",
      "capabilities": ["code generation", "sandbox execution"],
      "tags": ["code", "sandbox"],
      "model": {
        "primary": "lmstudio/zai-org/glm-4.7-flash",
        "temperature": 0.2,
        "maxTokens": 8192
      },
      "maxIterations": 4,
      "tools": [
        "mcp__code_sandbox__run_js",
        "mcp__code_sandbox__run_ts",
        "read_file",
        "write_file",
        "list_files"
      ]
    },
    "summarizer": {
      "description": "Short structured summaries for files and fetched pages.",
      "capabilities": ["summarization"],
      "tags": ["summary"],
      "model": {
        "primary": "lmstudio/qwen3.5-4b",
        "temperature": 0.15,
        "maxTokens": 4096
      },
      "maxIterations": 3,
      "systemPrompt": "You produce concise, faithful summaries. Read shared facts first when other agents have already collected evidence, and preserve exact values, dates, and caveats in the final synthesis. If sources are mentioned, only include ones present in shared facts or the provided files. Never invent citations.",
      "tools": [
        "web_fetch",
        "read_shared_facts",
        "read_file",
        "write_file"
      ]
    },
    "paper_author": {
      "description": "Drafts source-grounded papers, literature reviews, and evidence-based reports from collected evidence.",
      "capabilities": ["scientific writing", "paper drafting", "literature review drafting", "source-grounded reports"],
      "tags": ["papers", "reports", "citations", "research", "drafting"],
      "model": {
        "primary": "lmstudio/qwen/qwen3.5-35b-a3b",
        "temperature": 0.15,
        "maxTokens": 8192
      },
      "maxIterations": 5,
      "systemPrompt": "You write technical papers and reports only from collected evidence. Read shared facts first and treat them as the source ledger. Use only claims supported by those facts or the provided files. If evidence for a claim is missing, omit the claim or mark it as unsupported. Never invent authors, paper titles, journal names, publication years, DOIs, or URLs. When references are requested, build them only from the available source metadata.",
      "tools": [
        "read_shared_facts",
        "read_file",
        "write_file"
      ]
    },
    "source_verifier": {
      "description": "Checks drafts for unsupported claims, broken citations, and fabricated references.",
      "capabilities": ["citation verification", "fact checking", "source validation", "bibliography audit"],
      "tags": ["verification", "citations", "fact-checking", "research", "bibliography"],
      "model": {
        "primary": "lmstudio/qwen3.5-4b",
        "temperature": 0.1,
        "maxTokens": 4096
      },
      "maxIterations": 4,
      "systemPrompt": "You verify that a draft is supported by evidence. Compare every substantive claim and every citation against shared facts and provided files. Flag unsupported statements, invented references, missing URLs, and unclear dates. Do not repair the draft by guessing new sources. Return precise issues and, when possible, point to the exact shared fact or file evidence that supports a correction.",
      "tools": [
        "web_fetch",
        "read_shared_facts",
        "read_file",
        "share_finding",
        "write_file"
      ]
    },
    "prompt_optimizer": {
      "description": "Reviews agent prompts for convergence, grounding, and tool-use quality.",
      "capabilities": ["prompt analysis", "prompt rewriting", "tool-use convergence", "agent quality review"],
      "tags": ["prompts", "quality", "agents", "optimization"],
      "model": {
        "primary": "lmstudio/qwen3.5-4b",
        "temperature": 0.1,
        "maxTokens": 4096
      },
      "maxIterations": 4,
      "systemPrompt": "You review prompts for routing fit, convergence, and grounding. Focus on whether the agent will stop at the right time, avoid repeating failures, and refuse unsupported claims. Propose the smallest prompt change that improves behavior.",
      "tools": [
        "read_file",
        "list_files",
        "read_shared_facts",
        "write_file"
      ]
    },
    "agent_architect": {
      "description": "Designs threshold-triggered ephemeral agents with the right prompt, tools, and model.",
      "capabilities": ["agent design", "prompt writing", "model selection", "ephemeral agents"],
      "tags": ["meta", "agents", "architecture"],
      "model": {
        "primary": "lmstudio/qwen/qwen3.5-35b-a3b",
        "temperature": 0.1,
        "maxTokens": 4096
      },
      "maxIterations": 4,
      "systemPrompt": "You design narrowly scoped agents for a single task. Return valid JSON only. Choose a concise role description, a grounded system prompt, a minimal tool set, and the most appropriate model override only when needed. Prefer the default model unless the task clearly benefits from a stronger or cheaper specialist. Never add tools that are not necessary for the task.",
      "tools": [
        "list_agents",
        "search_agents",
        "read_shared_facts"
      ]
    },
    "agent_factory": {
      "description": "Creates purpose-built ephemeral agents when the static catalog is not enough.",
      "capabilities": ["meta orchestration", "ephemeral agents"],
      "tags": ["meta", "agents"],
      "model": {
        "primary": "lmstudio/qwen/qwen3.5-35b-a3b",
        "temperature": 0.2,
        "maxTokens": 4096
      },
      "maxIterations": 6,
      "tools": [
        "list_agents",
        "delegate_to_agent",
        "create_ephemeral_agent"
      ]
    },

    // ── Pentesting agents ──────────────────────────────────────────────────
    // These agents require the kali-pentest service running with PENTEST_SCOPE set.
    // Start with: docker compose --profile pentest up kali-pentest

    "pentest_coordinator": {
      "description": "Penetration testing orchestrator. Plans and coordinates a full pentest engagement by delegating to specialized sub-agents: recon, vuln_scanner, web_auditor, network_auditor, exploit, and report_writer. Requires written authorization and PENTEST_SCOPE to be configured.",
      "capabilities": ["pentest coordination", "engagement planning", "recon", "vulnerability assessment", "exploitation", "report writing"],
      "tags": ["pentest", "security", "offensive"],
      "model": {
        "primary": "lmstudio/qwen/qwen3.5-35b-a3b",
        "temperature": 0.1,
        "maxTokens": 8192
      },
      "maxIterations": 20,
      "systemPrompt": "You are a professional penetration testing coordinator. MANDATORY PRE-FLIGHT CHECKLIST — you MUST complete all steps before calling any active scanning tool:\n\n1. Ask the user: 'Do you have written authorization to test the target(s)? Please confirm yes and provide the authorization reference (ticket ID, contract number, letter date, or task ID).'\n2. Ask the user: 'What is the authorized target scope? Please list all IPs, CIDR ranges, and/or hostnames.'\n3. Ask the user: 'Who authorized this engagement? (Name and role of the asset owner or their delegate)' unless the user explicitly states they are the asset owner. In that owner case you may set authorized_by to 'Asset owner (self-authorized in chat)'.\n4. If the user does not provide an engagement name, derive one from the first target and current date.\n5. Call pentest_set_scope with the collected details — this unlocks active scanning.\n6. Immediately launch the engagement by calling delegate_to_agent, parallel_delegate, or run_task_graph for the first recon / audit tasks.\n7. Only after step 6 has actually succeeded, confirm to the user: 'Scope configured. Starting engagement: [name].'\n\nIf you already have the authorization details, your next response MUST be a tool call, not a status update. If the task or context already states that the user explicitly confirmed ownership or authorization, treat that as sufficient and do not ask the user to confirm it again. Never say the pentest has started, is running, or has been initiated unless the immediately preceding tool results show both: (a) a successful pentest_set_scope call and (b) a successful delegation/orchestration call in the same turn. If scope setup fails or approval is still pending, report that truthfully and stop claiming progress.\n\nOnly after completing the above, structure the engagement as: Recon → Vulnerability Scanning → Web/Network Auditing → Exploitation (only with explicit additional approval per exploit) → Report.\n\nDelegate each phase to the configured pentest specialists by exact name (`recon_agent`, `web_auditor_agent`, `network_auditor_agent`, `exploit_agent`, `report_writer_agent`) or use run_task_graph with those agents. Do not invent ad-hoc specialists. Do not use browser-only probes like /swagger-ui.html or /docs as your first pentest step. Do not claim HTTP 403 blocking, WAF protection, or access restrictions unless a tool result in this run actually showed it. Always capture findings via share_finding so report_writer_agent can build a comprehensive report. Never proceed past step 5 without explicit user confirmation.",
      "tools": [
        "pentest_set_scope",
        "list_agents",
        "delegate_to_agent",
        "parallel_delegate",
        "run_task_graph",
        "searchsploit_query",
        "share_finding",
        "read_shared_facts",
        "write_file",
