// StarlingAI configuration example
// Copy this file to the project root as starlingai.json and adjust for your environment.
{
  "providers": {
    "lmstudio": {
      "baseUrl": "http://10.10.0.2:1234/v1",
      "apiKey": "lm-studio",
      "timeoutMs": 30000,
      "maxRetries": 3
    }
    //,
    // "openaiCompatible": {
    //   "coder_vllm": {
    //     "baseUrl": "http://host.docker.internal:8000/v1",
    //     "apiKey": "local-vllm"
    //   }
    // }
    // "anthropic": {
    //   "apiKey": "$ANTHROPIC_API_KEY"
    // }
  },

  "agents": {
    "mainAssistant": {
      "toolMode": "orchestration_only"
    },
    "defaults": {
      "model": {
        "primary": "lmstudio/qwen/qwen3.5-35b-a3b",
        "fallback": "lmstudio/qwen3.5-4b",
        "enableThinking": true,
        "contextWindow": 32768,
        "temperature": 0.2,
        "topP": 0.9,
        "repeatPenalty": 1.05,
        "maxTokens": 4096,
        "embeddingModel": "lmstudio/text-embedding-qwen3-embedding-0.6b"
      }
    },
    "ephemeralGeneration": {
      "enabled": true,
      "skillMatchThreshold": 0.75,
      "architectAgentName": "agent_architect"
    },
    "rateLimit": {
      "requestsPerMinute": 60,
      "toolCallsPerTurn": 20,
      "concurrentSessions": 10
    }
  },

  "retrieval": {
    "search": {
      "backend": "auto"
      // auto mode priority: SearXNG → Playwright (browser-rendered DuckDuckGo) → DuckDuckGo (HTML scraping)
      // Set "backend": "playwright" to force browser-based search only
    }
    //,
    // "search": {
    //   "backend": "searxng",
    //   "searxngBaseUrl": "http://search.k2o",
    //   "timeoutMs": 12000
    // },
    // "reranker": {
    //   "enabled": true,
    //   "baseUrl": "http://host.docker.internal:1234/v1",
    //   "apiKey": "lm-studio",
    //   "model": "Qwen/Qwen3-Reranker-4B"
    // }
  },

  "computerUse": {
    "enabled": true,
    // "visionModel": "lmstudio/qwen2-vl-7b-instruct",
    "adapters": {
      "local_vscode": {
        "codePath": "code"
      }
    },
    // Optional: route remote VNC/RDP/SSH through the bundled sidecar.
    // This keeps native remote-access dependencies out of the gateway.
    "remoteAccessService": {
      "baseUrl": "http://computer-remote:8890",
      "authToken": "$SAI_COMPUTER_REMOTE_TOKEN",
      "timeoutMs": 20000,
      "label": "Remote access sidecar"
    },
    // ── Named nodes — manage multiple machines simultaneously ──
    // Each entry is a named target the agent can connect to.
    // Use computer_list_nodes to see available targets,
    // computer_session_start with node="<name>" to connect.
    "nodes": {
      // ── Example: ephemeral VNC desktop container (--computer-desktop) ──
      // "desktop": {
      //   "adapter": "remote_vnc",
      //   "host": "computer-desktop",
      //   "port": 5901,
      //   "protocol": "vnc",
      //   "credentials": "starling",
      //   "label": "Ephemeral VNC desktop"
      // }
      //,
      // ── Example: Windows PC via VNC ──
      // "win-workstation": {
      //   "adapter": "remote_vnc",
      //   "host": "10.10.0.2",
      //   "port": 5900,
      //   "protocol": "vnc",
      //   "credentials": "vnc-password",
      //   "label": "Windows PC (10.10.0.2)"
      // }
      //,
      // ── Example: Windows PC via RDP ──
      // "win-rdp": {
      //   "adapter": "remote_rdp",
      //   "host": "10.10.0.2",
      //   "port": 3389,
      //   "protocol": "rdp",
      //   "credentials": "Administrator:password",
      //   "displayResolution": "1920x1080",
      //   "label": "Windows RDP (10.10.0.2)"
      // }
      //,
      // ── Example: Linux server via SSH ──
      // "linux-server": {
      //   "adapter": "remote_ssh",
      //   "host": "10.10.0.5",
      //   "port": 22,
      //   "username": "admin",
      //   "credentials": "/home/agent/.ssh/id_rsa",
      //   "authMethod": "key",
      //   "label": "Linux web server"
      // }
    },
    "recordingEnabled": true
  },

  "infrastructure": {
    "automation": {
      "profiles": {
        "local_cli": {
          "type": "local-cli",
          "terraformBinary": "terraform",
          "ansibleBinary": "ansible",
          "ansiblePlaybookBinary": "ansible-playbook"
        }
        //,
        // "ops_webhook": {
        //   "type": "webhook",
        //   "url": "https://ops.example.com/automation",
        //   "headers": {
        //     "Authorization": "Bearer $INFRA_AUTOMATION_TOKEN"
        //   },
        //   "timeoutMs": 45000
        // }
      }
      //,
      // "defaultProfile": "ops_webhook"
    },
    "virtualization": {
      "profiles": {
        "lab_proxmox": {
          "type": "proxmox",
          "apiUrl": "https://proxmox.example.com:8006",
          "node": "pve-01",
          "tokenId": "root@pam!starlingai",
          "tokenSecret": "$PROXMOX_TOKEN_SECRET"
        }
        //,
        // "lab_webhook": {
        //   "type": "webhook",
        //   "url": "https://n8n.example.com/webhook/vm-manage",
        //   "headers": {
        //     "Authorization": "Bearer $INFRA_WEBHOOK_TOKEN"
        //   }
        // }
      }
    }
  },

  "pentest": {
    "serviceUrl": "http://kali-pentest:5010"
    //,
    // "defaultProfile": "ops_webhook",
    // "profiles": {
    //   "ops_webhook": {
    //     "type": "webhook",
    //     "url": "https://ops.example.com/pentest",
    //     "headers": {
    //       "Authorization": "Bearer $PENTEST_WEBHOOK_TOKEN"
    //     },
    //     "timeoutMs": 45000
    //   },
    //   "local_kali": {
    //     "type": "kali-service",
    //     "serviceUrl": "http://kali-pentest:5010"
    //   }
    // }
  },

  "mail": {
    "serviceUrl": "http://mail-service:5020",
    "timeoutMs": 20000
    //,
    // "authToken": "$SAI_MAIL_SERVICE_TOKEN"
  },

  "subAgents": {
    "computer_use_agent": {
      "description": "Desktop automation specialist. Controls the user's computer via keyboard, mouse, and screen analysis.",
      "capabilities": ["desktop automation", "computer use", "window management"],
      "tags": ["computer", "desktop", "vscode", "automation"],
      "maxIterations": 15,
      "systemPrompt": "You are a computer-use automation specialist. Use only general computer tools. On Windows, mouse clicks are the default way to secure keyboard focus. Once a snapshot shows the correct input field focused, stop changing focus and type the requested text immediately. Never ask for or reveal stored usernames or passwords; use get_site_credentials for metadata and computer_type_credential when a login form needs stored credentials typed securely. Do not return narrated future intent such as 'let me take a snapshot' as your final result.",
      "tools": [
        "computer_session_start", "computer_session_attach", "computer_session_stop",
        "computer_snapshot", "computer_click", "computer_type", "computer_type_credential", "computer_hotkey",
        "computer_scroll", "computer_drag", "computer_wait_for",
        "computer_list_windows", "computer_focus_window",
        "computer_capture_region", "computer_clipboard_read", "computer_clipboard_write",
        "computer_upload_file", "computer_download_file",
        "get_site_credentials",
        "share_finding"
      ]
    },
    "researcher": {
      "description": "Web research expert for documentation and public web lookup.",
      "capabilities": ["web research", "documentation lookup", "source triangulation", "fact checking"],
      "tags": ["research", "docs", "sources", "verification"],
      "model": {
        "primary": "lmstudio/qwen3.5-4b",
        "temperature": 0.2,
        "maxTokens": 4096
      },
      "maxIterations": 6,
      "systemPrompt": "You are a web research specialist. Prefer web_search to identify the freshest likely sources, then use web_fetch to read them. Cover multiple source classes when the topic allows: official documentation, maintainer-authored repositories, release notes, standards bodies, academic or government sources, and only then reputable secondary reporting. Capture exact dates, version numbers, prices, scores, or other time-sensitive values exactly as shown. Cross-check important factual claims against at least two independent sources whenever possible; if only one reliable source exists, say that explicitly. If sources disagree, report the disagreement instead of smoothing it over. In every result, mention the sources you used with title or publisher, URL, and date when available. When you discover reusable evidence, publish concise facts via share_finding so other agents can build on them instead of repeating the same searches. Never invent publications, authors, dates, quotes, statistics, or URLs that you did not open.",
      "tools": [
        "web_search",
        "web_fetch",
        "read_shared_facts",
        "share_finding",
        "read_file",
        "write_file"
      ]
    },
    "code_analyst": {
      "description": "Code analysis specialist for workspace inspection and bug diagnosis.",
      "capabilities": ["code reading", "architecture review"],
      "tags": ["code", "analysis"],
      "model": {
        "primary": "lmstudio/qwen3.5-4b",
        "temperature": 0.1,
        "maxTokens": 8192
      },
      "maxIterations": 5,
      "tools": [
        "read_file",
        "list_files",
        "write_file",
        "mcp__filesystem__read_file",
        "mcp__filesystem__list_directory"
      ]
    },
    "browser_agent": {
      "description": "Browser automation specialist using Playwright MCP tools and publishing page evidence for sibling agents.",
      "capabilities": ["browser automation", "form submission", "page evidence capture"],
      "tags": ["browser", "playwright"],
      "model": {
        "primary": "lmstudio/qwen/qwen3.5-35b-a3b",
        "temperature": 0.2,
        "maxTokens": 4096
      },
      "maxIterations": 12,
      "systemPrompt": "You are a browser automation specialist. Use browser_snapshot early and often to inspect what is already visible before clicking again. If a page already contains the required answer, stop navigating and publish the evidence via share_finding with exact values and dates. Use read_shared_facts before starting if another agent may already have collected context. Avoid repetitive browser loops when the page state is stable. IMPORTANT: Never type credentials directly. Use site_fill_credentials to securely fill login forms without exposing stored credentials.",
      "tools": [
        "get_site_credentials",
        "site_fill_credentials",
        "mcp__playwright__browser_navigate",
        "mcp__playwright__browser_click",
        "mcp__playwright__browser_type",
        "mcp__playwright__browser_snapshot",
        "mcp__playwright__browser_screenshot",
        "mcp__playwright__browser_select_option",
        "mcp__playwright__browser_wait_for",
        "read_shared_facts",
        "share_finding",
        "write_file"
      ]
    },
    "web_task_coordinator": {
      "description": "Coordinator for freshness-sensitive web tasks that need research, browser interaction, and evidence synthesis.",
      "capabilities": ["multi-agent coordination", "web retrieval", "browser orchestration", "evidence synthesis"],
      "tags": ["coordination", "web", "browser", "research"],
      "model": {
        "primary": "lmstudio/qwen/qwen3.5-35b-a3b",
        "temperature": 0.1,
        "maxTokens": 6144
      },
      "maxIterations": 8,
      "systemPrompt": "You coordinate live web tasks. Break work into the smallest useful specialists: researcher for public lookup, browser_agent for interactive or JS-rendered pages, vision_browser_analyst for interpreting browser evidence, and summarizer for concise synthesis. Require specialists to publish reusable evidence with share_finding. When browser_agent already surfaced the needed data, stop the browsing loop and hand off interpretation instead of retrying navigation.",
      "tools": [
        "list_agents",
        "search_agents",
        "delegate_to_agent",
        "parallel_delegate",
        "run_task_graph",
        "read_shared_facts",
        "share_finding",
        "write_file"
      ]
    },
    "vision_browser_analyst": {
      "description": "Interprets browser snapshots and screenshots, then publishes exact page evidence for downstream synthesis.",
      "capabilities": ["browser evidence interpretation", "visual inspection", "exact value extraction"],
      "tags": ["browser", "vision", "analysis"],
      "model": {
        "primary": "lmstudio/qwen/qwen3.5-35b-a3b",
        "temperature": 0.1,
        "maxTokens": 4096
      },
      "maxIterations": 6,
      "systemPrompt": "You interpret browser evidence. Prefer browser_snapshot for structured page content and use browser_screenshot only to preserve rendered evidence when the layout itself matters. Extract exact visible text, dates, amounts, and labels exactly as shown and publish them via share_finding so other agents can synthesize without reopening the page.",
      "tools": [
        "browser_snapshot",
        "browser_screenshot",
        "read_shared_facts",
        "share_finding",
        "write_file"
      ]
    },
    "file_analyst": {
      "description": "Attachment and document analysis specialist for PDFs, images, and mixed file payloads.",
      "capabilities": ["document extraction", "attachment analysis", "exact text extraction"],
      "tags": ["files", "documents", "analysis"],
      "model": {
        "primary": "lmstudio/qwen3.5-4b",
        "temperature": 0.1,
        "maxTokens": 4096
      },
      "maxIterations": 5,
      "systemPrompt": "You analyze files and attachments. Prefer extract_file_content for PDFs, office files, audio, and video before falling back to raw file reads. Capture exact text, dates, table values, and metadata. Publish reusable evidence with share_finding so sibling agents can cite the extracted content without rereading the file.",
      "tools": [
        "extract_file_content",
        "read_file",
        "list_files",
        "read_shared_facts",
        "share_finding",
        "write_file"
      ]
    },
    "document_intake": {
      "description": "Document intake specialist for classifying, extracting, and normalizing long reports, PDFs, DOCX files, and mixed attachments into reusable facts.",
      "capabilities": ["document intake", "attachment classification", "content normalization", "metadata extraction", "handoff preparation"],
      "tags": ["documents", "intake", "attachments", "pdf", "docx"],
      "model": {
        "primary": "lmstudio/qwen3.5-4b",
        "temperature": 0.1,
        "maxTokens": 6144
      },
      "maxIterations": 6,
      "systemPrompt": "You prepare documents for the rest of the swarm. Start by identifying what files are present, their formats, likely purpose, date range, authorship signals, and whether they look narrative, tabular, scanned, or mixed. Prefer extract_file_content for PDFs, office files, audio, and video, and use analyze_image when screenshots, scans, or embedded figures matter. Normalize the result into reusable findings: what the document is, what period it covers, what sections or tables matter, what data is missing, and which downstream specialist should use it next. Publish enough structured intake facts via share_finding that other agents can work from the intake summary instead of reopening every attachment.",
      "tools": [
        "extract_file_content",
        "analyze_image",
        "read_file",
        "list_files",
        "workspace_search",
        "read_shared_facts",
        "share_finding",
        "write_file"
      ]
    },
    "evidence_analyst": {
      "description": "Synthesizes fetched pages, shared facts, files, and visual evidence into a grounded evidence ledger.",
      "capabilities": ["evidence synthesis", "cross-source reconciliation", "document grounding", "research handoff"],
      "tags": ["evidence", "analysis", "research", "grounding"],
      "model": {
        "primary": "lmstudio/qwen3.5-4b",
        "temperature": 0.1,
        "maxTokens": 6144
      },
      "maxIterations": 6,
      "systemPrompt": "You turn raw evidence into a grounded evidence ledger. Read shared facts first, then inspect any relevant files or extracted documents. Reconcile duplicate or conflicting evidence, separate confirmed facts from tentative claims, and preserve exact source attribution for each item. When evidence conflicts, keep both sides and identify what still needs confirmation. Publish structured findings via share_finding so writers and coordinators can build on a clean evidence base instead of raw notes.",
      "tools": [
        "read_shared_facts",
        "read_file",
        "list_files",
        "extract_file_content",
        "analyze_image",
        "share_finding",
        "write_file"
      ]
    },
    "data_analyst": {
      "description": "Analyzes structured data such as CSV, JSON, spreadsheets, metrics snapshots, and exported reports.",
      "capabilities": ["data analysis", "csv review", "json inspection", "metrics interpretation", "tabular summarization"],
      "tags": ["data", "analysis", "csv", "json", "metrics"],
      "model": {
        "primary": "lmstudio/qwen3.5-4b",
        "temperature": 0.1,
        "maxTokens": 6144
      },
      "maxIterations": 6,
      "systemPrompt": "You analyze structured data and tabular evidence. Prefer extracted file content, raw file reads, and workspace search before writing conclusions. Preserve exact numeric values, units, date ranges, column names, and caveats. Distinguish clearly between observed data, derived interpretation, and missing data. When a calculation or summary matters to other agents, publish it via share_finding with enough context to be reused without reopening the source files.",
      "tools": [
        "extract_file_content",
        "read_file",
        "list_files",
        "workspace_search",
        "read_shared_facts",
        "share_finding",
        "write_file"
      ]
    },
    "integration_builder": {
      "description": "Integration specialist for APIs, webhooks, MCP wiring, and automation glue between services.",
      "capabilities": ["api integration", "webhook design", "mcp setup", "automation glue", "workflow handoff"],
      "tags": ["integration", "api", "webhook", "mcp", "automation"],
      "model": {
        "primary": "lmstudio/qwen/qwen3.5-35b-a3b",
        "temperature": 0.1,
        "maxTokens": 8192
      },
      "maxIterations": 8,
      "systemPrompt": "You design and implement integrations between tools and services. Start by inspecting the existing workspace and shared facts so you reuse current endpoints, payloads, contracts, and tool names instead of inventing new ones. Prefer minimal, explicit glue: document the source system, target system, trigger, auth boundary, request shape, retries, and failure handling. Use web_search or web_fetch only when current repo context is insufficient. When validating an integration, prefer targeted shell checks or small reproducible examples over broad speculative changes. Publish reusable facts such as discovered endpoints, webhook contracts, MCP server names, and rollout caveats via share_finding.",
      "tools": [
        "workspace_search",
        "read_file",
        "list_files",
        "write_file",
        "shell_exec",
        "web_search",
        "web_fetch",
        "read_shared_facts",
        "share_finding"
      ]
    },
    "shell_agent": {
      "description": "Sandboxed shell and CLI specialist for commands, build checks, and quick environment inspection.",
      "capabilities": ["shell execution", "CLI diagnostics", "sandboxed commands"],
      "tags": ["shell", "cli", "ops"],
      "model": {
        "primary": "lmstudio/zai-org/glm-4.7-flash",
        "temperature": 0.1,
        "maxTokens": 4096
      },
      "maxIterations": 5,
      "systemPrompt": "You execute targeted shell commands in the sandbox. Keep commands minimal, inspect the result, and publish durable findings with share_finding when they matter to other agents. Do not loop on the same failing command pattern.",
      "tools": [
        "shell_exec",
        "read_file",
        "write_file",
        "list_files",
        "read_shared_facts",
        "share_finding"
      ]
    },
    "qa_guard": {
      "description": "Regression and verification specialist for reproducing issues, running tests, and checking whether a change actually solved the task.",
      "capabilities": ["test execution", "regression verification", "bug reproduction", "implementation review"],
      "tags": ["qa", "tests", "verification", "regression"],
      "model": {
        "primary": "lmstudio/zai-org/glm-4.7-flash",
        "temperature": 0.1,
        "maxTokens": 4096
      },
      "maxIterations": 6,
      "systemPrompt": "You verify that work actually solves the task. Reproduce the reported issue when possible, run the smallest relevant checks first, and only expand to broader validation when warranted. Distinguish clearly between confirmed fixes, partial fixes, and unverified assumptions. Publish concise verification findings and residual risks via share_finding so the final answer can separate evidence from hope.",
      "tools": [
        "shell_exec",
        "read_file",
        "list_files",
        "workspace_search",
        "read_shared_facts",
        "share_finding",
        "write_file"
      ]
    },
    "ops_triage": {
      "description": "Operational triage specialist for service health, deployment failures, log-driven diagnosis, and container/runtime issues.",
      "capabilities": ["service triage", "deployment diagnosis", "log inspection", "container troubleshooting", "health-check analysis"],
      "tags": ["ops", "triage", "logs", "containers", "reliability"],
      "model": {
        "primary": "lmstudio/zai-org/glm-4.7-flash",
        "temperature": 0.1,
        "maxTokens": 4096
      },
      "maxIterations": 6,
      "systemPrompt": "You triage operational failures before remediation starts. Begin with the cheapest evidence: service_check for availability, relevant config or log files, and narrow shell commands that confirm process, container, network, or startup state. Separate observed symptoms from inferred root cause, and avoid proposing broad fixes until you have at least one concrete failure signal. Hand provider, model, or gateway config faults to incident_responder when the problem is primarily runtime configuration, and hand infrastructure changes to infrastructure_agent when the diagnosis is complete and remediation needs provisioning or deployment work. Publish the most likely root cause, impacted component, and next corrective action via share_finding.",
      "tools": [
        "service_check",
        "shell_exec",
        "read_file",
        "list_files",
        "workspace_search",
        "web_fetch",
        "read_shared_facts",
        "share_finding",
        "write_file"
      ]
    },
    "policy_compliance_reviewer": {
      "description": "Policy and approval specialist for checking planned actions, outputs, and workflows against guardrails, approvals, and compliance constraints.",
      "capabilities": ["policy review", "approval analysis", "compliance screening", "risk flagging", "workflow constraints"],
      "tags": ["policy", "compliance", "approval", "risk", "review"],
      "model": {
        "primary": "lmstudio/qwen3.5-4b",
        "temperature": 0.1,
        "maxTokens": 4096
      },
      "maxIterations": 5,
      "systemPrompt": "You review plans, outputs, and workflows against explicit constraints. Read shared facts, relevant files, and any available task context before judging risk. Check for approval requirements, destructive actions, credential handling, external communications, data-sensitivity issues, unsupported authorization claims, and policy mismatches. Distinguish clearly between hard blockers, soft risks, and missing evidence. Do not rewrite the whole plan unless asked; publish the minimum blocking issues, required approvals, and safe next steps via share_finding.",
      "tools": [
        "read_file",
        "list_files",
        "workspace_search",
        "read_shared_facts",
        "share_finding",
        "write_file"
      ]
    },
    "meeting_briefing_agent": {
      "description": "Briefing specialist for turning long threads, files, findings, and project updates into concise handoff notes and executive-ready summaries.",
      "capabilities": ["meeting briefings", "handoff notes", "status packets", "executive summaries", "action lists"],
      "tags": ["briefing", "handoff", "meetings", "summary", "status"],
      "model": {
        "primary": "lmstudio/qwen3.5-4b",
        "temperature": 0.15,
        "maxTokens": 6144
      },
      "maxIterations": 5,
      "systemPrompt": "You turn collected material into high-signal briefings. Start with shared facts and existing files so you reuse the swarm's evidence instead of recomposing it from scratch. Organize results for fast reading: current status, key facts, risks or blockers, decisions needed, owners, dates, and next actions. Preserve exact names, dates, metrics, and caveats. Use generate_document for Markdown, HTML, text, or JSON deliverables, and use generate_pdf when the user needs a printable handout. Publish durable meeting facts or action items via share_finding when downstream agents may need them.",
      "tools": [
        "read_shared_facts",
        "read_file",
        "list_files",
        "workspace_search",
        "generate_document",
        "generate_pdf",
        "share_finding",
        "write_file"
      ]
    },
    "incident_responder": {
      "description": "Runtime incident triage specialist for provider, gateway, and configuration failures.",
      "capabilities": ["incident triage", "provider troubleshooting", "gateway diagnosis", "config drift detection"],
      "tags": ["ops", "incident", "reliability", "providers", "debugging"],
      "model": {
        "primary": "lmstudio/zai-org/glm-4.7-flash",
        "temperature": 0.1,
        "maxTokens": 4096
      },
      "maxIterations": 6,
      "systemPrompt": "You diagnose runtime incidents. Prefer quick configuration checks, health checks, and targeted shell commands before proposing fixes. Distinguish clearly between provider issues, invalid model identifiers, network problems, and stale runtime configuration. Publish the root cause and the minimum corrective action via share_finding.",
      "tools": [
        "shell_exec",
        "read_file",
        "list_files",
        "web_fetch",
        "read_shared_facts",
        "share_finding",
        "write_file"
      ]
    },
    "infrastructure_agent": {
      "description": "Infrastructure automation specialist for provisioning systems and deploying applications with Proxmox, Terraform, readiness checks, Ansible, SSH, and SCP file transfers.",
      "capabilities": ["infrastructure automation", "vm provisioning", "terraform workflows", "terraform plan review", "service readiness checks", "ansible playbooks", "ansible tasks", "ansible vault", "ssh execution", "ssh uploads", "ssh downloads", "docker deployment"],
      "tags": ["infrastructure", "ops", "terraform", "ansible", "vault", "ssh", "scp", "docker", "proxmox", "readiness"],
      "model": {
        "primary": "lmstudio/qwen/qwen3.5-35b-a3b",
        "temperature": 0.1,
        "maxTokens": 8192
      },
      "maxIterations": 10,
