{
  "name": "starlingai",
  "version": "0.40.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.6.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "dependencies": {
    "json5": "^2.2.3"
  },
  "scripts": {
    "sai": "node scripts/sai.mjs",
    "setup": "node scripts/sai.mjs setup",
    "start": "node scripts/sai.mjs start",
    "stop": "node scripts/sai.mjs stop",
    "config:build": "node scripts/sai.mjs config build",
    "config:split": "node scripts/sai.mjs config split",
    "config:audit-flags": "node scripts/audit-config-flags.mjs",
    "config:audit-prompts": "node scripts/audit-agent-prompts.mjs",
    "token": "node scripts/sai.mjs token",
    "health": "node scripts/sai.mjs health",
    "build": "pnpm -r build",
    "security:pack": "pnpm --filter @starlingai/core security:pack",
    "dev": "pnpm -r --parallel dev",
    "test": "pnpm -r test",
    "check": "node scripts/check-root-layout.mjs && pnpm -r check",
    "check:root": "node scripts/check-root-layout.mjs",
    "lint": "eslint packages/core/src packages/mail-service/src",
    "gateway:dev": "pnpm --filter @starlingai/core dev",
    "computer-remote:dev": "pnpm --filter @starlingai/core dev:computer-remote",
    "web:dev": "pnpm --filter @starlingai/web dev",
    "agents:evaluate": "pnpm --filter @starlingai/core agents:evaluate",
    "runtime-guidance:evaluate": "pnpm --filter @starlingai/core runtime-guidance:evaluate"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "3.2.6",
    "eslint": "^10.4.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "typescript-eslint": "^8.60.1"
  }
}
