{
  // Operations, comms & automation — incident response, broadcast, and task automation.
  "scenes": {
    "incident_response": {
      "description": "Triage a live or recent incident, collect root-cause evidence, and produce a structured internal incident summary.",
      "task": "Use ops_triage for service-health diagnosis and immediate remediation guidance, log_analyst for timeline reconstruction and correlation across logs, then meeting_briefing_agent or summarizer to structure the incident findings for downstream reporting. Keep observed symptoms, root-cause evidence, remediation steps, and open risks separate.",
      "allowedAgents": [
        "ops_triage",
        "log_analyst",
        "meeting_briefing_agent",
        "summarizer",
        "quality_supervisor",
        "qa_guard"
      ],
      "params": {
        "incident": {
          "description": "Description of the incident or outage",
          "default": "investigate the reported service incident"
        },
        "severity": {
          "description": "Incident severity hint",
          "default": "high"
        },
        "affectedService": {
          "description": "Impacted service or component",
          "default": "discover from logs"
        }
      }
    },
    "multi_channel_broadcast": {
      "description": "Deliver a prepared summary, report link, or status update to one or more configured communication channels.",
      "task": "Use notification_agent to send the prepared summary or artifact reference to the requested channels. Read shared findings first so the notification reuses the confirmed message, artifact path, or report summary instead of inventing new wording.",
      "allowedAgents": [
        "notification_agent",
        "summarizer"
      ],
      "params": {
        "channels": {
          "description": "Comma-separated delivery channels",
          "default": "slack"
        },
        "tone": {
          "description": "Delivery tone or urgency",
          "default": "informational"
        }
      }
    },
    "apply_jobs": {
      "description": "Run one browser-assisted freelance application from the n8n application table.",
      "task": "Use browser_agent to execute one iteration of the freelance application workflow. First call get_site_credentials for {{n8nSite}} and use its loginUrl, named URLs, selectors, and notes to log in and open the application table; if the table URL is available as a named URL, use it instead of guessing. Sort the application table by ranking (rating column) from highest to lowest. CRITICAL n8n DATA-TABLE QUIRK: clicking the column NAME text opens an inline rename editor (NOT a sort). To trigger the sort you must click inside the same header cell but BESIDE the column name — the empty area of the column header cell, not the name itself. So target the rating column header CELL (the wrapper, not the inline-edit-preview text element); if the snapshot exposes refs both for the cell and for the name text, pick the cell wrapper. Try this AT MOST ONCE — if the rows still do not visibly reorder, stop trying to sort, read the rows already visible in the snapshot, and pick the highest-rated eligible one directly. Never click the column name text repeatedly; never enter the inline editor; never type empty text and submit on it. Select the first row that is not already checked or applied and whose reason is not exactly or semantically 'low rating'. If the table already exposes the job URL, navigate directly to it instead of clicking the table cell just to inspect it. Open the job link from that row. If no eligible rows remain, stop and tell the user: 'Es gibt momentan keine passenden Projekte - komm spaeter wieder.' For an eligible job, use the exact job URL host for platform credentials when visible; otherwise use {{freelancermapSite}}. Before attempting an external-platform login or application submit, call get_site_credentials for that exact freelance platform host. If those credentials are missing, stop immediately, summarize the selected project and blocker, and tell the user to add the host in StarlingAI Settings -> Site Credentials, not in n8n. Use the application letter from the n8n row's reason column; if it is missing or unsuitable, write a concise tailored application letter based only on the job posting. Apply for the job through the platform flow. After exactly one job application attempt, stop, summarize the project, action taken, and any blocker, then ask the user whether to continue. Do not ask the user for a job lead; the lead source is the {{n8nSite}} application table. Never expose credential values; use site_fill_credentials for browser logins.",
      "webhookKey": "$SCENE_APPLY_JOBS_KEY",
      "allowedAgents": [
        "browser_agent",
        "summarizer"
      ],
      // Only the credential fill needs a human gate; routine clicks/typing run
      // unattended so the agent can complete the flow without an approval on
      // every step. The real human-in-the-loop moment is the freelancermap
      // CAPTCHA, which browser_agent surfaces via request_human_assist (live
      // browser in the dashboard). Watch progress in the Operator Requests dock.
      "humanInLoopSteps": [
        "site_fill_credentials"
      ],
      "approvalChannel": "slack-approvals",
      "params": {
        "n8nSite": {
          "description": "Stored site credential key for the internal n8n application table",
          "default": "n8n.k2o"
        },
        "freelancermapSite": {
          "description": "Stored site credential key for the external freelance platform",
          "default": "freelancermap.de"
        }
      }
    }
  }
}
