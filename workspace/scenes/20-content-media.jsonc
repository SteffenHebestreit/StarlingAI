{
  // Authored deliverables & media — content, briefings, decks, and image verification.
  "scenes": {
    "content_creation": {
      "description": "Research and draft audience-ready content such as blog posts, newsletters, product copy, or documentation.",
      "task": "When research is required, use researcher to gather current source material first, then content_writer to produce the requested content in the right tone and format. Use quality_supervisor for one acceptance pass so the draft stays aligned with the audience, tone, and evidence base.",
      "allowedAgents": [
        "researcher",
        "content_writer",
        "quality_supervisor",
        "summarizer",
        "qa_guard"
      ],
      "params": {
        "contentType": {
          "description": "Requested content type",
          "default": "blog-post"
        },
        "topic": {
          "description": "Topic or key message",
          "default": ""
        },
        "audience": {
          "description": "Intended audience",
          "default": "general technical audience"
        },
        "tone": {
          "description": "Tone or voice guidance",
          "default": "professional and engaging"
        },
        "requiresResearch": {
          "description": "Whether research should happen before drafting",
          "default": "yes"
        }
      }
    },
    "release_notes_draft": {
      "description": "Draft release notes from repository history for a version or ref range.",
      "task": "Use git_developer to inspect the requested ref range, collect the relevant commits and notable changes, then use content_writer to turn that evidence into audience-appropriate release notes. Use quality_supervisor for one completeness pass before finalizing.",
      "allowedAgents": [
        "git_developer",
        "content_writer",
        "quality_supervisor",
        "summarizer"
      ],
      "params": {
        "version": {
          "description": "Release version label",
          "default": "next"
        },
        "targetRef": {
          "description": "Git ref range to summarize",
          "default": "HEAD~20..HEAD"
        },
        "audience": {
          "description": "Intended audience for the notes",
          "default": "internal team"
        },
        "broadcast": {
          "description": "Whether a follow-up broadcast is planned",
          "default": "no"
        }
      }
    },
    "onboarding_packet": {
      "description": "Build a structured onboarding packet for a topic, project, or new team member.",
      "task": "Use document_intake first when source material or existing docs are provided, meeting_briefing_agent to structure the packet, and content_writer to polish the final onboarding guide for the requested audience and language. Use qa_guard when the packet needs an explicit completeness check.",
      "allowedAgents": [
        "document_intake",
        "meeting_briefing_agent",
        "content_writer",
        "summarizer",
        "qa_guard"
      ],
      "params": {
        "topic": {
          "description": "What the packet covers",
          "default": ""
        },
        "audience": {
          "description": "Who the packet is for",
          "default": "new team member with intermediate technical background"
        },
        "outputLanguage": {
          "description": "Language for the final packet",
          "default": "English"
        },
        "outputFormat": {
          "description": "Preferred delivery format",
          "default": "structured Markdown with sections and a quick-reference table"
        }
      }
    },
    "meeting_briefing_packet": {
      "description": "Produce a concise meeting brief or handoff packet from attached material, prior findings, and project context.",
      "task": "Use document_intake first when source material includes files or long notes, data_analyst for tabular attachments, evidence_analyst to reconcile the evidence ledger, policy_compliance_reviewer when approvals or constraints matter, and meeting_briefing_agent to produce the final brief or handoff packet. Use qa_guard when the packet needs an explicit verification pass.",
      "allowedAgents": [
        "document_intake",
        "data_analyst",
        "evidence_analyst",
        "policy_compliance_reviewer",
        "meeting_briefing_agent",
        "summarizer",
        "qa_guard"
      ],
      "params": {
        "audience": {
          "description": "Target audience for the packet",
          "default": "project stakeholders"
        },
        "outputFormat": {
          "description": "Preferred delivery format",
          "default": "markdown brief with actions, decisions, and open risks"
        }
      }
    },
    "deck_research": {
      "description": "Gather and cite the FACTUAL evidence for a slide deck or written brief: names, dates, figures, definitions, and authoritative source URLs. Facts only — no image sourcing, no building. Internal research step of the deck pipeline.",
      "task": "You are running ONE scoped step of a larger pipeline: the FACT-RESEARCH step only. Later steps (run automatically after you) handle images and building the deck/paper — you must NOT do those here, and you must NOT plan or coordinate the whole deliverable. Use the Additional workflow context ONLY to identify the SUBJECT to research. Then delegate the research to the agent 'researcher' (the only agent available in this step) with delegate_to_agent — do NOT call mission_coordinator, parallel_delegate, run_task_graph, or any coordinator, and do NOT record a multi-step plan. The researcher must gather and verify the factual evidence ONLY: names, dates, figures, definitions, and authoritative source URLs for the subject, publishing each confirmed fact with its source URL via share_finding and marking anything unconfirmed as unverified. Write findings in {{language}}.",
      "allowedAgents": ["researcher"],
      "params": {
        "language": { "description": "Output language", "default": "the language of the user's request" }
      }
    },
    "deck_images": {
      "description": "Source, verify, and locally SAVE real free-license images for a slide deck, one per subject, via fetch_image. Images only — no fact research, no building. Internal image step of the deck pipeline.",
      "task": "You are running ONE scoped step of a larger pipeline: the IMAGE-SOURCING step only. The deck/paper are built by a LATER step — do NOT research facts and do NOT build any deck or paper here. Delegate to the agent 'image_sourcer' (the only agent available in this step) with delegate_to_agent — do NOT call researcher, mission_coordinator, or any coordinator. Identify the SUBJECT of the deck from the Additional workflow context below (e.g. the building/place/topic the user named); the shared facts from the research step, if present, name more specific sub-subjects worth a picture. Instruct image_sourcer to find images for that subject and its main sub-subjects: it has web_search to locate free-license image pages (Wikimedia Commons etc.) AND fetch_image to download+verify+save them — it does NOT need the research facts to do its job, the topic is enough. For each subject call fetch_image(url: <a free-license source page or direct image URL it found via web_search>, subject: <the subject>, outputDir: \"{{outputDir}}/images\"); fetch_image downloads the bytes, confirms a real image, checks the subject when a vision model is available, and saves a local copy. It resolves the real image from a page itself, so NEVER guess or construct a direct/hashed URL. Publish each saved image via share_finding with the workspace PATH it returned (e.g. {{outputDir}}/images/<file>), the source page, and the license. If a subject's image cannot be verified, report it unverified and leave it imageless rather than inventing a URL.",
      "allowedAgents": ["image_sourcer"],
      "params": {
        "outputDir": { "description": "Workspace folder whose images/ subfolder receives the saved images", "default": "presentation" }
      }
    },
    "deck_build": {
      "description": "Build the requested deck deliverables (reveal.js HTML presentation, per-slide detail notes, written paper) from ONLY the already-verified shared facts and locally saved images. Build step — does not research or source. Internal final step of the deck pipeline.",
      "task": "You are running the FINAL scoped step of a pipeline: BUILD the deliverables only. The facts and the saved local images already ran in earlier steps and are in the shared facts. Do NOT research facts and do NOT source images here. Delegate to the agent 'content_writer' (the only agent available in this step) with delegate_to_agent — do NOT call researcher, image_sourcer, mission_coordinator, or any coordinator. Instruct content_writer to: read ALL shared facts (the verified research findings AND the saved image paths), then build the requested deliverables ({{deliverables}}) into \"{{outputDir}}\" from ONLY those verified facts and SAVED local images. Use generate_presentation (outputDir \"{{outputDir}}\", {{slideCount}}, each slide showing just its core point); embed any picture as a Markdown image in the slide content using the slide-relative path to the saved file — `![alt](images/<file>)` — taken from a shared image finding. Leave a slide image-free if no saved image exists rather than inventing one. Cite the researched sources in the paper. Write all content in {{language}}; if the research step verified nothing, say so honestly instead of fabricating, and do not claim images are verified unless they were actually saved.",
      "allowedAgents": ["content_writer"],
      "params": {
        "outputDir": { "description": "Workspace folder to build into (deck at <outputDir>/index.html, images at <outputDir>/images)", "default": "presentation" },
        "slideCount": { "description": "How many slides the deck should have", "default": "about 10 slides" },
        "deliverables": { "description": "Which artifacts to produce", "default": "a reveal.js HTML presentation, a Markdown file of per-slide bullet details, and a ~1000-word paper that cites the verified sources" },
        "language": { "description": "Output language", "default": "the language of the user's request" }
      }
    },
    "validate_image": {
      "description": "Verify that one or more candidate image URLs are reachable AND actually depict the requested subject, before anything embeds them. Returns a per-URL VERIFIED / REJECTED / UNVERIFIED verdict and publishes the verified URLs verbatim. Use it to vet image links (e.g. for a presentation, web page, or document) instead of trusting an unchecked URL. Example queries: 'verify these image URLs show the Zwinger', 'check that these photo links work and are the right building', 'validate the image URLs before we embed them', 'prüfe ob diese Bild-URLs erreichbar sind und das richtige Motiv zeigen'.",
      "task": "Validate the candidate image URL(s) for the subject \"{{subject}}\" so only real, on-topic images get used downstream. Read shared facts first — the candidates may already be there. Handle each URL ONE at a time and do EXACTLY this; never web_search for or invent alternative URLs:\n1. REACHABLE? Call url_inspect on the URL. It PASSES only on a final HTTP 200 with a content-type that starts image/ (image/jpeg, image/png, …). A 404 or non-image content-type = REJECT. A 429 (rate-limited) is INCONCLUSIVE: wait briefly and re-inspect once; if still 429, mark it UNVERIFIED rather than rejecting.\n2. RIGHT SUBJECT? For each reachable URL, browser_navigate to that exact URL, browser_screenshot it, then analyze_image the screenshot and decide whether it actually depicts \"{{subject}}\". If it shows something unrelated, REJECT it. (If no vision model is available, accept the reachable image but note 'subject not visually confirmed'.)\n3. Never modify, resize, re-host, or guess a URL — validate exactly the strings you were given.\nThen report a compact verdict list — for EVERY input URL: VERIFIED / REJECTED / UNVERIFIED, the EXACT URL, and a one-line reason — and publish each VERIFIED URL (exact string, plus what it depicts) via share_finding so downstream steps embed it verbatim. Do not pass, embed, or recommend any URL that did not reach VERIFIED (or UNVERIFIED with a clear caveat). Candidate URLs:\n{{candidateUrls}}",
      "allowedAgents": [
        "image_sourcer"
      ],
      "params": {
        "subject": {
          "description": "What the images must depict (e.g. 'the Dresden Zwinger')",
          "default": "the requested subject"
        },
        "candidateUrls": {
          "description": "The image URLs to validate (newline- or comma-separated)",
          "default": "(use the candidate image URLs already in shared facts or named in the request)"
        }
      }
    }
  }
}
