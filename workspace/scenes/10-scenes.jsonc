{
  "scenes": {
    "apply_jobs": {
      "description": "Run a browser-assisted application workflow for one approved freelance lead. Example triggers: 'apply to the approved freelance lead', 'bewerbe mich auf den freigegebenen Auftrag', 'submit the application form for this project', 'Bewerbung für den genehmigten Lead einreichen'.",
      "task": "Use web_task_coordinator to review one approved lead, gather any missing context, and delegate browser submission steps only when stored credentials exist for the target site and secure credential fill has been approved.",
      "webhookKey": "$SCENE_APPLY_JOBS_KEY",
      "allowedAgents": [
        "web_task_coordinator",
        "browser_agent",
        "researcher",
        "summarizer"
      ],
      "humanInLoopSteps": [
        "site_fill_credentials",
        "mcp__playwright__browser_navigate"
      ],
      "approvalChannel": "slack-approvals",
      "params": {
        "minRating": {
          "description": "Minimum lead rating to accept",
          "default": "0.7"
        }
      }
    },
    "browser_inspection": {
      "description": "Open a website, capture Playwright browser evidence, and summarize what is visible or blocked on the page. Example triggers: 'check what's currently shown on example.com', 'prüfe welche Inhalte auf der Webseite sichtbar sind', 'inspect the landing page and report visible text', 'schaue dir die Seite an und beschreibe was zu sehen ist', 'verify the page loaded correctly after login', 'Browser-Snapshot mit Zusammenfassung erstellen'.",
      "task": "Use web_task_coordinator first when the page may be JS-rendered, multi-step, or ambiguous. Delegate browser_agent to open the target website, wait for the relevant page state, and capture browser_snapshot plus browser_screenshot evidence when the rendered view matters. Use vision_browser_analyst or evidence_analyst to interpret the captured page evidence, then summarizer to produce a concise grounded inspection result with exact visible text, URLs, blockers, and next steps.",
      "allowedAgents": [
        "web_task_coordinator",
        "browser_agent",
        "vision_browser_analyst",
        "evidence_analyst",
        "summarizer"
      ],
      "humanInLoopSteps": [
        "site_fill_credentials"
      ],
      "params": {
        "targetUrl": {
          "description": "Website or page URL to open and inspect",
          "default": ""
        },
        "inspectionGoal": {
          "description": "What should be checked, extracted, or verified on the page",
          "default": "capture a snapshot and screenshot of the relevant page state, then summarize what is visible"
        },
        "captureMode": {
          "description": "Preferred evidence capture mode",
          "default": "snapshot plus screenshot when the rendered layout matters"
        }
      }
    },
    "n8n_project_list": {
      "description": "Authenticated access to internal web applications: log in to a target URL (supports internal HTTP domains like n8n.k2o), fill credentials, and navigate to a protected page such as the n8n project list (Projektliste, Einträge prüfen, neue Workflows). Includes enhanced timeout handling and error recovery for internal networks.",
      "task": "Use web_task_coordinator to orchestrate the multi-step browser workflow. First, detect if targetUrl is an internal HTTP domain (e.g., http://n8n.k2o) and configure browser settings accordingly. Set explicit timeout of 120 seconds for all navigation and interaction steps. Use browser_agent to navigate to the target URL with HTTP protocol enforcement and enhanced error handling for internal networks. Trigger site_fill_credentials human-in-loop step for secure credential entry. Use browser_agent to fill username and password fields with retry logic, submit the login form, and wait for successful authentication with extended timeout. After login, navigate to the protected Project List page. Use evidence_analyst or vision_browser_analyst to verify login success (e.g., check for user dashboard elements). Implement error recovery: if navigation fails due to internal network issues, retry with adjusted settings. Finally, use summarizer to produce a concise report with: navigation steps completed, login status, current page state, timeout configurations used, and any blockers encountered.",
      "allowedAgents": [
        "web_task_coordinator",
        "browser_agent",
        "vision_browser_analyst",
        "evidence_analyst",
        "summarizer"
      ],
      "humanInLoopSteps": [
        "site_fill_credentials",
        "mcp__playwright__browser_navigate"
      ],
      "approvalChannel": "slack-approvals",
      "params": {
        "targetUrl": {
          "description": "Initial URL to open (supports internal HTTP domains like http://n8n.k2o)",
          "default": "http://n8n.k2o"
        },
        "protectedPageUrl": {
          "description": "URL of the protected page to navigate after login (e.g., Project List page)",
          "default": "http://n8n.k2o/projects"
        },
        "credentialStoreName": {
          "description": "Name of the credential store to use for login credentials",
          "default": "n8n_credentials"
        },
        "verificationSelectors": {
          "description": "CSS selectors to verify successful login (e.g., user menu, dashboard elements)",
          "default": ".user-menu, .dashboard, .project-list"
        },
        "outputFormat": {
          "description": "Report format: markdown, json, or brief",
          "default": "markdown with step-by-step log and verification status"
        },
        "navigationTimeout": {
          "description": "Navigation timeout in seconds (minimum 120 for internal domains)",
          "default": "120"
        },
        "retryCount": {
          "description": "Number of retry attempts for failed navigation steps",
          "default": "3"
        },
        "useHttpExplicitly": {
          "description": "Force HTTP protocol instead of HTTPS (required for internal domains)",
          "default": "true"
        },
        "internalDomainHandling": {
          "description": "Strategy for handling internal network domains",
          "default": "enhanced_timeout_with_retry_and_error_recovery"
        }
      }
    },
    "source_backed_paper": {
      "description": "Produce a paper, report, or research brief grounded in official sources and verified citations. Example triggers: 'write a research paper on quantum-safe cryptography', 'erstelle ein Forschungsdossier zum Thema KI-Regulierung', 'produce a cited technical brief', 'verfasse einen quellenbasierten Report', 'research and write up the GDPR compliance overview', 'Forschungsbericht mit Quellennachweisen schreiben'.",
      "task": "When attachments or prior reports are provided, start with document_intake. Use researcher for source discovery — it handles both broad web research and citation-grade official sources. Use evidence_analyst to reconcile findings into a clean evidence ledger, and research_librarian to persist durable notes and graph links when the evidence base is large. For short briefs, use summarizer to produce the final deliverable. For full papers or reports, draft only from collected evidence with paper_author. Use source_verifier only to validate citations or claim-level gaps. Run exactly one final quality pass with quality_supervisor before finalizing. Do not create an ephemeral writer and do not rerun the whole pipeline after a viable draft already exists unless the quality pass names one smallest corrective action. Do not delegate to mission_coordinator from this scene — the research pipeline is already defined here.",
      "allowedAgents": [
        "document_intake",
        "evidence_analyst",
        "research_librarian",
        "paper_author",
        "source_verifier",
        "researcher",
        "summarizer",
        "qa_guard",
        "quality_supervisor"
      ],
      "params": {
        "outputStyle": {
          "description": "Requested style or citation format",
          "default": "technical report with inline references"
        },
        "audience": {
          "description": "Intended audience",
          "default": "technical stakeholder"
        },
        "freshnessRequirement": {
          "description": "How fresh the evidence needs to be",
          "default": "use the freshest reliable sources available and call out publication dates"
        }
      }
    },
    "deep_research": {
      "description": "Run a multi-phase deep-research mission with evidence indexing, optional Mermaid visuals, and a final quality gate. Example triggers: 'conduct deep research on the battery supply chain', 'führe eine Tiefenrecherche zum Thema Energiewende durch', 'do a thorough investigation into this topic', 'umfassende Recherche mit Visualisierungen erstellen', 'full research dossier with evidence and timeline', 'Deep-Dive Recherche mit Qualitätsprüfung'.",
      "task": "Use mission_coordinator to partition the work into the smallest viable specialist graph. Use researcher for all source collection — it handles both broad web research and citation-grade official sources in a single agent. Use research_librarian to persist notes, graph links, and timelines. Use evidence_analyst to reconcile the ledger. Use data_analyst only when structured numbers matter. Use chart_designer for HTML charts or tables based on verified numeric evidence. Use diagram_designer when a structural visual model would clarify the answer. Use paper_author for the final deliverable when a full paper is requested, or summarizer for a short brief. Use quality_supervisor to decide whether one targeted corrective pass is justified before finalizing. IMPORTANT: mission_coordinator must NOT call search_workflows or run_workflow from inside this scene — the research pipeline is already defined. Delegate directly to the named specialists.",
      "allowedAgents": [
        "mission_coordinator",
        "researcher",
        "research_librarian",
        "document_intake",
        "evidence_analyst",
        "data_analyst",
        "chart_designer",
        "diagram_designer",
        "paper_author",
        "summarizer",
        "quality_supervisor"
      ],
      "params": {
        "deliverable": {
          "description": "Requested final deliverable type",
          "default": "source-backed research dossier with explicit gaps and next actions"
        },
        "includeVisuals": {
          "description": "Whether Mermaid diagrams should be produced when they materially help",
          "default": "yes when a workflow, relationship map, architecture, or timeline would improve clarity"
        },
        "freshnessRequirement": {
          "description": "How recent the evidence must be",
          "default": "prefer the freshest reliable sources and preserve publication dates"
        },
        "audience": {
          "description": "Intended audience",
          "default": "technical stakeholder"
        },
        "visualFocus": {
          "description": "Preferred visual structure if one is appropriate",
          "default": "workflow, timeline, or relationship map depending on the evidence"
        }
      }
    },
    "meeting_briefing_packet": {
      "description": "Produce a concise meeting brief or handoff packet from attached material, prior findings, and project context. Example triggers: 'prepare a briefing for tomorrow's stakeholder meeting', 'erstelle ein Briefing für das Meeting mit dem Kunden', 'put together a handoff packet for the new PM', 'Übergabepaket für das Projektteam vorbereiten', 'summarize these notes into a meeting brief', 'Meeting-Brief mit Aktionspunkten und Risiken'.",
      "task": "Use document_intake first when source material includes files or long notes, data_analyst for tabular attachments, evidence_analyst to reconcile the evidence ledger, policy_compliance_reviewer when approvals or constraints matter, and meeting_briefing_agent to produce the final brief or handoff packet. Use qa_guard when the packet needs an explicit verification pass.",
      "allowedAgents": [
        "document_intake",
        "data_analyst",
        "evidence_analyst",
        "policy_compliance_reviewer",
        "meeting_briefing_agent",
        "summarizer",
        "qa_guard"
      ],
      "params": {
        "audience": {
          "description": "Target audience for the packet",
          "default": "project stakeholders"
        },
        "outputFormat": {
          "description": "Preferred delivery format",
          "default": "markdown brief with actions, decisions, and open risks"
        }
      }
    },
    "code_review": {
      "description": "Git-based code review workflow: inspect changes, analyze quality, and produce a structured review report. Example triggers: 'review the latest commits on this branch', 'führe ein Code-Review der letzten Änderungen durch', 'analyze the diff for quality issues', 'prüfe den Pull Request auf Probleme', 'review HEAD~3..HEAD for bugs', 'Code-Review mit strukturiertem Bericht'.",
      "task": "Use git_developer to inspect the current diff and recent commits, code_analyst to review code quality and identify issues, qa_guard to verify the findings, and summarizer to produce the final review report. When a target branch or commit range is specified, use git_diff with the appropriate ref parameter.",
      "allowedAgents": [
        "git_developer",
        "code_analyst",
        "qa_guard",
        "summarizer"
      ],
      "params": {
        "targetRef": {
          "description": "Git ref, branch, or commit range to review",
          "default": "HEAD~5..HEAD"
        },
        "focusAreas": {
          "description": "Specific areas to focus on (security, performance, style, logic)",
          "default": "all"
        }
      }
    },
    "api_test_suite": {
      "description": "Test and validate API endpoints with structured request/response analysis and documentation. Example triggers: 'test the REST API endpoints of this service', 'teste die API-Endpunkte gegen die Spezifikation', 'validate the response schemas for /users and /orders', 'API-Test-Report für den neuen Service erstellen', 'run a smoke test suite against the staging API', 'API-Endpunkte systematisch prüfen'.",
      "task": "Use api_integrator to execute HTTP requests against the target API, researcher to gather API documentation if needed, code_analyst to review response schemas, and qa_guard to validate the test results. Produce a structured test report with pass/fail status, response details, and identified issues.",
      "allowedAgents": [
        "api_integrator",
        "researcher",
        "code_analyst",
        "qa_guard",
        "summarizer"
      ],
      "params": {
        "baseUrl": {
          "description": "Base URL of the API to test",
          "default": ""
        },
        "authMethod": {
          "description": "Authentication method (bearer, api-key, basic, none)",
          "default": "none"
        }
      }
    },
    "multi_channel_broadcast": {
      "description": "Draft and send a coordinated message across multiple communication channels with platform-appropriate formatting. Example triggers: 'announce the release on Slack, Discord, and email', 'verkünde die Wartung auf allen Kanälen', 'broadcast the incident status to the team channels', 'Nachricht an Telegram, Slack und E-Mail senden', 'coordinated announcement across Telegram and email', 'Multi-Channel-Nachricht mit angepasstem Format'.",
      "task": "Use summarizer or paper_author to draft the core message based on the user's input and any shared evidence, then notification_agent to send platform-adapted versions to the requested channels. Use qa_guard to review the draft before sending when accuracy is critical.",
      "allowedAgents": [
        "notification_agent",
        "summarizer",
        "paper_author",
        "qa_guard"
      ],
      "params": {
        "channels": {
          "description": "Comma-separated list of target channels (telegram, slack, discord, email)",
          "default": "telegram"
        },
        "tone": {
          "description": "Message tone (formal, casual, urgent, informational)",
          "default": "informational"
        }
      }
    },
    "security_audit": {
      "description": "Research CVEs and security advisories for a specified stack or codebase, run static code analysis on high-risk paths, apply a compliance check, and produce a prioritised risk report. Example triggers: 'run a security audit on our Node.js dependencies', 'Sicherheits-Audit für das Docker-Deployment durchführen', 'check the code for security issues and CVE exposure', 'Sicherheitsüberprüfung mit CVE-Recherche und Compliance-Check', 'audit this repo for vulnerabilities', 'erstelle einen Sicherheitsbericht mit Risikotabelle'.",
      "task": "Use researcher to gather current CVE data, vendor advisories, and upstream security announcements for {{target}} at or above {{severityThreshold}}. Use code_analyst for static review of authentication, input handling, crypto, serialisation, and dependency-exposed code paths when the audit scope includes the source tree. Use policy_compliance_reviewer to map findings against the configured compliance requirements. Use evidence_analyst to reconcile CVE data with the code analysis into a single evidence ledger keyed by CVE id and affected file or dependency. Use summarizer to produce the final {{outputFormat}} with an ordered risk table (severity, CVE/finding, affected component, remediation, owner). Run one quality_supervisor pass before finalising. Do not attempt to patch vulnerabilities from this scene — the deliverable is the report; remediation is a separate task.",
      "allowedAgents": [
        "researcher",
        "research_librarian",
        "code_analyst",
        "policy_compliance_reviewer",
        "evidence_analyst",
        "summarizer",
        "qa_guard",
        "quality_supervisor"
      ],
      "params": {
        "target": {
          "description": "Software stack, repository path, service, or dependency set to audit",
          "default": "configured stack and npm dependencies"
        },
        "auditScope": {
          "description": "What to cover: dependencies, code, infrastructure, all",
          "default": "dependencies"
        },
        "severityThreshold": {
          "description": "Minimum CVSS severity to include (low, medium, high, critical)",
          "default": "medium"
        },
        "outputFormat": {
          "description": "Final report format",
          "default": "markdown with risk table and remediation plan"
        }
      }
    },
    "release_notes_draft": {
      "description": "Generate release notes from git history and diff analysis for a given ref range, formatted per Keep-a-Changelog conventions and tailored to the stated audience. Example triggers: 'draft release notes for v2.3', 'Release Notes für den letzten Sprint erstellen', 'summarise the commits between HEAD~20 and HEAD', 'Versionshinweise aus Git-Log generieren', 'produce changelog entries for the upcoming release', 'technische Release-Notizen mit Breaking Changes'.",
      "task": "Use git_developer to collect commits and diffs in {{targetRef}} and classify them into Added / Changed / Fixed / Removed / Security / Deprecated buckets (Keep-a-Changelog). Use code_analyst to flag breaking changes, migration-relevant diffs, and high-impact behaviour changes that the commit message alone may understate. Use paper_author to draft the notes for {{audience}} as grouped bullets with short, outcome-oriented phrasing — no commit hashes or author names unless the audience is `technical`. Use qa_guard to verify that no listed item contradicts the actual diff. Use summarizer to produce the final Keep-a-Changelog section headed by `## [{{version}}] — <ISO date>`. Do not invent changes not visible in the diff.",
      "allowedAgents": [
        "git_developer",
        "code_analyst",
        "paper_author",
        "summarizer",
        "qa_guard"
      ],
      "params": {
        "version": {
          "description": "Release version label (e.g. v2.3, 0.7.0-rc1)",
          "default": "next"
        },
        "targetRef": {
          "description": "Git ref range to generate notes from",
          "default": "HEAD~20..HEAD"
        },
        "audience": {
          "description": "Intended audience: internal, public, technical",
          "default": "internal team"
        },
        "broadcast": {
          "description": "Whether to hand the notes to a broadcast step afterwards (yes/no)",
          "default": "no"
        }
      }
    },
    "incident_response": {
      "description": "Triage a live or recent production incident, gather diagnostic evidence from logs and services, identify root cause, guide or apply remediation, and capture findings for a postmortem. Example triggers: 'triage the database outage at 14:00', 'Vorfallsreaktion für den 500er Fehlerausbruch', 'investigate why payments are failing right now', 'Ausfall untersuchen und Ursache finden', 'run incident response on the gateway timeout', 'Incident-Response mit Ursachenanalyse und Behebung'.",
      "task": "Use ops_triage to direct the investigation. Run one or two targeted remote checks with shell_agent (ssh_exec, service_check) to confirm which of {{affectedService}} is failing and how. Use log_analyst to parse relevant logs around the incident window and build a concrete timeline with real timestamps, error codes, and affected requests. Use infrastructure_agent only when a clear, low-risk remediation is identified; for anything beyond service restart or cache flush, surface the proposed action and stop. Use evidence_analyst to consolidate the findings into a structured ledger: what failed, when, why (with quoted log lines), remediation taken (if any), and follow-up actions. Use summarizer to produce a concise status-update suitable for broadcast. Do not replace concrete stderr or log evidence with speculation — if the evidence is only an error phrase, return that exact phrase. Severity hint: {{severity}}.",
      "allowedAgents": [
        "ops_triage",
        "shell_agent",
        "log_analyst",
        "infrastructure_agent",
        "evidence_analyst",
        "summarizer",
        "qa_guard"
      ],
      "params": {
        "incident": {
          "description": "Description of the failure, alert, or symptom",
          "default": "the reported incident"
        },
        "severity": {
          "description": "Incident severity: low, medium, high, critical",
          "default": "high"
        },
        "affectedService": {
          "description": "Service, container, or host showing the failure",
          "default": "discover from logs"
        }
      }
    },
    "competitive_analysis": {
      "description": "Research multiple competitors or comparable products in parallel, reconcile the findings along common dimensions, and produce a competitive intelligence brief with a comparison table and visual summary. Example triggers: 'compare ProductA, ProductB, ProductC on pricing and features', 'Wettbewerbsanalyse für drei SaaS-Produkte', 'run competitive research across these three vendors', 'Vergleichsanalyse mit Tabelle und Differenzierungsmerkmalen', 'competitive snapshot for the payments space', 'Wettbewerbsübersicht mit Visual Brief'.",
      "task": "Use mission_coordinator to partition {{competitors}} into per-competitor research tasks and fan them out in parallel. For each competitor, use researcher to collect public evidence (pricing pages, product docs, case studies, press coverage) and research_librarian to persist notes keyed by competitor. Use evidence_analyst to normalise the findings across {{dimensions}} so every competitor is scored on the same axes. Use data_analyst when any dimension is numeric. Use chart_designer to produce a comparison table (and a differentiator-highlight chart when the numeric evidence is strong enough). Use paper_author or summarizer to write the final {{deliverable}} for {{audience}}, leading with a one-paragraph verdict and the comparison table. Run exactly one quality_supervisor pass before finalising. Do not invent pricing or features that are not backed by a cited source.",
      "allowedAgents": [
        "mission_coordinator",
        "researcher",
        "research_librarian",
        "evidence_analyst",
        "data_analyst",
        "chart_designer",
        "paper_author",
        "summarizer",
        "quality_supervisor",
        "qa_guard"
      ],
      "params": {
        "competitors": {
          "description": "Comma-separated competitor names or products",
          "default": "the competitors named in the user request"
        },
        "dimensions": {
          "description": "Comparison dimensions (e.g. pricing, features, market-position)",
          "default": "pricing, features, market-position"
        },
        "deliverable": {
          "description": "Preferred final deliverable",
          "default": "competitive intelligence brief with comparison table and key differentiators"
        },
        "audience": {
          "description": "Intended audience",
          "default": "product and strategy stakeholders"
        }
      }
    },
    "data_pipeline_review": {
      "description": "Inspect a data source — database, file, or pipeline — for schema quality, null rates, anomalies, and referential integrity; produce a structured data quality report. Example triggers: 'run a data quality check on the orders table', 'Schema-Prüfung für die Kundendatei', 'check null rates and duplicates in the CSV export', 'Datenqualitätsanalyse mit Anomalieerkennung', 'review the pipeline output for integrity issues', 'Datenqualitätsbericht mit Issue-Tabelle'.",
      "task": "Use document_intake when the data source is a file attachment and needs to be read in. Use sql_specialist when the source is a database or table — start by inspecting the schema (columns, types, nullability, keys, indexes) with read-only queries, then run the checks listed in {{validationRules}}: null/empty rates per column, type consistency (bad casts, mixed types), referential integrity (orphaned foreign keys), row-count drift versus prior snapshot if available, duplicate keys, and value distributions (outliers, unexpected enums). Use data_analyst to compute distribution summaries and flag anomalies. Use evidence_analyst to reconcile findings into a single issue ledger: severity, column, rule, sample offending rows (redact PII), recommended action. Use chart_designer when a distribution or trend chart materially helps. Use summarizer to produce the final {{outputFormat}} led by a one-paragraph verdict and an issue table. qa_guard verifies that every issue in the report is traceable to a real query result. Do not perform data mutations from this scene — reporting only.",
      "allowedAgents": [
        "sql_specialist",
        "data_analyst",
        "document_intake",
        "evidence_analyst",
        "chart_designer",
        "summarizer",
        "qa_guard"
      ],
      "params": {
        "dataSource": {
          "description": "File path, database name, table, or description of the data source",
          "default": "attached files or configured database"
        },
        "validationRules": {
          "description": "Comma-separated validation rules to enforce",
          "default": "null rates, type consistency, referential integrity, row-count drift, value distributions, duplicate keys"
        },
        "outputFormat": {
          "description": "Final report format",
          "default": "markdown data quality report with issue table"
        }
      }
    },
    "content_creation": {
      "description": "Research a topic (when needed), produce audience-ready written content in a specified format and tone, and hand off a finished draft ready for review or publication. Example triggers: 'write a blog post about our new feature', 'Blog-Artikel zum neuen Release verfassen', 'draft a product newsletter for this month', 'Content-Entwurf für die Landingpage', 'produce documentation for the new endpoint', 'Fachartikel mit Recherche und Korrekturlesen'.",
      "task": "When {{requiresResearch}} indicates research is needed, use researcher to gather supporting evidence first and research_librarian to persist notes keyed to the topic; use evidence_analyst to reconcile claims before drafting. Use content_writer to produce the {{contentType}} for {{audience}} in a {{tone}} voice — lead with the hook, no marketing filler. Use qa_guard to verify claims against the evidence ledger and flag unsourced statements. Run one quality_supervisor pass for structure, voice, and audience-fit before finalising. Use summarizer only when a short summary or social-post variant of the main piece is requested. Do not publish or broadcast from this scene — the deliverable is the draft itself.",
      "allowedAgents": [
        "content_writer",
        "researcher",
        "research_librarian",
        "evidence_analyst",
        "summarizer",
        "qa_guard",
        "quality_supervisor"
      ],
      "params": {
        "contentType": {
          "description": "blog-post, newsletter, product-copy, documentation, press-release",
          "default": "blog-post"
        },
        "topic": {
          "description": "Topic, angle, or key message for the content",
          "default": "the requested topic"
        },
        "audience": {
          "description": "Intended audience",
          "default": "general technical audience"
        },
        "tone": {
          "description": "Voice and tone (professional, friendly, technical, playful, urgent)",
          "default": "professional and engaging"
        },
        "requiresResearch": {
          "description": "Whether a research pass is required before drafting (yes/no)",
          "default": "yes"
        }
      }
    },
    "onboarding_packet": {
      "description": "Build a structured onboarding packet for a new team member, role, or project — gathering the relevant resources, translating to the target language when needed, and producing a ready-to-share document with a quick-reference table. Example triggers: 'create an onboarding packet for a new backend engineer', 'Einarbeitungsunterlagen für neuen Projektmanager', 'assemble an onboarding document for the StarlingAI platform', 'Onboarding-Paket mit Quick-Reference erstellen', 'put together an intro guide for the new PM', 'Willkommensdokument mit Ressourcenübersicht'.",
      "task": "Use document_intake when existing onboarding material or attachments are provided. Use researcher to fill identifiable gaps (links to docs, tools, access request processes, team rituals, glossary entries) for {{topic}} — do not invent processes that are not actually documented. Use content_writer to assemble the packet for {{audience}}, structured as: Welcome + role context → First-week priorities → Access and accounts checklist → Key contacts → Architecture or product overview → Glossary → Quick-reference table (tool / purpose / link / owner). Use translator to render the final packet in {{outputLanguage}} when it is not English. Use meeting_briefing_agent when the audience expects a first-meeting handoff section with agenda points. Use qa_guard to verify every referenced link and contact against the gathered evidence — do not ship broken references. Produce {{outputFormat}}.",
      "allowedAgents": [
        "document_intake",
        "researcher",
        "research_librarian",
        "content_writer",
        "translator",
        "meeting_briefing_agent",
        "summarizer",
        "qa_guard"
      ],
      "params": {
        "topic": {
          "description": "What the person is being onboarded to (platform, project, role)",
          "default": "the requested onboarding topic"
        },
        "audience": {
          "description": "Who is being onboarded and their background",
          "default": "new team member with intermediate technical background"
        },
        "outputLanguage": {
          "description": "Language for the final packet",
          "default": "English"
        },
        "outputFormat": {
          "description": "Packet format",
          "default": "structured Markdown with sections and a quick-reference table"
        }
      }
    }
  }
}
