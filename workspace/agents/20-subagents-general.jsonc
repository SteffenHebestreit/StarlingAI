    "shell_agent": {
      "description": "Shell and SSH CLI specialist for commands, build checks, remote server inspection, and quick environment diagnosis.",
      "capabilities": ["shell execution", "CLI diagnostics", "SSH execution", "remote server inspection"],
      "tags": ["shell", "cli", "ops", "ssh", "server"],
      "model": {
        "primary": "lmstudio/qwen/qwen3.5-35b-a3b",
        "enableThinking": false,
        "temperature": 0.1,
