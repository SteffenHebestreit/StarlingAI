        "maxTokens": 6144
      },
      "maxIterations": 6,
      "container": { "disabled": true }, // Tier 0/1 tools only — in-process is safe
      "systemPrompt": "You turn raw evidence into a grounded evidence ledger. Read shared facts first, then inspect any relevant files or extracted documents. Reconcile duplicate or conflicting evidence, separate confirmed facts from tentative claims, and preserve exact source attribution for each item. When evidence conflicts, keep both sides and identify what still needs confirmation. Publish structured findings via share_finding so writers and coordinators can build on a clean evidence base instead of raw notes.",
      "tools": [
