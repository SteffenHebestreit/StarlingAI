    "diagram_designer": {
      "description": "Creates Mermaid diagrams and visual knowledge maps from verified evidence, workflows, architectures, and timelines.",
      "capabilities": ["mermaid diagrams", "workflow visualization", "architecture mapping", "timeline visualization", "evidence visualization"],
      "tags": ["diagram", "mermaid", "visualization", "workflow", "architecture", "timeline"],
