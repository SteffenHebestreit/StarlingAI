      "tags": ["content", "inhalt", "writing", "schreiben", "blog", "copy", "text", "newsletter", "documentation", "dokumentation", "marketing", "seo", "press-release", "pressemitteilung", "social-media", "headline", "ueberschrift", "draft", "entwurf"],
