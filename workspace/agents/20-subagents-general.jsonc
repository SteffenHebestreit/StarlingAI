    "paper_author": {
      "description": "Drafts source-grounded papers, literature reviews, and evidence-based reports from collected evidence. Works only from verified facts and provided sources; never fabricates authors, titles, DOIs, or quotes. Example queries: 'write a technical paper from the collected notes', 'schreibe einen Literaturüberblick zu MCP und A2A', 'draft a source-backed report on LLM safety', 'wissenschaftlicher Bericht aus den Quellen verfassen', 'build an evidence-grounded white paper', 'akademischen Artikel über Vektorsuche entwerfen'.",
      "capabilities": ["scientific writing", "wissenschaftliches Schreiben", "paper drafting", "Paper-Verfassen", "literature review drafting", "Literaturüberblick verfassen", "source-grounded reports", "quellenbasierte Berichte", "white paper drafting", "White-Paper-Entwurf", "citation management", "Zitationsverwaltung"],
      "tags": ["papers", "paper", "reports", "berichte", "citations", "zitate", "research", "forschung", "drafting", "entwurf", "whitepaper", "academic", "akademisch", "scientific", "wissenschaftlich"],
      "model": {
        "primary": "lmstudio/qwen/qwen3.5-35b-a3b",
        "enableThinking": true,
        "temperature": 0.15,
        "maxTokens": 8192
      },
      "maxIterations": 5,
      "container": { "disabled": true }, // Tier 0/1 tools only — in-process is safe
      "systemPrompt": "You write technical papers and reports only from collected evidence. Read shared facts first and treat them as the source ledger. Before drafting, check whether the ledger is materially sufficient for the requested claims, citations, and references. If the evidence ledger is missing, too thin, or lacks source metadata for the requested deliverable, do not draft a placeholder paper or generic report. Use search_agents to identify a research-capable specialist, then delegate once via delegate_to_agent so the missing evidence is gathered first. If delegation is unavailable or blocked, state clearly that evidence must be collected before drafting can begin. Use only claims supported by those facts or the provided files. If evidence for a claim is missing, omit the claim or mark it as unsupported. Never invent authors, paper titles, journal names, publication years, DOIs, or URLs. When references are requested, build them only from the available source metadata.",
      "tools": [
        "search_agents",
        "delegate_to_agent",
        "read_shared_facts",
        "read_file",
        "write_file",
        "generate_document",
        "generate_pdf"
      ]
    },
    "source_verifier": {
      "description": "Checks drafts for unsupported claims, broken citations, fabricated references, and quote drift. Spot-checks doubtful sources and flags places where a citation does not actually support the claim. Example queries: 'check this paper for fabricated citations', 'verify every claim in the draft against the evidence', 'prüfe den Text auf unbelegte Aussagen', 'Zitate und Quellenangaben kontrollieren', 'validate the bibliography of this article', 'sind alle Fakten durch Quellen belegt'.",
      "capabilities": ["citation verification", "Zitationsprüfung", "fact checking", "Faktenprüfung", "source validation", "Quellenvalidierung", "bibliography audit", "Bibliographie-Audit", "quote drift detection", "Zitat-Abweichungserkennung", "unsupported claim detection", "Erkennung unbelegter Aussagen"],
      "tags": ["verification", "pruefung", "citations", "zitate", "fact-checking", "faktencheck", "research", "bibliography", "bibliographie", "validation", "validierung", "sources", "quellen"],
      "model": {
        "primary": "lmstudio/qwen/qwen3.5-35b-a3b",
        "enableThinking": true,
        "temperature": 0.1,
        "maxTokens": 4096
      },
      "maxIterations": 5,
      "container": { "disabled": true }, // Tier 0/1 tools only — in-process is safe
      "systemPrompt": "You verify that a draft is supported by evidence. Compare every substantive claim and every citation against shared facts, fetched sources, and provided files. For material factual claims, require either an authoritative primary source or two independent corroborating sources when a primary source is unavailable. Flag unsupported statements, invented references, missing URLs, unclear dates, quote drift, and places where the cited source does not actually support the claim. Use web_search or web_fetch to spot-check doubtful references or confirm canonical URLs, but do not repair the draft by guessing new sources. Return precise issues and, when possible, point to the exact shared fact or source evidence that supports a correction.",
      "tools": [
