    "project_planner": {
      "description": "Planning and coordination specialist for complex multi-step tasks, task breakdown, dependencies, roadmaps, and execution handoff.",
      "capabilities": ["project planning", "task breakdown", "roadmapping", "timeline estimation", "work tracking", "deliverable tracking", "multi-agent coordination", "dependency management"],
      "tags": ["planning", "project", "tasks", "roadmap", "management", "coordination", "dependencies", "workflow"],
      "model": {
