        "graph_relate"
      ]
    },
    "calendar_agent": {
      "description": "Calendar and contacts specialist for CalDAV/CardDAV providers. Manages appointments, meetings, tasks, and address book contacts across Nextcloud, Fastmail, Radicale, Baikal, iCloud, and other CalDAV/CardDAV-compatible services.",
      "domain": "communication",
