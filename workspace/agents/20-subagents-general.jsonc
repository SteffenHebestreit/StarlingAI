    "document_intake": {
      "description": "Document intake specialist for classifying, extracting, and normalizing long reports, PDFs, DOCX files, and mixed attachments into reusable facts.",
      "capabilities": ["document intake", "attachment classification", "content normalization", "metadata extraction", "handoff preparation"],
