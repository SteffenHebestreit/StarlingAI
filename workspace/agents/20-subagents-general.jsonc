        "write_file"
      ]
    },
    "evidence_analyst": {
      "description": "Synthesizes fetched pages, shared facts, files, and visual evidence into a grounded evidence ledger. Reconciles conflicting sources, separates confirmed facts from tentative claims, and preserves exact source attribution. Example queries: 'build an evidence ledger from the shared facts', 'reconcile the conflicting revenue numbers from the reports', 'Evidenz aus den Quellen zusammenführen', 'widersprüchliche Angaben aus Datei A und B abgleichen', 'ground these claims against the source documents'.",
      "capabilities": ["evidence synthesis", "Evidenz-Synthese", "cross-source reconciliation", "Quellenabgleich", "document grounding", "Dokumentengrundlage", "research handoff", "Forschungsübergabe", "claim verification", "Aussagenprüfung", "conflict detection", "Konflikterkennung"],
      "tags": ["evidence", "evidenz", "analysis", "analyse", "research", "forschung", "grounding", "reconciliation", "abgleich", "verification", "pruefung", "ledger"],
      "model": {
        "primary": "lmstudio/qwen/qwen3.5-35b-a3b",
        "enableThinking": true,
        "temperature": 0.1,
        "maxTokens": 6144
      },
      "maxIterations": 6,
      "container": { "disabled": true }, // Tier 0/1 tools only — in-process is safe
      "systemPrompt": "You turn raw evidence into a grounded evidence ledger. Read shared facts first, then inspect any relevant files or extracted documents. Reconcile duplicate or conflicting evidence, separate confirmed facts from tentative claims, and preserve exact source attribution for each item. When evidence conflicts, keep both sides and identify what still needs confirmation. Publish structured findings via share_finding so writers and coordinators can build on a clean evidence base instead of raw notes.",
      "tools": [
        "read_shared_facts",
        "read_file",
        "list_files",
        "extract_file_content",
        "analyze_image",
        "share_finding",
        "write_file"
      ]
    },
    "data_analyst": {
      "description": "Analyzes structured data such as CSV, JSON, spreadsheets, metrics snapshots, and exported reports. Computes aggregations, trends, summaries, and anomalies from tabular evidence while preserving exact values, units, and caveats. Example queries: 'compute monthly revenue from this CSV', 'summarize the metrics in this JSON export', 'analysiere die Verkaufszahlen aus der Excel-Tabelle', 'welche Auffälligkeiten zeigen die KPIs', 'group this dataset by region and compute average', 'Trendanalyse der letzten 6 Monate', 'read CSV and compute averages by category'.",
