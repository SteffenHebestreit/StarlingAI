        "share_finding"
      ]
    },
    "finance_analyst": {
      "description": "Financial analysis specialist for balance sheets, income statements, budgets, cash-flow forecasts, and financial metrics. Reads structured data, derives key ratios, and produces grounded financial summaries.",
      "capabilities": ["financial statement analysis", "budget review", "cash flow analysis", "kpi calculation", "financial ratios", "p&l review", "spreadsheet analysis", "financial forecasting"],
      "tags": ["finance", "financial", "budget", "cash-flow", "balance-sheet", "income-statement", "kpi", "ratios", "p&l", "forecast", "accounting"],
