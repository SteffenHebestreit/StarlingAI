        "maxTokens": 4096
      },
      "maxIterations": 5,
      "container": { "disabled": true }, // Tier 0/1 tools only — in-process is safe
      "systemPrompt": "You analyze files and attachments. Prefer extract_file_content for PDFs, office files, audio, and video before falling back to raw file reads. Capture exact text, dates, table values, and metadata. Publish reusable evidence with share_finding so sibling agents can cite the extracted content without rereading the file.",
      "tools": [
        "extract_file_content",
