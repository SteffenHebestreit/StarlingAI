      ]
    },
    "quality_supervisor": {
      "description": "Quality gate specialist that checks whether a draft or merged response actually met the requirements and whether one more targeted pass is justified. Example queries: 'review the drafted report against the original brief', 'prüfe ob der Entwurf die Anforderungen erfüllt', 'is this answer complete or should we rerun?', 'Abnahmeprüfung für das erstellte Dokument', 'identify any gaps before we ship', 'Qualitätsgate vor Auslieferung durchführen'.",
      "capabilities": ["quality assurance", "Qualitaetssicherung", "acceptance criteria review", "Akzeptanzkriterienpruefung", "gap analysis", "Luckenanalyse", "verification", "Verifikation", "rerun gating", "Wiederholungsentscheidung", "completeness check", "Vollstaendigkeitspruefung", "grounding verification", "Begruendungspruefung"],
      "tags": ["quality", "qualitaet", "qa", "review", "pruefung", "acceptance", "akzeptanz", "verification", "verifikation", "gaps", "luecken", "completeness", "vollstaendigkeit", "gate", "abnahme"],
      "model": {
        "primary": "lmstudio/qwen/qwen3.5-35b-a3b",
        "enableThinking": true,
        "temperature": 0.1,
        "maxTokens": 6144
      },
      "maxIterations": 6,
      "container": { "disabled": true }, // Tier 0/1 read-only tools — in-process is safe
      "systemPrompt": "You are a strict quality supervisor. Evaluate the provided draft, artifact, or merged specialist result against the original request and any explicit acceptance criteria. Do not rewrite the whole answer unless explicitly asked. First restate the acceptance criteria concisely. Then judge completeness, factual grounding, source sufficiency, internal consistency, and whether the result answered the actual ask. Use any artifact paths or filenames present in shared facts, partial results, or task context before guessing filenames. If a generated artifact path is missing or unreadable, report that exact blocker and recommend only the smallest corrective action needed to inspect the existing artifact. Do not recommend new research or fresh evidence gathering when the failure is missing review input rather than missing evidence. Approve only when the answer is materially complete and grounded. If the result fails, recommend at most one smallest corrective action and the best next specialist to run. Do not request open-ended retries or vague 'improve more' loops. Publish the verdict, blocking issues, and rerun decision via share_finding.",
      "tools": [
        "read_file",
        "workspace_search",
        "read_shared_facts",
        "share_finding"
      ]
    },
