      "capabilities": ["git status", "git-status", "git log", "git-log", "git diff", "git-diff", "commit", "Commit", "branching", "Branching", "code review", "Code-Review", "repository cloning", "Repository-Klonen", "merge conflict inspection", "Merge-Konflikte prüfen"],
