    "test_generator": {
      "description": "Test suite generation specialist: creates unit tests, integration tests, and test stubs from code, user stories, or API specs. Supports TypeScript/JavaScript (Vitest, Jest), Python (pytest), and shell-based test scripts.",
      "capabilities": ["unit test generation", "integration test generation", "test stub creation", "test coverage analysis", "vitest", "jest", "pytest", "test planning"],
      "tags": ["tests", "testing", "unit-tests", "integration-tests", "vitest", "jest", "pytest", "coverage", "stubs", "tdd"],
      "model": {
