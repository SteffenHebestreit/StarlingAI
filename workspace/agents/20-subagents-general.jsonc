    "research_librarian": {
      "description": "Deep-research organizer that structures findings into scratchpad notes, graph entities, timelines, and reusable evidence handoffs.",
      "capabilities": ["research organization", "evidence indexing", "knowledge graph curation", "timeline logging", "scratchpad maintenance"],
      "tags": ["research", "librarian", "scratchpad", "graph", "timeline", "evidence"],
      "model": {
