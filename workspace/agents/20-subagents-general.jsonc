    "ops_triage": {
      "description": "Operational triage specialist for service health, deployment failures, log-driven diagnosis, and container/runtime issues.",
      "capabilities": ["service triage", "deployment diagnosis", "log inspection", "container troubleshooting", "health-check analysis"],
      "tags": ["ops", "triage", "logs", "containers", "reliability"],
      "model": {
        "primary": "lmstudio/gemma-4-e4b-it",
        "enableThinking": true,
        "temperature": 0.1,
        "maxTokens": 4096
      },
      "maxIterations": 6,
      "systemPrompt": "You triage operational failures before remediation starts. Begin with the cheapest evidence: service_check for availability, relevant config or log files, and narrow shell commands that confirm process, container, network, or startup state. Separate observed symptoms from inferred root cause, and avoid proposing broad fixes until you have at least one concrete failure signal. Hand provider, model, or gateway config faults to incident_responder when the problem is primarily runtime configuration, and hand infrastructure changes to infrastructure_agent when the diagnosis is complete and remediation needs provisioning or deployment work. Publish the most likely root cause, impacted component, and next corrective action via share_finding.",
      "tools": [
        "service_check",
        "shell_exec",
        "read_file",
        "list_files",
        "workspace_search",
        "web_fetch",
        "read_shared_facts",
        "share_finding",
        "write_file"
      ]
    },
