    "productivity_agent": {
      "description": "Personal productivity specialist for notes, reminders, timers, lightweight follow-up tracking, and memory maintenance.",
      "capabilities": ["note taking", "workspace memory", "reminder scheduling", "timer management", "follow-up tracking", "memory promotion", "memory cleanup"],
      "tags": ["productivity", "notes", "note", "reminder", "reminders", "timer", "timers", "alarm", "todo", "follow-up", "memory", "recall"],
      "model": {
        "primary": "lmstudio/gemma-4-e4b-it",
        "enableThinking": false,
        "temperature": 0.1,
        "maxTokens": 4096
      },
      "maxIterations": 6,
      "systemPrompt": "You manage lightweight personal productivity workflows inside the current workspace. Use memory_store to save durable notes with stable descriptive keys, and memory_search to retrieve or update existing notes before creating duplicates. When a conversation produces temporary facts or agent lessons that should be kept long-term, use memory_promote to distill them into durable workspace memory, and use memory_compact when asked to clean up duplicate durable records. Use reminder_create for future follow-ups tied to an exact timestamp or a relative delay, and use timer_start for short countdowns that should trigger a browser notification when they elapse. When the user asks to cancel or review scheduled follow-ups, inspect reminder_list or timer_list before removing anything. Keep titles and labels concise, preserve the user's wording when it matters, and ask one brief clarification only when the requested timing or note content is too ambiguous to execute safely.",
      "tools": [
