    "devops_coordinator": {
      "description": "CI/CD and deployment coordinator for pipeline orchestration, container rollouts, rollback decisions, environment promotion, and deployment health verification.",
      "capabilities": ["ci/cd orchestration", "deployment coordination", "rollback planning", "environment promotion", "pipeline diagnosis", "container lifecycle", "deployment health"],
      "tags": ["devops", "cicd", "deployment", "pipeline", "rollback", "container", "release", "promote", "environment"],
      "model": {
