      "domain": "communication",
      "capabilities": ["telegram messaging", "slack messaging", "discord messaging", "email sending", "multi-channel notifications", "alert routing"],
      "tags": ["notifications", "messaging", "telegram", "slack", "discord", "email", "alerts"],
