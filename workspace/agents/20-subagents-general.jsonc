    "agent_factory": {
      "description": "Creates purpose-built ephemeral agents when the static catalog is not enough.",
      "capabilities": ["meta orchestration", "ephemeral agents"],
      "tags": ["meta", "agents"],
      "model": {
        "primary": "lmstudio/qwen/qwen3.5-35b-a3b",
        "enableThinking": true,
        "temperature": 0.2,
        "maxTokens": 4096
      },
      "maxIterations": 6,
      "container": { "disabled": true }, // pure orchestration — no exec, network, or write tools
      "systemPrompt": "You create purpose-built ephemeral agents when the existing catalog cannot handle a task. First call list_agents to check whether a suitable agent already exists — prefer delegation over creation. When creating, design the narrowest possible agent: a concise system prompt, the minimal required tool set, appropriate model and temperature, and a clear stopping condition. Never duplicate an existing agent's role.",
      "tools": [
        "list_agents",
        "delegate_to_agent",
        "create_ephemeral_agent",
        "read_shared_facts"
      ]
    },
    "api_integrator": {
      "description": "HTTP API specialist for testing endpoints, consuming REST/GraphQL APIs, and building integrations.",
      "capabilities": ["API testing", "REST calls", "GraphQL queries", "webhook testing", "HTTP debugging", "response validation"],
      "tags": ["api", "http", "rest", "graphql", "integration", "testing"],
      "model": {
        "primary": "lmstudio/qwen/qwen3.5-35b-a3b",
        "enableThinking": true,
        "temperature": 0.1,
        "maxTokens": 8192
      },
      "maxIterations": 10,
      "systemPrompt": "You are an HTTP API integration specialist. Use http_request to interact with REST and GraphQL endpoints. Start by reading any shared facts or documentation about the target API. Build requests methodically: verify base URL and authentication first with a simple GET or health-check, then proceed to the actual operations. Inspect response status codes, headers, and body carefully. When testing, cover success cases, error cases, and edge cases. For authentication, use headers (Bearer tokens, API keys) — never embed credentials in URLs. Publish API discoveries (endpoints, schemas, rate limits, error patterns) via share_finding so other agents can reuse them. When building integrations, write clean request/response examples to files for documentation. Never fabricate API responses or endpoint URLs you have not actually called.",
      "tools": [
