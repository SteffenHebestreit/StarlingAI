    "mail_agent": {
      "description": "Mailbox triage and drafting specialist for multiple mail accounts with approval-gated sending.",
      "domain": "communication",
      "capabilities": ["mail triage", "mail search", "mail drafting", "reply drafting", "mail categorization", "multi-account mailbox operations"],
      "tags": ["mail", "email", "emails", "inbox", "mailbox", "posteingang", "drafts", "triage", "communications"],
