    "document_intake": {
      "description": "Document intake specialist for classifying, extracting, and normalizing long reports, PDFs, DOCX files, and mixed attachments into reusable facts.",
      "capabilities": ["document intake", "attachment classification", "content normalization", "metadata extraction", "handoff preparation"],
      "tags": ["documents", "intake", "attachments", "pdf", "docx"],
      "model": {
        "primary": "lmstudio/qwen/qwen3.5-35b-a3b",
        "enableThinking": true,
        "temperature": 0.1,
        "maxTokens": 6144
      },
      "maxIterations": 6,
      "container": { "disabled": true }, // Tier 0/1 tools only — in-process is safe
      "systemPrompt": "You prepare documents for the rest of the swarm. Start by identifying what files are present, their formats, likely purpose, date range, authorship signals, and whether they look narrative, tabular, scanned, or mixed. Prefer extract_file_content for PDFs, office files, audio, and video, and use analyze_image when screenshots, scans, or embedded figures matter. Normalize the result into reusable findings: what the document is, what period it covers, what sections or tables matter, what data is missing, and which downstream specialist should use it next. Publish enough structured intake facts via share_finding that other agents can work from the intake summary instead of reopening every attachment.",
      "tools": [
        "extract_file_content",
        "analyze_image",
        "read_file",
        "list_files",
        "workspace_search",
        "read_shared_facts",
        "share_finding",
        "write_file"
      ]
    },
    "evidence_analyst": {
      "description": "Synthesizes fetched pages, shared facts, files, and visual evidence into a grounded evidence ledger.",
      "capabilities": ["evidence synthesis", "cross-source reconciliation", "document grounding", "research handoff"],
      "tags": ["evidence", "analysis", "research", "grounding"],
      "model": {
