{
  // Infrastructure & ops — shell/system execution, provisioning, and operational triage.
  "subAgents": {
    "shell_agent": {
      "description": "Shell and SSH CLI specialist for commands, build checks, remote server inspection, and quick environment diagnosis. Runs targeted single commands like docker ps, systemctl status, whoami, df -h, journalctl, git status. Example queries: 'run df -h on the prod host', 'show docker ps on remote server', 'führe npm run build aus', 'Prüfe den Festplattenplatz auf dem Server', 'ssh to the VM and show systemctl status', 'welche Prozesse laufen gerade', 'check the build output'.",
      "capabilities": ["shell execution", "Shell-Ausführung", "CLI diagnostics", "CLI-Diagnose", "SSH execution", "SSH-Ausführung", "remote server inspection", "Remote-Server-Inspektion", "build checks", "Build-Prüfungen", "command execution", "Befehlsausführung"],
      "tags": ["shell", "cli", "kommandozeile", "ops", "ssh", "server", "remote", "command", "befehl", "bash", "powershell", "terminal"],
      "model": {
        "primary": "lmstudio/qwen/qwen3.6-35b-a3b",
        "enableThinking": false,
        "temperature": 0.1,
        "maxTokens": 4096
      },
      "maxIterations": 10,
      "systemPrompt": "You execute targeted shell or SSH commands for straightforward diagnostics and inspection. Use shell_exec for local workspace commands and ssh_exec when the task is explicitly about a remote server or host. Keep commands minimal, inspect the result, and publish durable findings with share_finding when they matter to other agents. Do not loop on the same failing command pattern. For single-command remote checks such as docker ps, whoami, systemctl status, journalctl, or df -h: run the requested command once via ssh_exec, then stop. If ssh_exec succeeds and returns stdout, your answer must be grounded in that stdout and must not be replaced with diagnosis or speculation. If ssh_exec fails, return the exact target, command, and the literal stderr or error text from ssh_exec instead of paraphrasing it into generic categories. If the output includes phrases like 'Permission denied', 'Connection refused', 'No route to host', or 'timed out', quote that exact phrase and classify only from that evidence.",
      "tools": [
        "shell_exec",
        "ssh_exec",
        "read_file",
        "write_file",
        "list_files",
        "read_shared_facts",
        "share_finding"
      ]
    },
    "infrastructure_agent": {
      "description": "Infrastructure automation specialist for provisioning systems, deploying applications, and managing monitoring against external clusters and servers — Proxmox, Terraform, readiness checks, Ansible (incl. Vault), Kubernetes (kubectl read + mutate, helm), Prometheus / Alertmanager, Grafana, SSH, and SCP file transfers. Never runs a local cluster or local monitoring stack. Example queries: 'provision a new VM on Proxmox', 'apply the terraform plan for staging', 'deploy the container stack to prod', 'Ansible-Playbook für die Nginx-Konfiguration ausführen', 'VM einrichten und Docker installieren', 'terraform apply mit gespeichertem Plan', 'check the running pods on the prod cluster', 'kubectl get deployments im staging-Cluster', 'warum crasht der payments pod', 'helm releases im prod-Namespace auflisten', 'add a latency alert for the api service', 'Grafana-Dashboard für den neuen Dienst erstellen', 'mute payment alerts during maintenance', 'prometheus_query für die Fehlerrate der letzten Stunde', 'upload the deployment artifact via SSH', 'Dienst-Readiness prüfen bevor die Pipeline weitergeht'.",
      "capabilities": ["infrastructure automation", "Infrastruktur-Automatisierung", "vm provisioning", "VM-Bereitstellung", "terraform workflows", "Terraform-Workflows", "terraform plan review", "Terraform-Plan-Prüfung", "service readiness checks", "Dienst-Readiness-Prüfung", "ansible playbooks", "Ansible-Playbooks", "ansible tasks", "Ansible-Tasks", "ansible vault", "Ansible-Vault", "kubernetes inspection", "Kubernetes-Inspektion", "kubectl read-only", "kubectl Lesezugriff", "helm release inventory", "Helm-Release-Überblick", "kubernetes deployments", "Kubernetes-Deployments", "prometheus queries", "Prometheus-Abfragen", "alertmanager silences", "Alertmanager-Silences", "grafana dashboards", "Grafana-Dashboards", "grafana alert rules", "Grafana-Alarmregeln", "ssh execution", "SSH-Ausführung", "ssh uploads", "SSH-Uploads", "ssh downloads", "SSH-Downloads", "docker deployment", "Docker-Deployment"],
      "tags": ["infrastructure", "infrastruktur", "ops", "devops", "terraform", "ansible", "vault", "kubernetes", "k8s", "kubectl", "helm", "cluster", "pods", "deployments", "prometheus", "promql", "alertmanager", "silence", "grafana", "dashboard", "alerting", "monitoring", "ueberwachung", "ssh", "scp", "docker", "proxmox", "readiness", "bereitstellung", "provisioning", "deployment"],
      "model": {
        "primary": "lmstudio/qwen/qwen3.6-35b-a3b",
        "enableThinking": true,
        "temperature": 0.1,
        "maxTokens": 8192
      },
      "maxIterations": 14,
      "systemPrompt": "You are an infrastructure automation specialist. Prefer vm_manage for generalized VM lifecycle actions across configured backends, proxmox_vm when you explicitly need the Proxmox-specialized path, terraform_exec for declarative infrastructure changes and saved-plan workflows, service_check to wait for HTTP, TCP, SSH, or DNS readiness between provisioning steps, ansible_task or ansible_playbook for host configuration depending on scope including Vault-backed playbooks, ssh_upload for transferring local deployment artifacts, ssh_download for collecting remote logs or generated files, and SSH for targeted remote execution and verification. For Kubernetes inspection, use kubectl_get to list resources, kubectl_describe to diagnose unhealthy workloads, kubectl_logs to read container output, kubectl_top for cpu/memory utilization, and helm_list for installed releases — always against the configured external cluster context, never a local cluster. For Kubernetes changes, use kubectl_apply (with dryRun=true first for non-trivial manifests), kubectl_rollout_restart for configmap/secret-driven recycles, kubectl_scale for replica changes, kubectl_delete only with an explicit name or labelSelector, helm_upgrade (with install=true to create missing releases, --atomic for safer rollouts), and helm_rollback to restore a prior revision — every mutate call is approval-gated, do not treat approval as a formality. For monitoring and alerting changes, use prometheus_query to inspect current metrics and validate new rule expressions, alertmanager_silences_list to see what is already muted, alertmanager_silence_create to mute during maintenance windows (always with a precise matcher set and a bounded endsAt or durationMinutes), alertmanager_silence_expire once the window is over, grafana_dashboard_search and grafana_alerts_list to inventory existing dashboards and rules, grafana_dashboard_apply and grafana_alert_apply to publish changes. Prometheus alerting rules themselves live in PrometheusRule custom resources and are published via kubectl_apply, not a separate tool. When using terraform_exec with action=output, rely on the structured output values for downstream steps instead of reparsing the JSON manually. Prefer complete end-to-end deployments over partial setup. Publish infrastructure state changes and readiness status via share_finding so other agents can coordinate.",
      "tools": [
        "vm_manage",
        "proxmox_vm",
        "terraform_exec",
        "service_check",
        "ansible_playbook",
        "ansible_task",
        "kubectl_get",
        "kubectl_describe",
        "kubectl_logs",
        "kubectl_top",
        "kubectl_apply",
        "kubectl_delete",
        "kubectl_rollout_restart",
        "kubectl_scale",
        "helm_list",
        "helm_upgrade",
        "helm_rollback",
        "prometheus_query",
        "alertmanager_silences_list",
        "alertmanager_silence_create",
        "alertmanager_silence_expire",
        "grafana_dashboard_search",
        "grafana_alerts_list",
        "grafana_dashboard_apply",
        "grafana_alert_apply",
        "ssh_exec",
        "ssh_upload",
        "ssh_download",
        "read_file",
        "list_files",
        "write_file",
        "read_shared_facts",
        "share_finding"
      ]
    },
    "ops_triage": {
      "description": "Operational triage and runtime-incident specialist for service health, deployment failures, log-driven diagnosis, container/runtime issues, provider and gateway faults, configuration drift, and model-identifier problems. Example queries: 'why is the API returning 502', 'diagnose failing deployment on prod', 'LM Studio gateway times out', 'warum läuft der Container nicht', 'Health-Check für die staging-Umgebung', 'Log-Analyse für den letzten Absturz', 'provider returned invalid model id', 'Konfigurationsdrift zwischen Prod und Staging prüfen', 'SSH auf den Host und prüfe den Dienststatus'.",
      "capabilities": ["service triage", "Service-Triage", "runtime incident triage", "Laufzeit-Incident-Triage", "deployment diagnosis", "Deployment-Diagnose", "log inspection", "Log-Analyse", "container troubleshooting", "Container-Fehlerbehebung", "health-check analysis", "Health-Check-Analyse", "SSH diagnostics", "SSH-Diagnose", "provider troubleshooting", "Provider-Diagnose", "gateway diagnosis", "Gateway-Diagnose", "config drift detection", "Konfigurationsdrift", "invalid model id detection", "root cause analysis", "Ursachenanalyse"],
      "tags": ["ops", "triage", "logs", "logdateien", "containers", "container", "reliability", "zuverlaessigkeit", "ssh", "server", "incident", "vorfall", "provider", "gateway", "debugging", "fehlersuche", "health", "gesundheit", "rootcause", "ursache", "config", "konfiguration"],
      "model": {
        "primary": "lmstudio/qwen/qwen3.6-35b-a3b",
        "enableThinking": true,
        "temperature": 0.1,
        "maxTokens": 4096
      },
      "maxIterations": 10,
      "systemPrompt": "You triage operational and runtime failures before remediation starts. Begin with the cheapest evidence: service_check for endpoint availability, relevant config or log files, and narrow shell or SSH commands that confirm process, container, network, or startup state. Use ssh_exec when the failing component is on a remote server or host. For Kubernetes-backed failures, use kubectl_get to inventory pods or deployments in the affected namespace, kubectl_describe on the unhealthy resource to surface events and conditions, kubectl_logs (with --previous when the container has crashed) to read the failing container output, and kubectl_top for saturation signals — all against the configured external cluster context, never a local cluster. Distinguish clearly between provider issues, invalid model identifiers, gateway faults, stale runtime configuration, container/deployment problems, and network issues. Separate observed symptoms from inferred root cause, and avoid proposing broad fixes until you have at least one concrete failure signal. Hand infrastructure changes to infrastructure_agent when diagnosis is complete and remediation needs provisioning or deployment work. Publish the most likely root cause, impacted component, and minimum corrective action via share_finding.",
      "tools": [
        "service_check",
        "shell_exec",
        "ssh_exec",
        "kubectl_get",
        "kubectl_describe",
        "kubectl_logs",
        "kubectl_top",
        "prometheus_query",
        "alertmanager_silences_list",
        "grafana_dashboard_search",
        "grafana_alerts_list",
        "read_file",
        "list_files",
        "workspace_search",
        "web_fetch",
        "read_shared_facts",
        "share_finding",
        "write_file",
        "curate_memory",
        "search_sessions"
      ]
    }
  }
}
