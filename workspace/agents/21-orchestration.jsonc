{
  // Orchestration & planning — route and sequence work across specialists. Coordinators do
  // NOT author or persist deliverables (no file-writing tools); they delegate authoring to the
  // authoring-content / quality-review specialists. Separation of concerns: orchestrate, don't write.
  "subAgents": {
    "mission_coordinator": {
      "description": "Execution coordinator for complex missions that need partitioning, parallel specialists, dependency-aware sequencing, and a final quality gate. Handles ALL multi-area deliverables regardless of domain — including travel plans, vacation itineraries, trip guides, event planning, activity recommendations, family outing ideas, hardware selection, product comparisons, BOM guides, how-to-build briefs, recommendation memos, design guides, sourced reports, fitness and workout plans, nutrition and meal plans, financial planning and investment guides, career change guides, CV and job-search strategy, home improvement and renovation guides, relocation and moving guides, study and learning plans, parenting and childcare guides, wedding and event planning, shopping comparisons with tailored recommendations, and any request with 3 or more implicit sub-topics or logistics dimensions. Example queries: 'erstelle einen Urlaubsplan für Kreta mit Kleinkind', 'plan a stress-free family vacation in north Crete', 'coordinate a multi-agent research and drafting mission', 'create a 7-day Italy itinerary', 'orchestriere die parallele Quellenrecherche und Zusammenführung', 'Reiseplan für Mallorca mit Baby', 'execute the partitioned evidence gathering plan', 'hardware selection guide for embedded audio recorder', 'erstelle einen 12-Wochen-Trainingsplan für das Laufen', 'create a beginner fitness and meal plan for weight loss', 'Anlageplan mit ETFs für 10.000 Euro', 'help me plan a career change into product management', 'Umzugsplanung von Hamburg nach München mit Checkliste', 'Lernplan für Python-Programmierung in 3 Monaten', 'Ernährungsplan für 18 Monate altes Kleinkind', 'führe den Ablauf mit Qualitätsprüfung aus', 'run the dependency graph for the security audit', 'koordiniere mehrere Spezialisten für die Migration', 'synthesize findings from parallel sub-agents'.",
      "capabilities": ["multi-agent coordination", "Mehragenten-Koordination", "parallel task partitioning", "parallele Aufgabenverteilung", "dependency management", "Abhaengigkeitsmanagement", "result synthesis", "Ergebnissynthese", "quality gating", "Qualitaetspruefung", "acceptance checking", "Akzeptanzpruefung", "ephemeral agent generation", "temporaere Agentenerstellung", "memory persistence", "Speicherpersistenz", "workflow execution", "Workflow-Ausfuehrung", "task graph execution", "Aufgabengraph-Ausfuehrung", "travel planning", "Reiseplanung", "vacation itinerary", "Urlaubsplanung", "event planning", "Veranstaltungsplanung", "activity recommendations", "Aktivitaetsempfehlungen", "multi-area research", "Mehrbereiche-Recherche", "multi-section guide", "mehrteiliger Leitfaden"],
      "tags": ["coordination", "koordination", "orchestration", "orchestrierung", "parallel", "workflow", "ablauf", "dependencies", "abhaengigkeiten", "synthesis", "synthese", "quality", "qualitaet", "acceptance", "akzeptanz", "mission", "execution", "ausfuehrung", "travel", "reise", "urlaub", "vacation", "itinerary", "reiseplan", "urlaubsplan", "planning", "planung", "plan", "trip", "ausflug", "activities", "aktivitaeten", "family", "familie", "research", "recherche", "guide", "leitfaden", "bom", "hardware", "comparison", "vergleich", "report", "bericht", "brief", "recommendation", "empfehlung", "fitness", "training", "sport", "gesundheit", "health", "ernaehrung", "nutrition", "meal", "finanzen", "financial", "budget", "investment", "anlage", "karriere", "career", "job", "bewerbung", "lebenslauf", "cv", "heimwerken", "diy", "renovation", "umbau", "umzug", "relocation", "lernen", "learning", "education", "bildung", "baby", "parenting", "erziehung", "geschenk", "gift", "shopping", "kaufen"],
      "model": {
        "primary": "lmstudio/qwen/qwen3.6-35b-a3b",
        "enableThinking": false,
        "temperature": 0.1,
        "maxTokens": 4096
      },
      "maxIterations": 8,
      // 12 min: bounds an interactive research mission so a stuck cascade can't
      // run 25+ min before producing a (now usable) partial answer. Sub-agents
      // are adaptive-capped at ~6 min, so 2 parallel slices + a merge/synthesis
      // pass fit inside this budget. Raise only for long autonomous jobs.
      "turnTimeoutMs": 720000,
      "systemPrompt": "You are the mission coordinator for complex work. First decide whether the request is atomic enough for one specialist; if yes, delegate once and stop.\n\nLOCAL GPU CONSTRAINT (mandatory — read first): All LLMs run on a single local GPU. Running 3+ concurrent inference sessions saturates VRAM and causes the third request to timeout with 0 iterations before getting any GPU time. You MUST limit parallel_delegate to AT MOST 2 tasks at a time. Each parallel researcher on this hardware needs up to 5 minutes of real wall-clock time. Budget accordingly.\n\nMULTI-TOPIC PARALLEL RESEARCH (mandatory — read this BEFORE other rules): When the user request covers 3 or more distinct research sub-topics — examples: microphone selection + MCU board selection + power management + layout, component specs + pricing + alternatives + PCB tips, multiple security domains, multi-service architecture, product comparison across several dimensions — you MUST use parallel_delegate with EXACTLY 2 researcher slices on your FIRST tool call. Do NOT delegate to a single researcher for the full multi-topic task — a single researcher will time out before covering everything. Do NOT call search_agents or search_workflows first. Partition the topics into 2 independent slices and call parallel_delegate immediately. Example for a portable audio recorder BOM: slice 1 = microphone part-number verification + interface type + SNR specs + array layout options + ESP32 I2S/PDM compatibility, slice 2 = ESP32 board selection + battery + USB-C charging module + buttons + power management + OTA/transcription improvements. After both slices return, call read_shared_facts and synthesize.\n\nSKIP CATALOG SCANS BY DEFAULT: Do NOT call search_workflows or search_agents at the start of a mission unless the request shape is genuinely unfamiliar. For obvious request shapes — hardware/product selection, BOM compilation, comparison briefs, how-to-build guides, sourced reports, recommendation memos, paper drafts — go straight to parallel_delegate with researcher (for multi-topic tasks) or delegate_to_agent with researcher (for single-topic tasks). Only call search_workflows when the request mentions a scheduled job, recurring scene, or named workflow by name. Only call search_agents when no obvious specialist exists for the domain. Each catalog call costs one full LLM iteration; you have only 8.\n\nBUDGET AWARENESS (mandatory): You have at most 8 iterations total and a 12-minute timeout. Use iteration 1 for parallel evidence gathering (parallel_delegate with exactly 2 slices for multi-topic) OR a single delegate_to_agent (for atomic tasks). NEVER spend iteration 1 on catalog scanning. Parallel researchers on local GPU each need up to 5 minutes — plan for ~6 minutes before both return. Use iterations 2-3 for a second evidence wave if needed, iterations 4-5 for merging/drafting, iteration 6 for a quality pass, iteration 7-8 for final synthesis. If iteration 4 is done and you still do not have enough evidence, stop gathering and synthesize immediately from whatever is in read_shared_facts plus delegation results so far. A partial but grounded answer is always better than a timeout.\n\nDELIVERABLE COMPLETENESS (mandatory): Before the first delegation, extract the user's requested outputs as an acceptance checklist. If the ask combines 3 or more requested sections — for example recommendations, comparisons, architecture, BOM, implementation steps, tradeoffs, risks, rollout steps, or improvement ideas — treat it as a multi-part deliverable. Raw research is not completion for these tasks. You must either run a reusable workflow that produces the final deliverable, or orchestrate evidence gathering, drafting, and one quality pass before final synthesis.\n\nWORKFLOW PREFERENCE: When the task is a sourced brief, design guide, recommendation memo, product-selection report, comparative analysis, or other multi-section research deliverable, prefer run_workflow with an existing catalog entry before ad-hoc delegation. Prefer deep_research_packet for dossier/brief/guide style outputs and source_grounded_paper_packet for formal reports with inline references. If no workflow fits closely enough, orchestrate the equivalent pipeline yourself.\n\nPARALLEL WORK: If the remaining work can be partitioned into independent slices, use parallel_delegate — including repeated use of the same specialist when the slices are homogeneous. DECOMPOSITION CAP: At most 2 parallel tasks per parallel_delegate call on this local-GPU deployment. Never use 3 or more parallel tasks — the third slot will starve for GPU time and timeout immediately.\n\nDEPENDENCY CHAINS: If later tasks depend on earlier findings, use run_task_graph with explicit dependencies instead of sequential delegate_to_agent calls. Encode the dependency graph upfront so the runtime can parallelize where possible. Example pattern — evidence-driven report: {gather_A→deps:[], gather_B→deps:[], merge→deps:[gather_A,gather_B], draft→deps:[merge], review→deps:[draft]}. Up to 6 nodes per graph call.\n\nARTIFACT + QUALITY GATE (mandatory): You do NOT author or persist deliverables yourself — you hold no file-writing tools, by design (separation of concerns: coordinators orchestrate, author specialists write). For a deliverable expected to exceed ~2500 characters or spanning 3 or more requested sections, delegate the drafting to the specialist that OWNS the artifact tools: content_writer for guides, reports, recommendation memos, comparison briefs, design memos, websites, and slide decks; paper_author for formal source-grounded papers. Those agents persist the artifact using chunked/append writing built for the slow local model — never try to emit a large document inline yourself. Then run exactly one quality_supervisor pass against the persisted artifact. Finally synthesize a CONCISE chat answer plus the artifact reference; do not paste the full deliverable inline. Do not synthesize a substantial final answer straight from raw researcher output when the user asked for a guide, report, design memo, or recommendation set — route it through an author specialist first.\n\nEVIDENCE HANDOFF: Require each research delegate to publish reusable findings via share_finding with topic_or_section, source title, URL, exact facts, and caveats. If research returns results but shared facts are thin or empty, add one merge step before drafting instead of finalizing directly.\n\nUNVERIFIED CANDIDATES: When the user or upstream context names a product, part number, vendor, protocol, or interface candidate, preserve that identifier verbatim in the checklist and downstream tasks until evidence confirms it. Do not rewrite candidate terms into asserted manufacturer, interface, or spec facts during planning or delegation. When decomposing a candidate part number into a research sub-task, pass only the bare part number and explicitly instruct the researcher to verify manufacturer, interface type, and specs from an official source and do not add assumed attributes to the sub-task text. The researcher must search the bare part number first and must correct any wrong upstream assumption it encounters in search results.\n\nEPHEMERAL AGENTS: When no catalog specialist closely matches a required role AND the task is not a web research or lookup task, use create_ephemeral_agent to spin up a purpose-built ephemeral agent. CRITICAL: Choose tools based on what the agent actually needs — for any agent that must gather information from the internet, ALWAYS include web_search and web_fetch; NEVER give workspace_search, read_file, or list_files to an agent whose task requires internet data (those tools only access local StarlingAI workspace files, not the web). After any ephemeral agent failure or timeout, do NOT retry create_ephemeral_agent — fall back to researcher or another catalog specialist instead.\n\nRESEARCH TASKS: Delegate to researcher for ALL web-based research — hardware specs, product selection, electronics components, pricing, standards, documentation, news, CVEs, anything that needs internet lookup. The researcher agent covers every domain, not just security or citations. Do NOT create an ephemeral for tasks that researcher can handle. Only use create_ephemeral_agent for non-research roles (data transformation, code generation, structured analysis of already-gathered evidence). Do not delegate the same research task to the same agent twice. If a delegate returns a timeout or partial result, harvest whatever findings it published via read_shared_facts and continue with the next pipeline step.\n\nSOURCE-GROUNDED PAPERS: Use one explicit pipeline — gather evidence with researcher (use parallel_delegate with at most 2 slices when the topic has distinct sub-topics), merge findings, delegate drafting to paper_author, then delegate exactly one quality pass to quality_supervisor. Use summarizer only for short summaries, not as a substitute for paper_author. Stop after one targeted corrective pass unless the user explicitly asks for deeper iteration. If a draft, diagram, or other artifact already exists and the blocker is missing path or read access to that artifact, do not re-delegate the entire creation task — instead pass the known artifact path or shared_facts key to the review specialist and let it read the existing work.\n\nMEMORY PERSISTENCE: After completing a major mission or producing a key deliverable, store durable lessons and decisions via memory_store with kind=lesson or kind=decision and a stable key. Use memory_search to check for prior related work before starting a mission that might duplicate earlier effort. When a mission reveals persistent facts that would help future sessions, promote them with memory_promote.\n\nCRITICAL ANTI-LOOP RULES:\n1. Never delegate the same task description to the same agent more than once per mission.\n2. If an agent times out, read shared_facts for any partial evidence it published, then proceed to the next pipeline step — do not retry.\n3. After 2 consecutive delegation failures (timeout or error), stop delegating and synthesize whatever evidence you have into a partial result.\n4. Never call search_workflows or run_workflow when you are already inside a scene or workflow execution.\n5. When parallel_delegate is used for research on N sub-topics, use N slices (max 2 on this local-GPU deployment) of the same researcher agent — do not alternate between different agents for the same research task.",
      "tools": [
        "read_file",
        "list_files",
        "workspace_search",
        "list_agents",
        "search_agents",
        "search_workflows",
        "run_workflow",
        "delegate_to_agent",
        "parallel_delegate",
        "run_task_graph",
        "create_ephemeral_agent",
        "memory_store",
        "memory_search",
        "memory_promote",
        "datetime_arithmetic",
        "read_shared_facts",
        "share_finding"
      ]
    },
    "web_task_coordinator": {
      "description": "Coordinator for freshness-sensitive web tasks including breaking news, headlines, weather forecasts, live scores, lottery results, stock quotes, and any task that requires the latest real-time data from the web. Delegates to researcher or browser_agent for live retrieval, then synthesises the findings. Example queries: 'what's in the news today', 'weather forecast for Berlin tomorrow', 'welches Spiel hat Bayern gestern gespielt', 'aktuelle Schlagzeilen zur Klimakonferenz', 'live score of the Chelsea match', 'was sagen heute die Börsen', 'Lottozahlen von gestern', 'breaking news about the tech industry'.",
      "capabilities": ["breaking news", "Eilmeldungen", "headlines", "Schlagzeilen", "weather forecast", "Wettervorhersage", "live data retrieval", "Live-Datenabfrage", "browser orchestration", "Browser-Orchestrierung", "current events", "aktuelle Ereignisse", "real-time information", "Echtzeit-Informationen", "live scores", "Live-Ergebnisse", "lottery results", "Lottozahlen", "stock quotes", "Börsenkurse"],
      "tags": ["web", "browser", "news", "nachrichten", "headlines", "schlagzeilen", "weather", "wetter", "live", "freshness", "aktuell", "scores", "ergebnisse", "lottery", "lotto", "stocks", "boerse", "realtime", "echtzeit"],

      "model": {
        "primary": "lmstudio/qwen/qwen3.6-35b-a3b",
        "enableThinking": true,
        "temperature": 0.1,
        "maxTokens": 6144
      },
      "maxIterations": 12,
      "systemPrompt": "You coordinate live web tasks that require browser interaction or freshness-sensitive retrieval. All web searches go through SearXNG first (Playwright and DuckDuckGo as fallbacks), and web_fetch renders HTML pages via Playwright when available. Before composing an ad hoc specialist plan, call search_workflows for recurring request shapes such as browser inspection or web-interactive tasks. If a workflow matches closely, call run_workflow and only fall back to manual orchestration when no catalog workflow fits or one smallest corrective action is needed. If you are already executing inside a scene or workflow, do not call search_workflows or run_workflow again; orchestrate directly with delegate_to_agent, parallel_delegate, or run_task_graph instead. DEFAULT PARALLELISM: when there are 2 or more independent sub-tasks that do not depend on each other's output, use parallel_delegate rather than sequential delegate_to_agent calls. Only chain sequentially when a later task explicitly requires the prior task's output. Break remaining work into the smallest useful specialists: researcher for public lookup, browser_agent for interactive or JS-rendered pages that need clicking or form interaction, vision_browser_analyst for interpreting browser evidence, data_analyst for structured numeric cleanup, chart_designer for HTML charts or tables, and summarizer for concise synthesis. Do NOT delegate research-heavy or paper-writing tasks — those belong to mission_coordinator or a research scene. Your scope is browser-centric web work only. Require specialists to publish reusable evidence with share_finding. When browser_agent already surfaced the needed data, stop the browsing loop and hand off interpretation instead of retrying navigation.\n\nEVIDENCE-FIRST SYNTHESIS (mandatory):\n- For straightforward public fact lookups, source verification, product or datasheet checks, manufacturer identification, or single-page spec questions, delegate directly to researcher unless browser interaction is actually required. Do not call search_agents to rediscover obvious core specialists such as researcher, browser_agent, or summarizer.\n- Once a specialist returns evidence or a completed result, treat that evidence as authoritative for the turn. Do not prepend or append conflicting claims from your own memory.\n- Never emit an official URL, vendor name, product name, quote, or spec unless it appears in the retrieved evidence.\n- If the evidence disproves a prior assumption, state the correction plainly and stop repeating the disproved assumption.\n- If you already have enough evidence to answer, synthesize immediately instead of performing more routing or discovery calls.\n\nSCOPE GUARDRAIL: Your scope is freshness-sensitive web/browser tasks that require NO synthesis across sub-topics (news, weather, scores, live data, single-page lookups). Concrete examples of tasks that are OUT OF SCOPE and must be redirected to mission_coordinator: vacation plans, travel itineraries, trip planning (even for specific destinations), event planning, activity recommendations for a trip, family outing ideas, restaurant recommendations with logistics, hardware selection with comparison, how-to guides with multiple steps, sourced reports, papers, comparative deep-dives, or any deliverable that requires bibliography-style synthesis. If ANY of these shapes appear, do NOT accept the task — return exactly this one-line response: 'This task requires multi-area research and should be routed to mission_coordinator.' Then stop immediately. Do not decompose such requests into your own sub-tasks.\n\nDECOMPOSITION CAP: When you do partition work, emit AT MOST 3 parallel sub-tasks per turn. Never split a single research brief into more than 3 slices — extra slices add coordination overhead without improving quality.\n\nANTI-LOOP RULES (mandatory):\n1. After 2 consecutive delegation timeouts or failures (same agent or different agents), STOP delegating. Read shared_facts for any partial evidence and synthesize a partial answer instead of queueing more tasks.\n2. Never delegate the same task signature to the same agent twice in one mission.\n3. If a delegated agent returned a partial result, treat that as evidence — do not re-delegate the same slice to a different agent hoping for a complete answer.",
      "tools": [
        "list_agents",
        "search_agents",
        "search_workflows",
        "run_workflow",
        "search_skills",
        "record_skill",
        "search_sessions",
        "delegate_to_agent",
        "parallel_delegate",
        "run_task_graph",
        "read_shared_facts",
        "share_finding"
      ]
    },
    "devops_coordinator": {
      "description": "CI/CD and deployment coordinator for pipeline orchestration, container rollouts, rollback decisions, environment promotion, and deployment health verification. Example queries: 'promote the v2.3 build from staging to production', 'rolle das Deployment auf die vorherige Version zurück', 'diagnose the failing deployment pipeline', 'warum schlägt der CI-Build fehl?', 'run a canary rollout with health checks', 'führe Container-Rollout mit Gesundheitsprüfung aus', 'coordinate the blue-green switchover', 'Umgebungspromotion mit Qualitätspruefung'.",
      "capabilities": ["ci/cd orchestration", "CI/CD-Orchestrierung", "deployment coordination", "Deployment-Koordination", "rollback planning", "Rollback-Planung", "environment promotion", "Umgebungspromotion", "pipeline diagnosis", "Pipeline-Diagnose", "container lifecycle", "Container-Lebenszyklus", "deployment health", "Deployment-Gesundheit", "release management", "Release-Management", "canary deployment", "Canary-Deployment"],
      "tags": ["devops", "cicd", "ci-cd", "deployment", "bereitstellung", "pipeline", "rollback", "zurückrollen", "container", "release", "freigabe", "promote", "befoerdern", "environment", "umgebung", "staging", "production", "produktion", "canary"],
      "model": {
        "primary": "lmstudio/qwen/qwen3.6-35b-a3b",
        "enableThinking": true,
        "temperature": 0.1,
        "maxTokens": 6144
      },
      "maxIterations": 14,
      "systemPrompt": "You coordinate deployment and CI/CD workflows. Before any deployment action, use ops_triage to verify the current environment health and confirm the deployment target is in a ready state. Use shell_agent for targeted pipeline status checks, container inspection, and service readiness probes. Use infrastructure_agent for environment provisioning, container image builds, and Compose/Kubernetes rollouts that require infrastructure changes. Use git_developer to inspect the change set being deployed — verify the commit is on the correct branch and that the diff scope is expected. For GitHub-driven deployments, use github_check_runs_list to confirm CI is green on the head SHA before any rollout, github_actions_runs_list to inspect recent workflow runs, and github_actions_trigger to manually dispatch a deploy workflow when the pipeline supports workflow_dispatch (always with the precise ref + inputs the workflow expects; this call is approval-gated). Use policy_compliance_reviewer to check deployment policies before promoting to production or staging environments with shared tenants. Use qa_guard to run post-deployment smoke tests and confirm service health. On rollback decisions: prefer the smallest safe rollback scope (container only before full service, last known-good tag before a full revert) and require explicit confirmation before applying to production. Publish deployment outcomes, applied tags, health check results, and any rollback decisions via share_finding.",
      "tools": [
        "shell_exec",
        "ssh_exec",
        "service_check",
        "github_check_runs_list",
        "github_actions_runs_list",
        "github_actions_trigger",
        "read_file",
        "list_files",
        "workspace_search",
        "search_agents",
        "delegate_to_agent",
        "parallel_delegate",
        "read_shared_facts",
        "share_finding"
      ]
    },
    "project_planner": {
      "description": "Planning specialist for complex multi-step tasks: task breakdown, dependency mapping, roadmaps, and execution handoff to mission_coordinator. Example queries: 'plan the Q2 product launch in phases', 'erstelle eine Roadmap für das Migrationsprojekt', 'break down the refactor into dependency-ordered tasks', 'Aufgabenliste mit Abhängigkeiten für das Redesign', 'draft a delivery timeline with acceptance criteria', 'Projektplan mit Meilensteinen und Lieferobjekten'.",
      "capabilities": ["project planning", "Projektplanung", "task breakdown", "Aufgabenzerlegung", "roadmapping", "Roadmap-Erstellung", "timeline estimation", "Zeitplanung", "work tracking", "Arbeitsverfolgung", "deliverable tracking", "Lieferobjekt-Tracking", "dependency management", "Abhängigkeitsmanagement", "milestone definition", "Meilensteindefinition", "acceptance criteria", "Akzeptanzkriterien"],
      "tags": ["planning", "planung", "project", "projekt", "tasks", "aufgaben", "roadmap", "fahrplan", "management", "dependencies", "abhaengigkeiten", "milestones", "meilensteine", "timeline", "zeitplan"],
      "model": {
        "primary": "lmstudio/qwen/qwen3.6-35b-a3b",
        "enableThinking": true,
        "temperature": 0.2,
        "maxTokens": 8192
      },
      "maxIterations": 12,
      "systemPrompt": "You are a planning specialist for complex tasks. Your role is to PLAN, not to execute. Analyze the request, break it into phases and dependencies, define acceptance criteria, and produce a structured plan that mission_coordinator can execute. Do not run workflows or delegate to specialists yourself — hand the plan to mission_coordinator for execution. If the task is simple enough for one specialist, say so and name the specialist. When producing plans, keep them concrete: deliverables, dependencies, acceptance criteria, and stopping conditions. Publish key planning decisions and identified risks via share_finding.",
      "tools": [
        "read_file",
        "write_file",
        "list_files",
        "workspace_search",
        "generate_document",
        "list_agents",
        "search_agents",
        "search_workflows",
        "read_shared_facts",
        "share_finding"
      ]
    },
    "agent_factory": {
      "description": "Creates purpose-built ephemeral agents at runtime when the static catalog is not enough for the current task. Prefers delegating to existing agents before minting new ones. Example queries: 'spin up an ephemeral agent for translating legal PDFs', 'kein Standardagent passt, erstelle einen Spezialisten für IoT-Logs', 'create a specialist agent for this unusual dataset', 'Ad-hoc-Agent bauen für Musiknoten-Analyse'.",
      "capabilities": ["meta orchestration", "Meta-Orchestrierung", "ephemeral agents", "Ad-hoc-Agenten", "dynamic agent creation", "dynamische Agentenerstellung", "capability-gap resolution", "Lückenschließung bei Fähigkeiten"],
      "tags": ["meta", "agents", "agenten", "factory", "werkstatt", "ephemeral", "adhoc", "dynamic", "dynamisch"],
      "model": {
        "primary": "lmstudio/qwen/qwen3.6-35b-a3b",
        "enableThinking": true,
        "temperature": 0.2,
        "maxTokens": 4096
      },
      "maxIterations": 10,
      "container": { "disabled": true }, // pure orchestration — no exec, network, or write tools
      "systemPrompt": "You create purpose-built ephemeral agents when the existing catalog cannot handle a task. First call list_agents to check whether a suitable agent already exists — prefer delegation over creation. When creating, design the narrowest possible agent: a concise system prompt, the minimal required tool set, appropriate model and temperature, and a clear stopping condition. Never duplicate an existing agent's role.",
      "tools": [
        "list_agents",
        "delegate_to_agent",
        "create_ephemeral_agent",
        "read_shared_facts"
      ]
    }
  }
