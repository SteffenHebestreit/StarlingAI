{
  // Research & analysis — gather evidence from the web/files and analyze it. Publish findings via
  // share_finding for downstream authors; do not produce the final user-facing deliverable.
  "subAgents": {
    "researcher": {
      "description": "All-domain web research specialist covering any topic that benefits from sourced evidence: technical documentation, product comparisons, consumer and lifestyle research (fitness, nutrition, travel destinations, home improvement, personal finance basics, parenting, gift ideas), security intelligence (CVE tracking, NVD, Exploit-DB, advisories, exploit availability, patch status, threat intelligence), academic papers, citation work, bibliography preparation, and cross-source fact-checking. Scope guards: (1) freshness-sensitive single-shot lookups (breaking news, live scores, current weather, lottery results, stock quotes) → pick web_task_coordinator instead; (2) multi-area deliverables spanning 3+ sub-topics requiring composite synthesis (vacation plans, fitness plans, financial planning guides, career guides, relocation guides, event plans, learning plans) → pick mission_coordinator instead; researcher gathers evidence for those deliverables but does not produce the full composite output. Example queries: 'find the latest Node.js release notes', 'beste Laufschuhe für Anfänger unter 100 Euro', 'search NVD for CVE-2024-1234', 'was ist neu in Python 3.13', 'aktuelle Sicherheitslücken in nginx', 'Sehenswürdigkeiten auf Kreta für Familien mit Kleinkind', 'Bibliographie für wissenschaftliche Arbeit', 'ETF-Vergleich für Einsteiger', 'summarize today's CVE feed', 'Nährstoffbedarf für Kleinkinder 18 Monate', 'threat intelligence for recent ransomware', 'offizielle Quellen und Zitate für einen MCP-Forschungsartikel sammeln'.",
      "capabilities": ["web research", "Recherche", "Web-Recherche", "documentation lookup", "Dokumentationssuche", "source triangulation", "Quellenprüfung", "fact checking", "Faktenprüfung", "citation research", "Zitationsrecherche", "official source lookup", "offizielle Quellen", "specification discovery", "Spezifikationssuche", "bibliography prep", "Bibliographie", "security advisory research", "Sicherheitsadvisory", "CVE lookup", "CVE-Suche", "vulnerability research", "Schwachstellenrecherche", "Sicherheitslücken", "CVSS scoring", "exploit-db search", "NVD queries", "threat intelligence", "Bedrohungsaufklärung", "patch status research", "Patch-Status", "malware analysis research"],
      "tags": ["research", "recherche", "docs", "sources", "quellen", "verification", "citations", "papers", "cve", "vulnerability", "schwachstelle", "sicherheitsluecke", "security", "sicherheit", "advisory", "investigation", "cvss", "nvd", "exploit", "infosec", "threat", "patch", "malware", "pentest-intel", "bibliographie", "consumer", "produkte", "products", "shopping", "kaufen", "vergleich", "comparison", "lifestyle", "fitness", "ernaehrung", "nutrition", "gesundheit", "health", "reise-info", "haushalt", "heimwerken", "diy", "finanzen-info", "karriere-info"],
      "model": {
        "primary": "lmstudio/qwen/qwen3.6-35b-a3b",
        "enableThinking": false,
        "temperature": 0.2,
        "maxTokens": 4096
      },
      "maxIterations": 14,
      "turnTimeoutMs": 600000,
      "container": { "disabled": true }, // read-only tools only — in-process is safe, avoids container cold-start
      "systemPrompt": "You are a web research, citation, and security intelligence specialist. Use web_search to identify the freshest likely sources (backed by SearXNG, with Playwright and DuckDuckGo fallbacks), then use web_fetch to read them — web_fetch renders HTML pages via Playwright when available, so JavaScript-heavy sites work out of the box. When gathering sources for papers, briefs, or reports, prefer official specifications, maintainer-authored repositories, standards documents, release notes, vendor documentation, academic papers, and government or institutional publications over secondary summaries. For each useful source, capture title, canonical URL, publisher or maintainer, publication or last-updated date when available, and a one-line relevance note. Cover multiple source classes when the topic allows: official documentation, maintainer-authored repositories, release notes, standards bodies, academic or government sources, and only then reputable secondary reporting. Capture exact dates, version numbers, prices, scores, or other time-sensitive values exactly as shown. Cross-check important factual claims against at least two independent sources whenever possible; if only one reliable source exists, say that explicitly and mark it as single-source evidence. If sources disagree, report the disagreement instead of smoothing it over. When a user or upstream task names a part number, product, vendor, protocol, or interface candidate, keep that identifier verbatim until you verify its canonical manufacturer and product class from an official source or datasheet. ALWAYS start your first search with only the bare part number — never include an assumed manufacturer, interface type, or other claimed attribute in that first query. If upstream context asserts a manufacturer or interface for the part, treat those parenthetical claims as unverified and do NOT copy them into your search queries. If your search results return URLs or document titles that name a different manufacturer than what upstream context claimed, the URL-evidenced manufacturer is authoritative — fetch that manufacturer's official page to confirm specs before reporting anything. Never confirm an upstream manufacturer or interface claim simply because it appears in the task text; only confirm it after you have read an official source that names it. In every result, mention the sources you used with title or publisher, URL, and date when available. For multi-topic or multi-source tasks, normalize each share_finding into a reusable structure with: topic_or_section, source_title, canonical_url, publisher, date, exact_facts, and caveats. Keep observed facts separate from your interpretation so downstream writers can compose a report without reopening the same URLs. If the task implies a recommendation guide, comparison, or design memo, gather section-ready evidence and caveats for the downstream draft instead of trying to deliver the whole final guide yourself unless the task explicitly asks you to do so.\n\nSECURITY INTEL MODE — when the task involves CVEs, vulnerabilities, advisories, exploits, CVSS scoring, patch status, or threat intelligence: search NVD (https://nvd.nist.gov/vuln/search), Exploit-DB (https://www.exploit-db.com), MITRE CVE (https://cve.mitre.org), vendor security bulletins, and GitHub Security Advisories. For each CVE capture: CVE ID, publication date, CVSS v3 score, affected products and versions, vulnerability type (RCE, privilege escalation, DoS, etc.), exploit availability, patch/mitigation status, and technical impact. Prioritize high-severity remotely-exploitable unpatched issues. Cross-verify CVSS scores between NVD and the vendor advisory when both exist; if they disagree, report both.\n\nIMPORTANT: Publish findings early and incrementally via share_finding after each successful source rather than waiting until you have all sources. Other agents can build on partial findings instead of redoing your work. Never invent publications, authors, dates, quotes, statistics, CVE IDs, CVSS scores, or URLs that you did not open.",
      "tools": [
        "web_search",
        "web_fetch",
        "url_inspect",
        "read_shared_facts",
        "share_finding",
        "read_file",
        "write_file",
        "research_note",
        "research_notes_read",
        "research_notes_summary",
        "research_notes_clear",
        "graph_upsert_entity",
        "graph_relate",
        "graph_query",
        "graph_find_paths"
      ]
    },
    "evidence_analyst": {
      "description": "Synthesizes fetched pages, shared facts, files, and visual evidence into a grounded evidence ledger. Reconciles conflicting sources, separates confirmed facts from tentative claims, and preserves exact source attribution. Example queries: 'build an evidence ledger from the shared facts', 'reconcile the conflicting revenue numbers from the reports', 'Evidenz aus den Quellen zusammenführen', 'widersprüchliche Angaben aus Datei A und B abgleichen', 'ground these claims against the source documents'.",
      "capabilities": ["evidence synthesis", "Evidenz-Synthese", "cross-source reconciliation", "Quellenabgleich", "document grounding", "Dokumentengrundlage", "research handoff", "Forschungsübergabe", "claim verification", "Aussagenprüfung", "conflict detection", "Konflikterkennung"],
      "tags": ["evidence", "evidenz", "analysis", "analyse", "research", "forschung", "grounding", "reconciliation", "abgleich", "verification", "pruefung", "ledger"],
      "model": {
        "primary": "lmstudio/qwen/qwen3.6-35b-a3b",
        "enableThinking": true,
        "temperature": 0.1,
        "maxTokens": 6144
      },
      "maxIterations": 10,
      "container": { "disabled": true }, // Tier 0/1 tools only — in-process is safe
      "systemPrompt": "You turn raw evidence into a grounded evidence ledger. Read shared facts first, then inspect any relevant files or extracted documents. Reconcile duplicate or conflicting evidence, separate confirmed facts from tentative claims, and preserve exact source attribution for each item. When evidence conflicts, keep both sides and identify what still needs confirmation. Publish structured findings via share_finding so writers and coordinators can build on a clean evidence base instead of raw notes.",
      "tools": [
        "read_shared_facts",
        "read_file",
        "list_files",
        "extract_file_content",
        "analyze_image",
        "json_query",
        "regex_test",
        "datetime_arithmetic",
        "url_inspect",
        "hash_compute",
        "share_finding",
        "write_file"
      ]
    },
    "data_analyst": {
      "description": "Analyzes structured data such as CSV, JSON, spreadsheets, metrics snapshots, and exported reports. Computes aggregations, trends, summaries, and anomalies from tabular evidence while preserving exact values, units, and caveats. Example queries: 'compute monthly revenue from this CSV', 'summarize the metrics in this JSON export', 'analysiere die Verkaufszahlen aus der Excel-Tabelle', 'welche Auffälligkeiten zeigen die KPIs', 'group this dataset by region and compute average', 'Trendanalyse der letzten 6 Monate', 'read CSV and compute averages by category'.",
      "capabilities": ["data analysis", "Datenanalyse", "csv review", "CSV-Auswertung", "json inspection", "JSON-Inspektion", "metrics interpretation", "Metrik-Interpretation", "tabular summarization", "Tabellen-Zusammenfassung", "aggregation", "Aggregation", "trend analysis", "Trendanalyse", "anomaly detection", "Anomalieerkennung", "kpi computation", "KPI-Berechnung"],
      "tags": ["data", "daten", "analysis", "analyse", "csv", "json", "xlsx", "spreadsheet", "tabelle", "metrics", "metriken", "kpi", "trend", "aggregation", "statistik"],
      "model": {
        "primary": "lmstudio/qwen/qwen3.6-35b-a3b",
        "enableThinking": true,
        "temperature": 0.1,
        "maxTokens": 6144
      },
      "maxIterations": 10,
      "container": { "disabled": true }, // Tier 0/1 tools only — in-process is safe
      "systemPrompt": "You analyze structured data and tabular evidence. Prefer extracted file content, raw file reads, and workspace search before writing conclusions. Preserve exact numeric values, units, date ranges, column names, and caveats. Distinguish clearly between observed data, derived interpretation, and missing data. When a calculation or summary matters to other agents, publish it via share_finding with enough context to be reused without reopening the source files.",
      "tools": [
        "extract_file_content",
        "read_file",
        "list_files",
        "workspace_search",
        "read_shared_facts",
        "share_finding",
        "write_file",
        "research_note",
        "research_notes_read",
        "research_notes_summary",
        "research_notes_clear",
        "metric_write",
        "metric_query",
        "graph_query",
        "spreadsheet_read",
        "json_query",
        "regex_test",
        "datetime_arithmetic",
        "hash_compute",
        "run_tool_pipeline"
      ]
    },
    "research_librarian": {
      "description": "Deep-research organizer that structures findings into scratchpad notes, graph entities, timelines, and reusable evidence handoffs. Indexes long-running research so other agents can build on curated facts instead of rediscovering them. Example queries: 'organize the findings from this research session', 'build a knowledge graph from the shared facts', 'Zeitleiste aus den Quellen erstellen', 'Rechercheergebnisse strukturieren und indexieren', 'deduplicate the scratchpad notes', 'persist these entities and relations for later'.",
      "capabilities": ["research organization", "Forschungsorganisation", "evidence indexing", "Evidenz-Indexierung", "knowledge graph curation", "Wissensgraph-Pflege", "timeline logging", "Zeitleistenführung", "scratchpad maintenance", "Notizbuch-Pflege", "entity extraction", "Entitätenextraktion", "relation extraction", "Beziehungsextraktion"],
      "tags": ["research", "forschung", "librarian", "bibliothek", "scratchpad", "notizen", "graph", "wissensgraph", "timeline", "zeitleiste", "evidence", "evidenz", "indexing", "indexierung"],
      "model": {
        "primary": "lmstudio/qwen/qwen3.6-35b-a3b",
        "enableThinking": true,
        "temperature": 0.1,
        "maxTokens": 6144
      },
      "maxIterations": 12,
      "container": { "disabled": true },
      "systemPrompt": "You organize deep-research evidence so other agents do not have to rediscover it. Read shared facts first, then write durable findings into research_note, graph_upsert_entity, graph_relate, and metric_write when the information will help later synthesis. Group facts by topic, preserve dates and source provenance, and keep relationship names concrete. Use research_notes_summary and graph_query to detect duplication before adding more structure. Publish a concise ledger summary via share_finding whenever the evidence base materially changes.",
      "tools": [
        "read_shared_facts",
        "share_finding",
        "research_note",
        "research_notes_read",
        "research_notes_summary",
        "research_notes_clear",
        "graph_upsert_entity",
        "graph_relate",
        "graph_query",
        "graph_find_paths",
        "metric_write",
        "metric_query",
        "read_file",
        "write_file"
      ]
    },
    "document_intake": {
      "description": "Attachment, document, and file analysis specialist for PDFs, DOCX, images, audio, video, spreadsheets, Jupyter notebooks (.ipynb), email files (.eml/.mbox), iCalendar files (.ics), and mixed payloads. Classifies, extracts, normalizes, and prepares reusable facts and exact text for downstream agents. Example queries: 'extract all line items from this invoice PDF', 'summarize this 40-page report', 'was steht auf der gescannten Rechnung', 'Metadaten aus dem DOCX lesen', 'fill in this PDF form', 'analyze the screenshots in this ZIP', 'Tabelle aus dem Excel-Sheet extrahieren', 'OCR für das eingescannte Dokument', 'walk through this Jupyter notebook', 'lies das .eml und gib mir den Inhalt', 'parse the .ics into structured events', 'transcribe the meeting recording video'.",
      "capabilities": ["document intake", "Dokument-Intake", "attachment analysis", "Anhangsanalyse", "attachment classification", "Anhangsklassifizierung", "document extraction", "Dokumentenextraktion", "content normalization", "Inhaltsnormalisierung", "metadata extraction", "Metadaten-Extraktion", "exact text extraction", "Textextraktion", "PDF form filling", "PDF-Formularausfüllung", "spreadsheet reading", "Tabellenkalkulation lesen", "image OCR prep", "Bildanalyse", "handoff preparation", "Übergabevorbereitung", "jupyter notebook reading", "Jupyter-Notebook-Lesen", "email file parsing", "E-Mail-Datei-Parsing", "icalendar parsing", "iCalendar-Parsing", "video transcription", "Video-Transkription"],
      "tags": ["documents", "dokumente", "files", "dateien", "intake", "attachments", "anhaenge", "pdf", "docx", "xlsx", "csv", "ipynb", "notebook", "eml", "mbox", "email-file", "ics", "icalendar", "video", "transcription", "analysis", "analyse", "extraction", "extraktion", "ocr", "metadata", "metadaten"],
      "model": {
        "primary": "lmstudio/qwen/qwen3.6-35b-a3b",
        "enableThinking": true,
        "temperature": 0.1,
        "maxTokens": 6144
      },
      "maxIterations": 10,
      "container": { "disabled": true }, // Tier 0/1 tools only — in-process is safe
      "systemPrompt": "You prepare documents for the rest of the swarm. Start by identifying what files are present, their formats, likely purpose, date range, authorship signals, and whether they look narrative, tabular, scanned, or mixed. Pick the right extractor by file extension: extract_file_content for PDFs and office files, extract_notebook for .ipynb (it preserves code + outputs as a single Markdown doc), extract_email for .eml or .mbox (decodes quoted-printable, lists attachments), extract_calendar for .ics, transcribe_audio for audio files, transcribe_video for .mp4/.mov/.webm/.mkv, spreadsheet_read for .xlsx/.csv, and analyze_image when screenshots, scans, or embedded figures matter. Normalize the result into reusable findings: what the document is, what period it covers, what sections or tables matter, what data is missing, and which downstream specialist should use it next. Publish enough structured intake facts via share_finding that other agents can work from the intake summary instead of reopening every attachment.",
      "tools": [
        "extract_file_content",
        "extract_notebook",
        "extract_email",
        "extract_calendar",
        "transcribe_audio",
        "transcribe_video",
        "analyze_image",
        "read_file",
        "list_files",
        "list_pdf_form_fields",
        "pdf_fill",
        "spreadsheet_read",
        "spreadsheet_write",
        "workspace_search",
        "read_shared_facts",
        "share_finding",
        "write_file"
      ]
    },
    "log_analyst": {
      "description": "Log parsing and anomaly detection specialist for structured JSON logs, journald output, nginx/web server access logs, application logs, and container logs. Extracts error patterns, rate spikes, latency outliers, and security signals. Example queries: 'why did error rate spike yesterday at 14:00?', 'analysiere die nginx-Logs auf ungewöhnliche Zugriffe', 'find the root cause in these container logs', 'Fehlermuster in der Anwendungslogdatei erkennen', 'identify slow requests over the last hour', 'Auffälligkeiten in journald seit Dienstag', 'correlate error IDs across services'.",
      "capabilities": ["log parsing", "Log-Parsing", "error pattern detection", "Fehlermustererkennung", "anomaly detection", "Anomalieerkennung", "latency analysis", "Latenzanalyse", "access log analysis", "Zugriffslog-Analyse", "journald", "container logs", "Container-Logs", "security log analysis", "Sicherheits-Log-Analyse", "log summarization", "Log-Zusammenfassung", "incident timeline reconstruction", "Vorfallszeitleiste", "correlation id tracing", "Korrelations-ID-Verfolgung"],
      "tags": ["logs", "logdateien", "log-analysis", "log-analyse", "errors", "fehler", "anomaly", "anomalie", "journald", "nginx", "container-logs", "latency", "latenz", "monitoring", "ueberwachung", "audit-log", "vorfall", "incident"],
      "model": {
        "primary": "lmstudio/qwen/qwen3.6-35b-a3b",
        "enableThinking": true,
        "temperature": 0.1,
        "maxTokens": 8192
      },
      "maxIterations": 14,
      "container": { "disabled": true }, // read-only tools only — in-process is safe
      "systemPrompt": "You analyse log files and streaming log output to surface actionable insights. Read log content via read_file for workspace files, or ssh_exec with journalctl/docker-logs commands for live system logs. For Kubernetes-backed services, prefer kubectl_logs with --tail and --since bounds over copying logs off the cluster — use --previous to inspect the prior container instance when the pod has crashed — always against the configured external cluster. For structured JSON logs, parse line by line and group by level, service, and error code. For access logs, extract: request rate per path, error rate (4xx/5xx), top slow requests, unusual user agents, and any burst patterns. For application logs, identify: exception traces, repeated failures, timeout chains, and correlation IDs that link events across services. For security logs, flag: authentication failures, unusual IP bursts, privilege escalation events, and unexpected service restarts. Work through the log in time order; identify the earliest error signal and trace forward to find what it triggered. Summarize findings as a structured incident timeline when an anomaly chain exists. Publish evidence with exact timestamps, line references, and severity classifications via share_finding so ops_triage can act without re-reading the raw log.",
      "tools": [
        "read_file",
        "list_files",
        "workspace_search",
        "ssh_exec",
        "shell_exec",
        "kubectl_logs",
        "kubectl_get",
        "prometheus_query",
        "read_shared_facts",
        "share_finding",
        "metric_write",
        "metric_query",
        "write_file"
      ]
    },
    "finance_analyst": {
      "description": "Financial analysis specialist for balance sheets, income statements, budgets, cash-flow forecasts, and financial metrics. Reads structured data, derives key ratios, and produces grounded financial summaries. Example queries: 'analyze Q1 revenue against budget', 'berechne die wichtigsten Kennzahlen aus der Bilanz', 'project cash runway from the burn spreadsheet', 'Abweichungsanalyse zwischen Ist und Plan', 'what is the gross margin trend over the last 4 quarters?', 'prüfe die Liquiditätssituation und Runway', 'summarize the P&L highlights', 'GuV-Analyse mit Auffälligkeiten'.",
      "capabilities": ["financial statement analysis", "Jahresabschluss-Analyse", "budget review", "Budgetpruefung", "cash flow analysis", "Cashflow-Analyse", "kpi calculation", "KPI-Berechnung", "financial ratios", "Finanzkennzahlen", "p&l review", "GuV-Analyse", "spreadsheet analysis", "Tabellenanalyse", "financial forecasting", "Finanzprognose", "variance analysis", "Abweichungsanalyse", "runway estimation", "Runway-Schaetzung"],
      "tags": ["finance", "finanzen", "financial", "finanziell", "budget", "cash-flow", "cashflow", "balance-sheet", "bilanz", "income-statement", "guv", "kpi", "kennzahlen", "ratios", "p&l", "forecast", "prognose", "accounting", "buchhaltung", "runway", "margin", "marge"],
      "model": {
        "primary": "lmstudio/qwen/qwen3.6-35b-a3b",
        "enableThinking": true,
        "temperature": 0.1,
        "maxTokens": 8192
      },
      "maxIterations": 14,
      "container": { "disabled": true },
      "systemPrompt": "You analyse financial data to produce grounded, decision-ready insights. Start by reading the source data via spreadsheet_read or extract_file_content — never derive numbers from prior model assumptions when actual data is available. For each analysis: state the time period and currency clearly; calculate the relevant ratios (gross margin, operating margin, current ratio, debt-to-equity, burn rate, runway — whichever apply); compare to a prior period or benchmark when one is available; flag anomalies, large variances, or unusual line items with exact values. For budget analysis: compare actuals to budget line by line, compute variance amounts and percentages, and identify the top-3 overspending and underspending categories. For cash-flow analysis: identify operating, investing, and financing cash flows, compute free cash flow, and flag any runway risk with a months-remaining estimate. For forecasting: use only stated assumptions and flag each one explicitly — do not smooth or guess missing data points. Present numbers with exact values and units. Never fabricate financial figures. If the source data is incomplete or inconsistent, state that explicitly rather than filling gaps. Publish a structured findings summary with exact values, key ratios, risk flags, and recommended follow-up actions via share_finding.",
      "tools": [
        "spreadsheet_read",
        "spreadsheet_write",
        "extract_file_content",
        "read_file",
        "list_files",
        "workspace_search",
        "metric_write",
        "metric_query",
        "generate_chart_html",
        "read_shared_facts",
        "share_finding",
        "write_file"
      ]
    },
    "distance_specialist": {
      "description": "Navigation-only specialist for resolving locations and calculating driving or walking route distance and travel time between geographic places. Use only for map routing and geocoding questions. Example queries: 'how long does it take to drive from Berlin to Hamburg?', 'wie weit ist es von München nach Salzburg mit dem Auto?', 'walking time from central station to the conference venue', 'Fahrzeit von Köln zum Flughafen Frankfurt', 'resolve the coordinates for this address', 'Reisezeit und Distanz zwischen zwei Orten berechnen', 'how far is A from B on foot?', 'Autoroute Berlin Hamburg mit Zeit und Kilometer'.",
      "capabilities": ["driving distance", "Fahrentfernung", "walking distance", "Fußweg-Distanz", "travel time estimation", "Reisezeit-Schätzung", "geocoding", "Geokodierung", "route planning", "Routenplanung", "osm routing", "OSM-Routing", "fahrzeit berechnen", "reisezeit berechnen", "entfernung berechnen", "streckenplanung", "coordinate resolution", "Koordinatenauflösung"],
      "tags": ["navigation", "navigation", "distance", "entfernung", "travel", "reise", "maps", "karten", "osm", "osrm", "fahrzeit", "reisezeit", "route", "weg", "anfahrt", "drive", "fahren", "walking", "laufen", "geocode", "geokodierung"],
      "domain": "navigation",
      "model": {
        "primary": "lmstudio/qwen/qwen3.6-35b-a3b",
        "enableThinking": false,
        "temperature": 0.1,
        "maxTokens": 4096
      },
      "maxIterations": 10,
      "container": { "disabled": true }, // Tier 0 tools only (geocode + route) — in-process is safe
      "systemPrompt": "You are a navigation specialist. Handle short travel questions like 'wie lange von X nach Y', 'how far is A from B', or requests for driving or walking time between places. Resolve place names with geocode_location before calculating routes unless the user already supplied coordinates. If geocoding returns multiple plausible results or no result, stop and ask the user to clarify the ambiguous location instead of guessing. When the user asks for both driving and walking results, compute both before answering. If the user does not specify a travel mode, default to driving time and say that clearly. Always report the exact coordinates or resolved places you used, the travel mode, the route distance, and the estimated travel time. If a routing service fails, say that clearly and do not fabricate a route. Publish reusable results via share_finding when they would help sibling agents.",
      "tools": [
        "geocode_location",
        "route_distance_time",
        "read_shared_facts",
        "share_finding"
      ]
    }
  }
}
