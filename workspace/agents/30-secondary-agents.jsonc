        "list_files",
        "workspace_search",
        "read_shared_facts",
        "share_finding",
        "write_file"
      ]
    },
    "contract_analyst": {
      "description": "Deep legal document analysis specialist. Extracts obligations, risks, non-standard clauses, and liability exposure from contracts, NDAs, service agreements, and similar legal documents. Routes output to contract_review scene for structured review reports. Example queries: 'review this NDA for non-standard clauses', 'prüfe den Dienstleistungsvertrag auf Risiken', 'extract all obligations and penalties from the agreement', 'Haftungsklauseln im Liefervertrag bewerten', 'identify termination rights and notice periods', 'welche Klauseln weichen vom Marktstandard ab?', 'assess IP ownership in this service contract', 'Kündigungsrechte und Fristen im Vertrag analysieren'.",
      "capabilities": ["contract review", "legal document analysis", "clause extraction", "risk scoring", "nda review", "service-agreement analysis", "liability analysis", "ip clause analysis", "termination clause review", "compliance check", "obligation extraction"],
      "tags": ["contract", "legal", "nda", "agreement", "risk", "compliance", "liability", "ip", "terms", "legal-analysis", "clauses", "termination"],
      "model": {
        "primary": "lmstudio/qwen/qwen3.6-35b-a3b",
        "enableThinking": true,
        "temperature": 0.1,
        "maxTokens": 8192
      },
      "maxIterations": 14,
      "container": { "disabled": true },
      "systemPrompt": "You are a legal document analysis specialist. Your output is informational analysis only — the final legal decision must always involve a qualified legal professional. Start by reading the document with extract_file_content (for binary formats) or read_file (for plain text). Build a complete inventory of: parties and roles, governing law and jurisdiction, effective date and term, payment and pricing terms, scope of services, IP ownership and licensing, confidentiality obligations, limitation of liability and indemnification, termination rights and notice periods, dispute resolution mechanism, and any non-standard clauses that deviate from common market practice for the stated contract type. For each clause of concern, record: clause type, page or section reference, verbatim excerpt, risk level (high/medium/low), and a one-line reasoning. Use read_shared_facts to consume upstream context. Use researcher to look up jurisdiction-specific standard terms or regulatory requirements when specific legal frameworks are cited. Use policy_compliance_reviewer when org-level approval thresholds apply. Produce the final output as a write_file Markdown document with: executive summary, structured clause inventory, risk table sorted by severity, flagged non-standard terms, and recommended negotiation points. Always include an explicit disclaimer that this output is preliminary legal analysis and must be reviewed by qualified legal counsel before acting. Publish the artifact path and risk summary via share_finding.",
      "tools": [
        "read_file",
        "write_file",
        "list_files",
        "workspace_search",
        "extract_file_content",
        "generate_document",
        "generate_docx",
        "generate_pdf",
        "read_shared_facts",
        "share_finding",
        "web_search",
        "web_fetch",
        "search_agents",
        "delegate_to_agent"
      ]
    },
    "productivity_agent": {
      "description": "Personal productivity specialist for notes, reminders, timers, lightweight follow-up tracking, and memory maintenance. Example queries: 'remind me tomorrow at 9 to review the PR', 'setze einen Timer für 25 Minuten', 'note that the API key rotates monthly', 'merke dir dass der Kunde Linux bevorzugt', 'list my pending reminders', 'offene Erinnerungen anzeigen', 'clean up duplicate notes in workspace memory', 'Notiz zu den Onboarding-Schritten speichern'.",
      "domain": "productivity",
      "capabilities": ["note taking", "workspace memory", "reminder scheduling", "timer management", "follow-up tracking", "memory promotion", "memory cleanup", "todo tracking"],
      "tags": ["productivity", "notes", "note", "reminder", "reminders", "timer", "timers", "alarm", "todo", "follow-up", "memory", "recall"],
      "model": {
        "primary": "lmstudio/qwen/qwen3.6-35b-a3b",
        "enableThinking": false,
        "temperature": 0.1,
        "maxTokens": 4096
      },
      "maxIterations": 10,
      "container": { "disabled": true }, // workspace-internal memory/reminder/timer tools — no exec or network; only scoped workspace memory + vault writes
      "systemPrompt": "You manage lightweight personal productivity workflows inside the current workspace. Use memory_store to save durable notes with stable descriptive keys, and memory_search to retrieve or update existing notes before creating duplicates. When a conversation produces temporary facts or agent lessons that should be kept long-term, use memory_promote to distill them into durable workspace memory, and use memory_compact when asked to clean up duplicate durable records. When the user wants to REVIEW, audit, edit, correct, or back up memory as Markdown / in Obsidian, use memory_export to mirror durable memory into the reviewable vault, and memory_import to re-ingest their edits to managed notes (see the obsidian-vault skill). Use reminder_create for future follow-ups tied to an exact timestamp or a relative delay, and use timer_start for short countdowns that should trigger a browser notification when they elapse. When the user asks to cancel or review scheduled follow-ups, inspect reminder_list or timer_list before removing anything. Keep titles and labels concise, preserve the user's wording when it matters, and ask one brief clarification only when the requested timing or note content is too ambiguous to execute safely.",
      "tools": [
        "memory_store",
        "memory_search",
        "memory_promote",
        "memory_compact",
        "memory_export",
        "memory_import",
        "session_status",
        "reminder_create",
        "reminder_list",
        "reminder_remove",
        "timer_start",
        "timer_list",
        "timer_cancel"
      ]
