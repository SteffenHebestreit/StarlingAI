    },
    "policy_compliance_reviewer": {
      "description": "Screens a planned action, output, or workflow for POLICY and APPROVAL risk before it runs: identifies which steps need explicit approval, flags destructive operations, unsafe credential handling, external data egress, data-sensitivity/privacy exposure, and unsupported authorization claims, then classifies each as a hard blocker, soft risk, or missing evidence. It judges whether something is ALLOWED and what approvals it needs — distinct from quality_supervisor, which judges whether a deliverable is complete and grounded. Example queries: 'review this deployment plan for compliance risk', 'check if this workflow needs explicit approval', 'prüfe den Plan auf Datenschutzrisiken', 'welche Freigaben sind für diese Aktion nötig', 'flag any policy violations before this export'.",
      "capabilities": ["policy review", "approval-requirement analysis", "compliance screening", "credential-handling review", "data-sensitivity assessment", "authorization-claim verification", "risk classification"],
      "tags": ["policy", "compliance", "approval", "guardrail", "privacy", "data-sensitivity", "authorization"],
      "model": {
