{
  // Secondary agents — very specific / niche single-purpose specialists.
  "subAgents": {
    "data_analyst": {
      "description": "Analyzes structured data such as CSV, JSON, spreadsheets, metrics snapshots, and exported reports. Computes aggregations, trends, summaries, and anomalies from tabular evidence while preserving exact values, units, and caveats. Example queries: 'compute monthly revenue from this CSV', 'summarize the metrics in this JSON export', 'analysiere die Verkaufszahlen aus der Excel-Tabelle', 'welche Auffälligkeiten zeigen die KPIs', 'group this dataset by region and compute average', 'Trendanalyse der letzten 6 Monate', 'read CSV and compute averages by category'.",
      "capabilities": ["data analysis", "csv review", "json inspection", "metrics interpretation", "tabular summarization", "aggregation", "trend analysis", "anomaly detection", "kpi computation"],
      "tags": ["data", "analysis", "csv", "json", "xlsx", "spreadsheet", "metrics", "kpi", "trend", "aggregation", "statistics"],
      "model": {
        "primary": "lmstudio/qwen/qwen3.6-35b-a3b",
        "enableThinking": true,
        "temperature": 0.1,
        "maxTokens": 6144
      },
      "maxIterations": 10,
      "container": { "disabled": true }, // Tier 0/1 tools only — in-process is safe
      "systemPrompt": "You analyze structured data and tabular evidence. Prefer extracted file content, raw file reads, and workspace search before writing conclusions. Preserve exact numeric values, units, date ranges, column names, and caveats. Distinguish clearly between observed data, derived interpretation, and missing data. When a calculation or summary matters to other agents, publish it via share_finding with enough context to be reused without reopening the source files.",
      "tools": [
        "extract_file_content",
        "read_file",
        "list_files",
        "workspace_search",
        "read_shared_facts",
        "share_finding",
        "write_file",
        "research_note",
        "research_notes_read",
        "research_notes_summary",
        "research_notes_clear",
        "metric_write",
        "metric_query",
        "graph_query",
        "spreadsheet_read",
        "json_query",
        "regex_test",
        "datetime_arithmetic",
        "hash_compute",
        "run_tool_pipeline"
      ]
    },
    "finance_analyst": {
      "description": "Financial analysis specialist for balance sheets, income statements, budgets, cash-flow forecasts, and financial metrics. Reads structured data, derives key ratios, and produces grounded financial summaries. Example queries: 'analyze Q1 revenue against budget', 'berechne die wichtigsten Kennzahlen aus der Bilanz', 'project cash runway from the burn spreadsheet', 'Abweichungsanalyse zwischen Ist und Plan', 'what is the gross margin trend over the last 4 quarters?', 'prüfe die Liquiditätssituation und Runway', 'summarize the P&L highlights', 'GuV-Analyse mit Auffälligkeiten'.",
      "capabilities": ["financial statement analysis", "budget review", "cash flow analysis", "kpi calculation", "financial ratios", "p&l review", "spreadsheet analysis", "financial forecasting", "variance analysis", "runway estimation"],
      "tags": ["finance", "financial", "budget", "cash-flow", "balance-sheet", "income-statement", "kpi", "ratios", "p&l", "forecast", "accounting", "runway", "margin"],
      "model": {
        "primary": "lmstudio/qwen/qwen3.6-35b-a3b",
        "enableThinking": true,
        "temperature": 0.1,
        "maxTokens": 8192
      },
      "maxIterations": 14,
      "container": { "disabled": true },
      "systemPrompt": "You analyse financial data to produce grounded, decision-ready insights. Start by reading the source data via spreadsheet_read or extract_file_content — never derive numbers from prior model assumptions when actual data is available. For each analysis: state the time period and currency clearly; calculate the relevant ratios (gross margin, operating margin, current ratio, debt-to-equity, burn rate, runway — whichever apply); compare to a prior period or benchmark when one is available; flag anomalies, large variances, or unusual line items with exact values. For budget analysis: compare actuals to budget line by line, compute variance amounts and percentages, and identify the top-3 overspending and underspending categories. For cash-flow analysis: identify operating, investing, and financing cash flows, compute free cash flow, and flag any runway risk with a months-remaining estimate. For forecasting: use only stated assumptions and flag each one explicitly — do not smooth or guess missing data points. Present numbers with exact values and units. Never fabricate financial figures. If the source data is incomplete or inconsistent, state that explicitly rather than filling gaps. Publish a structured findings summary with exact values, key ratios, risk flags, and recommended follow-up actions via share_finding.",
      "tools": [
        "spreadsheet_read",
        "spreadsheet_write",
        "extract_file_content",
        "read_file",
        "list_files",
        "workspace_search",
        "metric_write",
        "metric_query",
        "generate_chart_html",
        "read_shared_facts",
        "share_finding",
        "write_file"
      ]
    },
    "log_analyst": {
      "description": "Log parsing and anomaly detection specialist for structured JSON logs, journald output, nginx/web server access logs, application logs, and container logs. Extracts error patterns, rate spikes, latency outliers, and security signals. Example queries: 'why did error rate spike yesterday at 14:00?', 'analysiere die nginx-Logs auf ungewöhnliche Zugriffe', 'find the root cause in these container logs', 'Fehlermuster in der Anwendungslogdatei erkennen', 'identify slow requests over the last hour', 'Auffälligkeiten in journald seit Dienstag', 'correlate error IDs across services'.",
      "capabilities": ["log parsing", "error pattern detection", "anomaly detection", "latency analysis", "access log analysis", "journald", "container logs", "security log analysis", "log summarization", "incident timeline reconstruction", "correlation id tracing"],
      "tags": ["logs", "log-analysis", "errors", "anomaly", "journald", "nginx", "container-logs", "latency", "monitoring", "audit-log", "incident"],
      "model": {
        "primary": "lmstudio/qwen/qwen3.6-35b-a3b",
        "enableThinking": true,
        "temperature": 0.1,
        "maxTokens": 8192
      },
      "maxIterations": 14,
      "container": { "disabled": true }, // read-only tools only — in-process is safe
      "systemPrompt": "You analyse log files and streaming log output to surface actionable insights. Read log content via read_file for workspace files, or ssh_exec with journalctl/docker-logs commands for live system logs. For Kubernetes-backed services, prefer kubectl_logs with --tail and --since bounds over copying logs off the cluster — use --previous to inspect the prior container instance when the pod has crashed — always against the configured external cluster. For structured JSON logs, parse line by line and group by level, service, and error code. For access logs, extract: request rate per path, error rate (4xx/5xx), top slow requests, unusual user agents, and any burst patterns. For application logs, identify: exception traces, repeated failures, timeout chains, and correlation IDs that link events across services. For security logs, flag: authentication failures, unusual IP bursts, privilege escalation events, and unexpected service restarts. Work through the log in time order; identify the earliest error signal and trace forward to find what it triggered. Summarize findings as a structured incident timeline when an anomaly chain exists. Publish evidence with exact timestamps, line references, and severity classifications via share_finding so ops_triage can act without re-reading the raw log.",
      "tools": [
        "read_file",
        "list_files",
        "workspace_search",
        "ssh_exec",
        "shell_exec",
        "kubectl_logs",
        "kubectl_get",
        "prometheus_query",
        "read_shared_facts",
        "share_finding",
        "metric_write",
        "metric_query",
        "write_file"
      ]
    },
    "research_librarian": {
      "description": "Deep-research organizer that structures findings into scratchpad notes, graph entities, timelines, and reusable evidence handoffs. Indexes long-running research so other agents can build on curated facts instead of rediscovering them. Example queries: 'organize the findings from this research session', 'build a knowledge graph from the shared facts', 'Zeitleiste aus den Quellen erstellen', 'Rechercheergebnisse strukturieren und indexieren', 'deduplicate the scratchpad notes', 'persist these entities and relations for later'.",
      "capabilities": ["research organization", "evidence indexing", "knowledge graph curation", "timeline logging", "scratchpad maintenance", "entity extraction", "relation extraction"],
      "tags": ["research", "librarian", "scratchpad", "graph", "knowledge-graph", "timeline", "evidence", "indexing"],
      "model": {
        "primary": "lmstudio/qwen/qwen3.6-35b-a3b",
        "enableThinking": true,
        "temperature": 0.1,
        "maxTokens": 6144
      },
      "maxIterations": 12,
      "container": { "disabled": true },
      "systemPrompt": "You organize deep-research evidence so other agents do not have to rediscover it. Read shared facts first, then write durable findings into research_note, graph_upsert_entity, graph_relate, and metric_write when the information will help later synthesis. Group facts by topic, preserve dates and source provenance, and keep relationship names concrete. Use research_notes_summary and graph_query to detect duplication before adding more structure. Publish a concise ledger summary via share_finding whenever the evidence base materially changes.",
      "tools": [
        "read_shared_facts",
        "share_finding",
        "research_note",
        "research_notes_read",
        "research_notes_summary",
        "research_notes_clear",
        "graph_upsert_entity",
        "graph_relate",
        "graph_query",
        "graph_find_paths",
        "metric_write",
        "metric_query",
        "read_file",
        "write_file"
      ]
    },
    "document_intake": {
      "description": "Attachment, document, and file analysis specialist for PDFs, DOCX, images, audio, video, spreadsheets, Jupyter notebooks (.ipynb), email files (.eml/.mbox), iCalendar files (.ics), and mixed payloads. Classifies, extracts, normalizes, and prepares reusable facts and exact text for downstream agents. Example queries: 'extract all line items from this invoice PDF', 'summarize this 40-page report', 'was steht auf der gescannten Rechnung', 'Metadaten aus dem DOCX lesen', 'fill in this PDF form', 'analyze the screenshots in this ZIP', 'Tabelle aus dem Excel-Sheet extrahieren', 'OCR für das eingescannte Dokument', 'walk through this Jupyter notebook', 'lies das .eml und gib mir den Inhalt', 'parse the .ics into structured events', 'transcribe the meeting recording video'.",
      "capabilities": ["document intake", "attachment analysis", "attachment classification", "document extraction", "content normalization", "metadata extraction", "exact text extraction", "PDF form filling", "spreadsheet reading", "image OCR prep", "handoff preparation", "jupyter notebook reading", "email file parsing", "icalendar parsing", "video transcription"],
      "tags": ["documents", "files", "intake", "attachments", "pdf", "docx", "xlsx", "csv", "ipynb", "notebook", "eml", "mbox", "email-file", "ics", "icalendar", "video", "transcription", "analysis", "extraction", "ocr", "metadata"],
      "model": {
        "primary": "lmstudio/qwen/qwen3.6-35b-a3b",
        "enableThinking": true,
        "temperature": 0.1,
        "maxTokens": 6144
      },
      "maxIterations": 10,
      "container": { "disabled": true }, // Tier 0/1 tools only — in-process is safe
      "systemPrompt": "You prepare documents for the rest of the swarm. Start by identifying what files are present, their formats, likely purpose, date range, authorship signals, and whether they look narrative, tabular, scanned, or mixed. Pick the right extractor by file extension: extract_file_content for PDFs and office files, extract_notebook for .ipynb (it preserves code + outputs as a single Markdown doc), extract_email for .eml or .mbox (decodes quoted-printable, lists attachments), extract_calendar for .ics, transcribe_audio for audio files, transcribe_video for .mp4/.mov/.webm/.mkv, spreadsheet_read for .xlsx/.csv, and analyze_image when screenshots, scans, or embedded figures matter. Normalize the result into reusable findings: what the document is, what period it covers, what sections or tables matter, what data is missing, and which downstream specialist should use it next. Publish enough structured intake facts via share_finding that other agents can work from the intake summary instead of reopening every attachment.",
      "tools": [
        "extract_file_content",
        "extract_notebook",
        "extract_email",
        "extract_calendar",
        "transcribe_audio",
        "transcribe_video",
        "analyze_image",
        "read_file",
        "list_files",
        "list_pdf_form_fields",
        "pdf_fill",
        "spreadsheet_read",
        "spreadsheet_write",
        "workspace_search",
        "read_shared_facts",
        "share_finding",
        "write_file"
      ]
    },
    "distance_specialist": {
      "description": "Navigation-only specialist for resolving locations and calculating driving or walking route distance and travel time between geographic places. Use only for map routing and geocoding questions. Example queries: 'how long does it take to drive from Berlin to Hamburg?', 'wie weit ist es von München nach Salzburg mit dem Auto?', 'walking time from central station to the conference venue', 'Fahrzeit von Köln zum Flughafen Frankfurt', 'resolve the coordinates for this address', 'Reisezeit und Distanz zwischen zwei Orten berechnen', 'how far is A from B on foot?', 'Autoroute Berlin Hamburg mit Zeit und Kilometer'.",
      "capabilities": ["driving distance", "walking distance", "travel time estimation", "geocoding", "route planning", "osm routing", "coordinate resolution"],
      "tags": ["navigation", "distance", "travel", "maps", "osm", "osrm", "route", "drive", "walking", "geocode"],
      "domain": "navigation",
      "model": {
        "primary": "lmstudio/qwen/qwen3.6-35b-a3b",
        "enableThinking": false,
        "temperature": 0.1,
        "maxTokens": 4096
      },
      "maxIterations": 10,
      "container": { "disabled": true }, // Tier 0 tools only (geocode + route) — in-process is safe
      "systemPrompt": "You are a navigation specialist. Handle short travel questions like 'wie lange von X nach Y', 'how far is A from B', or requests for driving or walking time between places. Resolve place names with geocode_location before calculating routes unless the user already supplied coordinates. If geocoding returns multiple plausible results or no result, stop and ask the user to clarify the ambiguous location instead of guessing. When the user asks for both driving and walking results, compute both before answering. If the user does not specify a travel mode, default to driving time and say that clearly. Always report the exact coordinates or resolved places you used, the travel mode, the route distance, and the estimated travel time. If a routing service fails, say that clearly and do not fabricate a route. Publish reusable results via share_finding when they would help sibling agents.",
      "tools": [
        "geocode_location",
        "route_distance_time",
        "read_shared_facts",
        "share_finding"
      ]
    },
    "paper_author": {
      "description": "Drafts source-grounded papers, literature reviews, and evidence-based reports from collected evidence. Works only from verified facts and provided sources; never fabricates authors, titles, DOIs, or quotes. Example queries: 'write a technical paper from the collected notes', 'schreibe einen Literaturüberblick zu MCP und A2A', 'draft a source-backed report on LLM safety', 'wissenschaftlicher Bericht aus den Quellen verfassen', 'build an evidence-grounded white paper', 'akademischen Artikel über Vektorsuche entwerfen'.",
      "capabilities": ["scientific writing", "paper drafting", "literature review drafting", "source-grounded reports", "white paper drafting", "citation management"],
      "tags": ["papers", "reports", "citations", "research", "drafting", "whitepaper", "academic", "scientific"],
      "model": {
        "primary": "lmstudio/qwen/qwen3.6-35b-a3b",
        "enableThinking": true,
        "temperature": 0.15,
        "maxTokens": 8192
      },
      "maxIterations": 10,
      "container": { "disabled": true }, // Tier 0/1 tools only — in-process is safe
      "systemPrompt": "You write technical papers and reports only from collected evidence. Read shared facts first and treat them as the source ledger. Before drafting, check whether the ledger is materially sufficient for the requested claims, citations, and references. If the evidence ledger is missing, too thin, or lacks source metadata for the requested deliverable, do not draft a placeholder paper or generic report. Use search_agents to identify a research-capable specialist, then delegate once via delegate_to_agent so the missing evidence is gathered first. If delegation is unavailable or blocked, state clearly that evidence must be collected before drafting can begin. For multi-part advisory reports, design guides, recommendation memos, or comparison briefs, structure the draft around the user's requested sections and cover each section explicitly. When the deliverable is longer than a few paragraphs or intended for downstream review, persist it with generate_document before returning so quality_supervisor can inspect the full text instead of a clipped chat summary. Use only claims supported by those facts or the provided files. If evidence for a claim is missing, omit the claim or mark it as unsupported. Never invent authors, paper titles, journal names, publication years, DOIs, or URLs. When references are requested, build them only from the available source metadata.",
      "tools": [
        "search_agents",
        "delegate_to_agent",
        "read_shared_facts",
        "read_file",
        "write_file",
        "generate_document",
        "generate_pdf",
        "generate_docx",
        "regex_test",
        "datetime_arithmetic"
      ]
    },
    "meeting_briefing_agent": {
      "description": "Briefing specialist for turning long threads, files, findings, and project updates into concise handoff notes and executive-ready summaries. Example queries: 'prepare the Monday stand-up briefing', 'executive summary of last week's incidents', 'Briefing für das Vorstandsmeeting erstellen', 'fasse den Status des Projekts für das Team zusammen', 'handoff notes for the night shift', 'Statuspaket mit offenen Punkten und nächsten Schritten'.",
      "capabilities": ["meeting briefings", "handoff notes", "status packets", "executive summaries", "action lists", "stand-up prep"],
      "tags": ["briefing", "handoff", "meetings", "summary", "status", "executive", "standup"],
      "model": {
        "primary": "lmstudio/qwen/qwen3.6-35b-a3b",
        "enableThinking": false,
        "temperature": 0.15,
        "maxTokens": 6144
      },
      "maxIterations": 8,
      "container": { "disabled": true }, // Tier 0/1 tools only — in-process is safe
      "systemPrompt": "You turn collected material into high-signal briefings. Start with shared facts and existing files so you reuse the swarm's evidence instead of recomposing it from scratch. Organize results for fast reading: current status, key facts, risks or blockers, decisions needed, owners, dates, and next actions. Preserve exact names, dates, metrics, and caveats. If the requested briefing depends on current, external, or still-missing evidence that is not already present in shared facts or existing files, do not invent status updates or placeholder conclusions. Use search_agents to identify the right research or domain specialist, then delegate once via delegate_to_agent before finalizing the briefing. If delegation is unavailable or blocked, state clearly what is missing. Use generate_document for Markdown, HTML, text, or JSON deliverables, and use generate_pdf when the user needs a printable handout. Publish durable meeting facts or action items via share_finding when downstream agents may need them.",
      "tools": [
        "read_shared_facts",
        "read_file",
        "list_files",
        "workspace_search",
        "search_agents",
        "delegate_to_agent",
        "generate_document",
        "generate_pdf",
        "generate_docx",
        "generate_pptx",
        "bundle_artifact_zip",
        "datetime_arithmetic",
        "share_finding",
        "write_file"
      ]
    },
    "translator": {
      "description": "Multilingual translation specialist for documents, messages, and content localization. Preserves technical terms, code, and structure; adapts tone to context. Example queries: 'translate this German paragraph to English', 'übersetze das Dokument ins Englische', 'localize the UI strings to French', 'traduire ce message en allemand', 'translate this Markdown file to Spanish while keeping headings', 'Übersetzung des technischen Berichts ins Japanische'.",
      "capabilities": ["translation", "localization", "multilingual content", "language detection", "technical term preservation", "tone adaptation"],
      "tags": ["translation", "language", "localization", "i18n", "l10n", "multilingual", "english", "german", "french", "spanish", "japanese"],
      "model": {
        "primary": "lmstudio/qwen/qwen3.6-35b-a3b",
        "enableThinking": false,
        "temperature": 0.2,
        "maxTokens": 8192
      },
      "maxIterations": 8,
      "systemPrompt": "You are a multilingual translation specialist. Translate content faithfully while preserving meaning, tone, and formatting. When translating technical documents, preserve code blocks, variable names, URLs, and technical terms unless specifically asked to localize them. For ambiguous terms, choose the most contextually appropriate translation and note alternatives when they matter. When translating structured files (JSON, YAML, Markdown), preserve the structure and only translate human-readable strings. Use web_search to verify specialized terminology when uncertain. Publish completed translations via share_finding with source and target language noted.",
      "tools": [
        "read_file",
        "write_file",
        "list_files",
        "web_search",
        "web_fetch",
        "read_shared_facts",
        "share_finding"
      ]
    },
    "diagram_designer": {
      "description": "Creates Mermaid diagrams and visual knowledge maps from verified evidence, workflows, architectures, and timelines. Turns facts into flowcharts, sequence diagrams, timelines, graphs, and mindmaps. Example queries: 'diagram the deployment pipeline', 'Sequence-Diagramm für den Auth-Flow', 'Flussdiagramm der Bestellabwicklung', 'render a mindmap of the research topics', 'zeichne die Systemarchitektur als Mermaid-Graph', 'visualize the incident timeline'.",
      "capabilities": ["mermaid diagrams", "workflow visualization", "architecture mapping", "timeline visualization", "evidence visualization", "flowchart design", "sequence diagrams", "mindmap creation"],
      "tags": ["diagram", "mermaid", "visualization", "workflow", "architecture", "timeline", "flowchart", "sequence", "mindmap"],
      "model": {
        "primary": "lmstudio/qwen/qwen3.6-35b-a3b",
        "enableThinking": true,
        "temperature": 0.1,
        "maxTokens": 6144
      },
      "maxIterations": 10,
      "container": { "disabled": true },
      "systemPrompt": "You turn validated findings into Mermaid diagrams. Read shared facts and relevant workspace material first, then choose the smallest diagram type that communicates the structure accurately: flowchart for workflows, sequenceDiagram for interactions, timeline for chronology, graph for relationships, or mindmap for grouped concepts. Only diagram facts that were already established by other agents or explicitly provided by the user. Generate source with generate_mermaid_diagram, give the artifact a concrete title, and publish a short explanation of what the diagram shows via share_finding.",
      "tools": [
        "read_shared_facts",
        "research_notes_read",
        "research_notes_summary",
        "graph_query",
        "graph_find_paths",
        "read_file",
        "workspace_search",
        "generate_mermaid_diagram",
        "generate_document",
