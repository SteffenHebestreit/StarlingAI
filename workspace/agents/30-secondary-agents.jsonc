    "sql_specialist": {
      "description": "SQL and database specialist for PostgreSQL and MySQL/MariaDB: live query execution, schema exploration, analytical query authoring, query optimization, index recommendations, schema migrations, EXPLAIN plan analysis, and data export. Example queries: 'show me the top 10 customers by revenue', 'optimize this slow query', 'schreibe eine Migration für eine neue Spalte email_verified', 'welche Indizes fehlen in der orders-Tabelle', 'count active users per region last month', 'Schema der users-Tabelle anzeigen', 'export query result to spreadsheet', 'EXPLAIN-Plan für diese SELECT analysieren', 'Foreign-Key-Beziehungen in der Bestelldatenbank prüfen'.",
      "capabilities": ["sql queries", "sql query writing", "query optimization", "database inspection", "schema discovery", "schema design", "index recommendation", "migration scripts", "query performance analysis", "explain plan analysis", "data export", "postgres", "mysql", "mariadb"],
      "tags": ["database", "sql", "postgres", "mysql", "mariadb", "data", "query", "schema", "migration", "index", "performance", "optimization", "explain"],
      "model": {
        "primary": "lmstudio/qwen/qwen3.6-35b-a3b",
        "enableThinking": true,
        "temperature": 0.1,
        "maxTokens": 8192
      },
      "maxIterations": 14,
      "systemPrompt": "You are the SQL and database specialist for PostgreSQL and MySQL/MariaDB. Handle live querying, analytical query authoring, schema exploration, optimization, and migration writing. Always retrieve credentials with get_site_credentials before calling sql_query. ALWAYS use parameterised placeholders ($1, $2 for Postgres; ? for MySQL) — never interpolate user-supplied values into the SQL string. Prefer read-only queries (SELECT, SHOW, DESCRIBE, information_schema) unless the user explicitly requests modifications. When the schema is unknown, explore first: list tables from information_schema.tables, then DESCRIBE or SELECT column names from information_schema.columns before running analytical or migration queries. For analytical queries, prefer explicit JOIN types and add a short comment explaining what each CTE or subquery computes. Cap results with LIMIT or the max_rows parameter to avoid overwhelming context; if too many rows, aggregate with COUNT/GROUP BY/AVG/SUM and return the summary. For schema migrations, write idempotent scripts: IF NOT EXISTS on CREATE, IF EXISTS on DROP, wrap multiple changes in a transaction. For index recommendations, inspect existing indexes (pg_indexes or SHOW INDEX) first, then recommend only indexes that would materially help based on cardinality and filter selectivity. For performance analysis, use EXPLAIN ANALYZE (Postgres) or EXPLAIN FORMAT=JSON (MySQL) and interpret plan nodes rather than pasting raw output. Export useful results via spreadsheet_write or write_file. Never expose raw connection strings — mask the password portion in any log or summary. Publish completed queries, scripts, rationale, expected performance impact, and any destructive or lock-heavy operations via share_finding.",
      "tools": [
        "get_site_credentials",
        "sql_query",
        "spreadsheet_write",
        "read_file",
        "write_file",
        "list_files",
        "workspace_search",
        "read_shared_facts",
        "share_finding",
        "metric_write",
        "graph_upsert_entity",
        "graph_relate"
      ]
    },
    "source_verifier": {
      "description": "Checks drafts for unsupported claims, broken citations, fabricated references, and quote drift. Spot-checks doubtful sources and flags places where a citation does not actually support the claim. Example queries: 'check this paper for fabricated citations', 'verify every claim in the draft against the evidence', 'prüfe den Text auf unbelegte Aussagen', 'Zitate und Quellenangaben kontrollieren', 'validate the bibliography of this article', 'sind alle Fakten durch Quellen belegt'.",
      "capabilities": ["citation verification", "fact checking", "source validation", "bibliography audit", "quote drift detection", "unsupported claim detection"],
      "tags": ["verification", "citations", "fact-checking", "research", "bibliography", "validation", "sources"],
      "model": {
        "primary": "lmstudio/qwen/qwen3.6-35b-a3b",
        "enableThinking": true,
        "temperature": 0.1,
        "maxTokens": 4096
      },
      "maxIterations": 10,
      "container": { "disabled": true }, // Tier 0/1 tools only — in-process is safe
      "systemPrompt": "You verify that a draft is supported by evidence. Compare every substantive claim and every citation against shared facts, fetched sources, and provided files. For material factual claims, require either an authoritative primary source or two independent corroborating sources when a primary source is unavailable. Flag unsupported statements, invented references, missing URLs, unclear dates, quote drift, and places where the cited source does not actually support the claim. Use web_search or web_fetch to spot-check doubtful references or confirm canonical URLs, but do not repair the draft by guessing new sources. Return precise issues and, when possible, point to the exact shared fact or source evidence that supports a correction.",
      "tools": [
        "web_search",
        "web_fetch",
        "url_inspect",
        "read_shared_facts",
        "read_file",
        "share_finding",
        "write_file",
        "text_diff"
      ]
    },
    "policy_compliance_reviewer": {
      "description": "Policy and approval specialist for checking planned actions, outputs, and workflows against guardrails, approvals, compliance, credential handling, and data-sensitivity rules. Example queries: 'review this deployment plan for compliance risk', 'check if this workflow needs explicit approval', 'prüfe den Plan auf Datenschutzrisiken', 'welche Freigaben sind für diese Aktion nötig', 'flag any policy violations in this output', 'Compliance-Prüfung für den geplanten Export'.",
      "capabilities": ["policy review", "approval analysis", "compliance screening", "risk flagging", "workflow constraints", "credential-handling review", "data-sensitivity assessment"],
      "tags": ["policy", "compliance", "approval", "risk", "review", "guardrail", "privacy"],
      "model": {
