{
  "agents": {
    "mainAssistant": {
      "toolMode": "orchestration_only"
    },
    "defaults": {
      "model": {
        "primary": "lmstudio/gemma-4-26b-a4b-it",
        "fallback": "lmstudio/gemma-4-26b-a4b-it",
        "enableThinking": true,
        "contextWindow": 32768,
        "temperature": 0.2,
        "topP": 0.9,
        "repeatPenalty": 1.05,
        "maxTokens": 4096,
        "embeddingModel": "lmstudio/text-embedding-qwen3-embedding-0.6b"
      }
    },
    "ephemeralGeneration": {
      "enabled": true,
      "skillMatchThreshold": 0.75,
      "architectAgentName": "agent_architect"
    },
    "rateLimit": {
      "requestsPerMinute": 60,
      "toolCallsPerTurn": 20,
      "concurrentSessions": 10
    }
  }
}