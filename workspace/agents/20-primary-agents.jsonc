      "capabilities": ["calendar management", "event creation", "event scheduling", "meeting management", "contacts management", "address book", "CalDAV", "CardDAV", "conflict detection", "recurring events"],
      "tags": ["calendar", "contacts", "meetings", "appointments", "scheduling", "address-book", "caldav", "carddav", "nextcloud", "fastmail", "icloud", "events", "invite"],
      "model": {
