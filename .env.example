# Required core secrets. `pnpm setup` populates these automatically when missing.
SAI_MASTER_KEY=your-256-bit-master-key-for-credential-encryption
POSTGRES_PASSWORD=your-secure-postgres-password

# Optional JWT signing secret.
# If omitted, StarlingAI resolves one from:
#   1. SAI_JWT_SECRET
#   2. ./.starlingai/.jwt_secret
#   3. ~/.starlingai/.jwt_secret
# SAI_JWT_SECRET=your-256-bit-jwt-secret-here-min-32-chars

# Provider and channel secrets referenced from starlingai.json.
TELEGRAM_BOT_TOKEN=
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_APP_TOKEN=
DISCORD_BOT_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
ANTHROPIC_API_KEY=
# Claude subscription (Pro/Max) instead of API pay-per-use: paste the OAuth
# token from `claude setup-token` (starts with sk-ant-oat). When set it wins
# over ANTHROPIC_API_KEY and unlocks the dashboard "Local ⇄ Claude" switch.
CLAUDE_CODE_OAUTH_TOKEN=
N8N_API_KEY=

# Example multi-account mail credentials referenced by config/mail/accounts.example.json.
MAIL_WORK_USER=
MAIL_WORK_PASS=
MAIL_PERSONAL_USER=
MAIL_PERSONAL_PASS=

# Site credentials.
FREELANCEMAP_PASSWORD=
N8N_PASSWORD=
# GITHUB_PASSWORD=

# fastapi-mcp-template (OCR / image analysis).
# Set FTMD_OPENAI_MODEL to a vision-capable model loaded in LM Studio for image OCR.
# Use the publisher-prefixed LM Studio model id (e.g. "qwen/qwen3.6-35b-a3b"
# or a vision model like "qwen/qwen2-vl-7b-instruct"). No "lmstudio/" prefix
# here — this string is forwarded straight to the LM Studio OpenAI API.
# FTMD_OPENAI_BASE_URL=http://host.docker.internal:1234/v1
# FTMD_OPENAI_MODEL=qwen/qwen3.6-35b-a3b

# ── Document RAG (engram graph-RAG) + cross-encoder reranker ──────────────────
# Attached/uploaded files are extracted to Markdown by the fastapi-mcp-template
# and ingested into engram (docker-compose services: engram, engram-neo4j,
# reranker). Embeddings + the extraction LLM run on LM Studio; cross-encoder
# reranking (bge-reranker-v2-m3) is served by the TEI `reranker` sidecar, which
# the gateway's retrieval.reranker uses too. Defaults work out of the box; these
# only override them.
#
# engram's embeddings/LLM endpoints default to the gateway's SAI_LMSTUDIO_URL
# (the instance with the models loaded). Override the model ids if your LM Studio
# uses different ids than the defaults below.
# ENGRAM_EMBEDDING_MODEL=text-embedding-bge-m3
# ENGRAM_EMBEDDING_DIM=1024
# ENGRAM_LLM_MODEL=qwen/qwen3.6-35b-a3b
# Set true ONLY if your OpenAI-compatible server supports response_format=json_object
# (LM Studio does not — it wants json_schema/text — so leave this false).
# ENGRAM_LLM_JSON_MODE=false
# Neo4j password for engram's graph store (min 4 chars; the compose lowers Neo4j's
# 8-char default to allow engram's documented "engram").
# ENGRAM_NEO4J_PASSWORD=engram
# Reranker model served by the TEI sidecar (used by both engram and the gateway).
# RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# Optional HF token if the reranker model is gated/private.
# HUGGINGFACE_HUB_TOKEN=

# Memory limits for the gateway and web containers. Override if you run a
# bigger workload (the gateway holds Postgres pools, agent caches, and tool
# pipelines) or you need to fit StarlingAI alongside other services on a
# constrained host. See docker-compose.yml.
# SAI_GATEWAY_MEM_LIMIT=4g
# SAI_WEB_MEM_LIMIT=256m

# Model backend (the guided setup wizard writes these). Pick ONE shape:
#   - OpenAI-compatible endpoint you run (LM Studio, vLLM, llama.cpp, OpenAI):
#       SAI_LMSTUDIO_URL + SAI_LMSTUDIO_API_KEY, SAI_DEFAULT_MODEL=lmstudio/<id>
#   - Anthropic: ANTHROPIC_API_KEY (above) + SAI_DEFAULT_MODEL=anthropic/<id>
#   - Local Ollama (auto-pulled via docker-compose.ollama.yml):
#       SAI_MODEL_BACKEND=ollama, SAI_OLLAMA_MODEL=<tag>,
#       SAI_LMSTUDIO_URL=http://ollama:11434/v1, SAI_DEFAULT_MODEL=lmstudio/<tag>
# SAI_DEFAULT_MODEL=lmstudio/qwen/qwen3.6-35b-a3b
# SAI_MODEL_BACKEND=openai-compatible
# SAI_OLLAMA_MODEL=qwen2.5:7b

# Optional overrides.
# SAI_LMSTUDIO_URL=http://host.docker.internal:1234/v1
# SAI_LMSTUDIO_API_KEY=
# SAI_MAIL_SERVICE_URL=http://mail-service:5020
# SAI_MAIL_SERVICE_TIMEOUT_MS=20000
# SAI_MAIL_SERVICE_TOKEN=
# For standalone mail-service runs outside Docker Compose:
# SAI_MAIL_SERVICE_CONFIG_PATH=./config/mail/accounts.example.json
# SAI_MAIL_SERVICE_DATA_PATH=./.starlingai/mail-service.json
# SAI_AUDIT_LOG=./.starlingai/audit.jsonl
# SAI_CRED_STORE=./.starlingai/credentials.enc
# LOG_LEVEL=info
# SAI_GATEWAY_PORT=8765

# Web search backends (researcher agent requires at least one).
# In retrieval.search.backend=auto mode, StarlingAI prefers SearXNG when configured
# and falls back to DuckDuckGo otherwise.
# The stack now BUNDLES its own SearXNG service (docker-compose `searxng`), so
# SEARXNG_BASE_URL defaults to http://searxng:8080 and nothing is required here.
# To use an EXTERNAL instance instead (e.g. a homelab one), set it explicitly:
# SEARXNG_BASE_URL=http://search.k2o
# Cookie/CSRF signing key for the bundled instance (internal-only; optional).
# SEARXNG_SECRET=change-me-if-you-expose-searxng
