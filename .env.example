# StarlingAI environment — copy to .env and fill in.
#
#   cp .env.example .env
#
# .env is GITIGNORED — put every real secret/credential here, never in the
# docker-compose files. The gateway and mail-service load this whole file via
# `env_file: - .env`, so anything defined here reaches those containers at
# runtime (and any `$VAR` referenced by starlingai.json / channel configs
# resolves from it). Do NOT re-list these under a service's `environment:` block
# in compose — that block is reserved for infra/computed values only.
# Leave a var blank to keep that integration disabled.

# ── Core secrets (REQUIRED) ───────────────────────────────────────────────────
# Generate each with:  openssl rand -hex 32
SAI_MASTER_KEY=
SAI_JWT_SECRET=

# ── Model backend (LM Studio / OpenAI-compatible) ─────────────────────────────
SAI_LMSTUDIO_URL=http://host.docker.internal:1234/v1
SAI_LMSTUDIO_API_KEY=lm-studio
SAI_DEFAULT_MODEL=lmstudio/qwen/qwen3.6-35b-a3b
SAI_MODEL_BACKEND=openai-compatible

# ── Database / graph passwords ────────────────────────────────────────────────
# POSTGRES_PASSWORD is used at compose time (baked into the gateway DATABASE_URL
# and the postgres init) — keep it set.
POSTGRES_PASSWORD=
# Memgraph runs without auth by default; leave blank unless you enabled it.
MEMGRAPH_PASSWORD=
# Neo4j password for the engram graph store (default "engram" if unset).
#ENGRAM_NEO4J_PASSWORD=engram

# ── Anthropic / Claude (optional) ─────────────────────────────────────────────
ANTHROPIC_API_KEY=
# sk-ant-oat… from `claude setup-token` (bills the Claude subscription).
CLAUDE_CODE_OAUTH_TOKEN=

# ── Chat channel tokens (optional — set the ones you use) ─────────────────────
TELEGRAM_BOT_TOKEN=
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_SIGNING_SECRET=
DISCORD_BOT_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# ── Email channel (IMAP/SMTP) — the gateway's inbound/outbound email CHANNEL, ──
#    separate from the mail-service MAIL_* accounts further down.
EMAIL_IMAP_USER=
EMAIL_IMAP_PASSWORD=
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=

# ── Web search (optional) ─────────────────────────────────────────────────────
BRAVE_API_KEY=

# ── Integrations (optional) ───────────────────────────────────────────────────
N8N_API_KEY=
N8N_PASSWORD=
N8N_USERNAME=
N8N_KEY=
# GitHub password/PAT for the git integration; ops webhook bearer token.
GITHUB_PASSWORD=
OPS_WEBHOOK_TOKEN=
# Proxmox API token secret for the infrastructure tooling.
PROXMOX_TOKEN_SECRET=

# ── Site credentials referenced by starlingai.json $VAR (optional) ────────────
FREELANCEMAP_PASSWORD=

# ── Mail accounts (referenced by config/mail/accounts.json $VAR) ──────────────
MAIL_WORK_USER=
MAIL_WORK_PASS=
MAIL_PERSONAL_USER=
MAIL_PERSONAL_PASS=
# Shared bearer token between the gateway and the mail-service (blank = no auth).
SAI_MAIL_SERVICE_TOKEN=

# ── Remote-access credentials (optional) ──────────────────────────────────────
# SSH password for an n8n SSH site / RDP credentials for a Windows workstation
# (referenced by starlingai.json); leave blank if unused.
SAI_N8N_SSH_PASSWORD=
SAI_WIN_WORKSTATION_RDP_CREDENTIALS=
# Bearer token for the computer-remote sidecar (gateway must send the same value).
SAI_COMPUTER_REMOTE_TOKEN=

# ── HuggingFace token (optional) ──────────────────────────────────────────────
# Only needed to download GATED models in the reranker / optional vLLM
# model-servers overlay. The default bge-reranker is public, so leave blank.
HUGGINGFACE_HUB_TOKEN=
#HF_TOKEN=

# ── Scheduled-job & scene webhook auth keys (optional) ────────────────────────
# Each scheduled job / scene can require a secret on its external webhook
# trigger. Set a random value (openssl rand -hex 16) to require auth on that
# trigger; leave unset to keep the trigger unauthenticated. Referenced from
# workspace/jobs/*.jsonc and workspace/scenes/*.jsonc.
#JOB_MORNING_BRIEFING_KEY=
#JOB_DEEP_RESEARCH_PACKET_KEY=
#JOB_COMPETITIVE_SNAPSHOT_KEY=
#JOB_DAILY_OPS_BRIEF_KEY=
#JOB_INCIDENT_POSTMORTEM_KEY=
#JOB_RELEASE_BROADCAST_KEY=
#JOB_WEEKLY_SECURITY_DIGEST_KEY=
#JOB_CONTENT_PIPELINE_KEY=
#JOB_DATABASE_ANALYSIS_KEY=
#JOB_DATA_QUALITY_REPORT_KEY=
#JOB_ONBOARDING_DELIVERY_KEY=
#JOB_RESEARCH_VISUAL_DIGEST_KEY=
#JOB_SCHEDULED_CODE_REVIEW_KEY=
#SCENE_APPLY_JOBS_KEY=

# ── Optional non-secret overrides (uncomment to change a default) ─────────────
#LOG_LEVEL=info
#SEARXNG_BASE_URL=http://searxng:8080
#SAI_GATEWAY_MEM_LIMIT=4g
#SAI_WEB_MEM_LIMIT=256m
#ENGRAM_EXTRACTION_CONCURRENCY=1
#ENGRAM_EMBEDDING_CONCURRENCY=2
#ENGRAM_LLM_MODEL=qwen/qwen3.6-35b-a3b
#FTMD_OPENAI_MODEL=qwen/qwen3.6-35b-a3b
#PENTEST_SCOPE=192.168.1.0/24
