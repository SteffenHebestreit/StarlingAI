# Required core secrets. `pnpm setup` populates these automatically when missing.
SAI_MASTER_KEY=your-256-bit-master-key-for-credential-encryption
POSTGRES_PASSWORD=your-secure-postgres-password

# Optional JWT signing secret.
# If omitted, StarlingAI resolves one from:
#   1. SAI_JWT_SECRET
#   2. ./.starlingai/.jwt_secret
#   3. ~/.starlingai/.jwt_secret
# SAI_JWT_SECRET=your-256-bit-jwt-secret-here-min-32-chars

# Provider and channel secrets referenced from starlingai.json.
TELEGRAM_BOT_TOKEN=
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_APP_TOKEN=
DISCORD_BOT_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
ANTHROPIC_API_KEY=
# Claude subscription (Pro/Max) instead of API pay-per-use: paste the OAuth
# token from `claude setup-token` (starts with sk-ant-oat). When set it wins
# over ANTHROPIC_API_KEY and unlocks the dashboard "Local ⇄ Claude" switch.
CLAUDE_CODE_OAUTH_TOKEN=
N8N_API_KEY=

# Example multi-account mail credentials referenced by config/mail/accounts.example.json.
MAIL_WORK_USER=
MAIL_WORK_PASS=
MAIL_PERSONAL_USER=
MAIL_PERSONAL_PASS=

# Site credentials.
FREELANCEMAP_PASSWORD=
N8N_PASSWORD=
# GITHUB_PASSWORD=

# fastapi-mcp-template (OCR / image analysis).
# Set FTMD_OPENAI_MODEL to a vision-capable model loaded in LM Studio for image OCR.
# Use the publisher-prefixed LM Studio model id (e.g. "qwen/qwen3.6-35b-a3b"
# or a vision model like "qwen/qwen2-vl-7b-instruct"). No "lmstudio/" prefix
# here — this string is forwarded straight to the LM Studio OpenAI API.
# FTMD_OPENAI_BASE_URL=http://host.docker.internal:1234/v1
# FTMD_OPENAI_MODEL=qwen/qwen3.6-35b-a3b

# ── Document RAG (engram graph-RAG) + cross-encoder reranker ──────────────────
# The RAG stack (engram + reranker) is OFF by default (the reranker reserves an
# NVIDIA GPU, which would abort `docker compose up` on a GPU-less machine). Turn it
# on with `sai start --rag`, or persist it here:
# SAI_ENABLE_RAG=1
# `sai start` uses the GPU automatically when one is present (else CPU). Force with
# SAI_GPU=1 / disable with SAI_GPU=0.
#
# When on: attached/uploaded files are extracted to Markdown by the
# fastapi-mcp-template and ingested into engram. Embeddings + the extraction LLM run
# on your model server; cross-encoder reranking (Qwen3-Reranker-0.6B) is served by
# the `reranker` sidecar, shared with the gateway's retrieval.reranker. These only
# override the defaults.
#
# engram version to clone+build (a release tag of github.com/SteffenHebestreit/engram).
# Bump this to update engram, then rebuild: `docker compose build engram && docker compose
# up -d engram` (the tag change re-clones; the git layer is otherwise cached).
# ENGRAM_REF=v0.9.0
#
# fastapi_mcp_template (file-to-markdown conversion service) commit to build. Pin to an
# immutable SHA — tracking `main` silently freezes on a cached clone. Bump to the new
# upstream HEAD, then: `docker compose build fastapi-mcp-template && docker compose up -d
# fastapi-mcp-template`.
# FASTAPI_MCP_TEMPLATE_REF=958dc13ec87751694117fe3f5a85b624f539e2b6
# Store backend. Default = engramdb (embedded, in-process, no Neo4j server, fastest
# at every scale; f16 quantization = lossless ranking at ½ vector memory). Other
# options: neo4j or pgvector (each needs its own database service + connection config).
# ENGRAM_STORE_BACKEND=engramdb
# ENGRAM_ENGRAMDB_QUANTIZATION=f16
#
# engram's embeddings/LLM endpoints default to the gateway's SAI_LMSTUDIO_URL
# (the instance with the models loaded). Override the model ids if your LM Studio
# uses different ids than the defaults below. NOTE: Qwen3-Embedding is instruction-
# tuned — the compose sets QUERY_INSTRUCTION; switching embedders changes stored
# vectors (re-ingest / wipe). bge-m3 (no instruction) is the alternative.
# ENGRAM_EMBEDDING_MODEL=text-embedding-qwen3-embedding-0.6b
# ENGRAM_EMBEDDING_DIM=1024
# OPTIONAL local-GPU embedding fallback: if your external embedding provider (LM
# Studio) is flaky/unavailable, the `reranker` sidecar can also serve Qwen3-Embedding
# on the GPU. Enable BOTH lines to embed locally instead of LM Studio (re-ingest, as
# vectors change). Off by default. ~1.2GB extra GPU.
# RERANKER_EMBED_MODEL=Qwen/Qwen3-Embedding-0.6B
# ENGRAM_EMBEDDING_API_BASE=http://reranker:80/v1
# ENGRAM_LLM_MODEL=qwen/qwen3.6-35b-a3b
# Set true ONLY if your OpenAI-compatible server supports response_format=json_object
# (LM Studio does not — it wants json_schema/text — so leave this false).
# ENGRAM_LLM_JSON_MODE=false
# Reranker = Qwen3-Reranker-0.6B served by the shared GPU `reranker` sidecar
# (docker/reranker-qwen): a causal-LM reranker that TEI/LM-Studio can't serve in the
# /rerank format. The SAME sidecar serves both engram and the gateway.
# RERANKER_MODEL=Qwen/Qwen3-Reranker-0.6B
# Optional HF token if a reranker/embedding model is gated/private.
# HUGGINGFACE_HUB_TOKEN=

# Memory limits for the gateway and web containers. Override if you run a
# bigger workload (the gateway holds Postgres pools, agent caches, and tool
# pipelines) or you need to fit StarlingAI alongside other services on a
# constrained host. See docker-compose.yml.
# SAI_GATEWAY_MEM_LIMIT=4g
# SAI_WEB_MEM_LIMIT=256m

# Primary model provider — the OpenAI-compatible server your agents use by default. It is
# NOT tied to LM Studio: it can be LM Studio, Ollama, vLLM, llama.cpp, LocalAI, or a remote/
# homelab box. The guided setup wizard writes these. (SAI_LMSTUDIO_URL / SAI_LMSTUDIO_API_KEY /
# SAI_DEFAULT_MODEL remain as back-compat aliases — the SAI_PRIMARY_MODEL_* names win.)
#   SAI_PRIMARY_MODEL_URL  — the provider's OpenAI-compatible /v1 base URL
#   SAI_PRIMARY_MODEL_KEY  — its API key (LM Studio: any placeholder; others as required)
#   SAI_PRIMARY_MODEL      — default agent model id. The neutral prefix primary/<id> (or
#                            local/<id>) routes to the primary provider slot; lmstudio/<id>
#                            is the back-compat equivalent. (anthropic/<id> for Claude.)
# Examples:
#   - LM Studio / vLLM / llama.cpp on THIS Docker host: http://host.docker.internal:1234/v1
#   - Model server on ANOTHER box (homelab):            http://192.168.1.50:1234/v1
#   - Ollama:                                           http://host.docker.internal:11434/v1
#   - Anthropic instead: set ANTHROPIC_API_KEY (above) + SAI_PRIMARY_MODEL=anthropic/<id>
# SAI_PRIMARY_MODEL_URL=http://host.docker.internal:1234/v1
# SAI_PRIMARY_MODEL_KEY=lm-studio
# SAI_PRIMARY_MODEL=lmstudio/qwen/qwen3.6-35b-a3b
# SAI_MODEL_BACKEND=openai-compatible
# SAI_OLLAMA_MODEL=qwen2.5:7b
#
# The config ships with the embedding, fallback, and routing-tier models pinned to
# specific Qwen ids. If your backend doesn't serve those (e.g. Anthropic, or an
# Ollama/LM Studio box without them), override each here — set a tier to EMPTY to
# DISABLE it (embeddings → keyword-only RAG; routing → the full path, no fast-lane)
# rather than leaving a pin the endpoint can't resolve. SAI_PRIMARY_MODEL alone also
# seeds the fallback, so you only need SAI_FALLBACK_MODEL for a distinct fallback.
#   SAI_FALLBACK_MODEL   — model used when the primary call fails (defaults to primary)
#   SAI_EMBEDDING_MODEL  — vector-embedding model for document RAG + semantic memory
#   SAI_ROUTING_MODEL    — small/fast model for the receptionist fast-lane
# The setup wizard fills these in for you (empty for Anthropic/Ollama). Example:
# SAI_FALLBACK_MODEL=anthropic/claude-haiku-4-6
# SAI_EMBEDDING_MODEL=
# SAI_ROUTING_MODEL=

# Optional overrides.
# Where your OpenAI-compatible model server (LM Studio / llama.cpp / vLLM) lives.
# Default reaches one on THIS machine; change the host for a model server elsewhere.
SAI_LMSTUDIO_URL=http://host.docker.internal:1234/v1
# SAI_LMSTUDIO_API_KEY=
# SAI_MAIL_SERVICE_URL=http://mail-service:5020
# SAI_MAIL_SERVICE_TIMEOUT_MS=20000
# SAI_MAIL_SERVICE_TOKEN=
# For standalone mail-service runs outside Docker Compose:
# SAI_MAIL_SERVICE_CONFIG_PATH=./config/mail/accounts.example.json
# SAI_MAIL_SERVICE_DATA_PATH=./.starlingai/mail-service.json
# SAI_AUDIT_LOG=./.starlingai/audit.jsonl
# SAI_CRED_STORE=./.starlingai/credentials.enc
# LOG_LEVEL=info
# SAI_GATEWAY_PORT=8765

# Host interface the published ports bind to. Defaults to 127.0.0.1 (localhost only)
# so a fresh install is NOT reachable from the network out of the box. To expose the
# gateway/dashboard to other machines, set this to 0.0.0.0 (or a specific interface IP)
# — and ONLY do so with multi-user auth enabled (auth.enabled), since anyone who can
# reach the port otherwise has full operator access.
# SAI_BIND_HOST=127.0.0.1

# Web search backends (researcher agent requires at least one).
# In retrieval.search.backend=auto mode, StarlingAI prefers SearXNG when configured
# and falls back to DuckDuckGo otherwise.
# The stack now BUNDLES its own SearXNG service (docker-compose `searxng`), so
# SEARXNG_BASE_URL defaults to http://searxng:8080 and nothing is required here.
# To use an EXTERNAL instance instead (e.g. a homelab one), set it explicitly:
# SEARXNG_BASE_URL=http://searxng.example.com
# Cookie/CSRF signing key for the bundled instance (internal-only; optional).
# SEARXNG_SECRET=change-me-if-you-expose-searxng

# ── Identity / SSO (OpenID Connect, e.g. Keycloak) ────────────────────────────
# Leave unset to use the built-in username/password auth. Set SAI_AUTH_PROVIDER=oidc
# to turn on SSO: the login screen redirects to your IdP, and the IdP's roles map
# to our admin/operator/viewer (role mapping lives in config auth.oidc.roleMapping).
# A bundled, preconfigured Keycloak is available: `docker compose --profile keycloak up`.
# SAI_AUTH_PROVIDER=oidc
# SAI_OIDC_ISSUER=http://keycloak:8080/realms/starlingai
# SAI_OIDC_CLIENT_ID=starlingai
# SAI_OIDC_CLIENT_SECRET=your-keycloak-client-secret
# The gateway's public base URL — the OIDC redirect is {this}/api/auth/oidc/callback.
# SAI_OIDC_PUBLIC_URL=http://localhost:3001
# Enable A2A machine auth (client-credentials outbound + JWKS inbound) for peers
# that trust the same issuer. An audience is REQUIRED when enabled — it distinguishes
# peer service tokens from ordinary human tokens (without it, any realm-signed token
# would be accepted as an A2A caller).
# SAI_OIDC_A2A_ENABLED=false
# SAI_OIDC_A2A_AUDIENCE=starlingai-a2a

# ── Upload storage (S3-compatible) + malware scanning (ClamAV) ─────────────────
# Bundled + ON by default: uploads go to the bundled SeaweedFS over the S3 API and
# are virus-scanned by the bundled ClamAV before being stored/ingested. Override
# any of these to point at real AWS S3, keep files on local disk, or disable scan.
# SAI_STORAGE_BACKEND=s3                       # 's3' or 'local'
# SAI_S3_ENDPOINT=http://seaweedfs:8333        # leave EMPTY for real AWS S3
# SAI_S3_REGION=us-east-1
# SAI_S3_BUCKET=starlingai-uploads
# SAI_S3_ACCESS_KEY_ID=starlingai              # change for production / real AWS
# SAI_S3_SECRET_ACCESS_KEY=starlingai-dev-secret
# SAI_S3_FORCE_PATH_STYLE=true                 # true for SeaweedFS/MinIO, false for AWS S3
# SAI_UPLOAD_SCAN=true                         # false to disable ClamAV scanning
# SAI_CLAMD_HOST=clamav
# SAI_CLAMD_PORT=3310
