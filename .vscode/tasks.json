{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "core test suite",
			"type": "shell",
			"command": "source \"$HOME/.nvm/nvm.sh\" >/dev/null 2>&1 || true; nvm use --silent default >/dev/null 2>&1 || true; if command -v pnpm >/dev/null 2>&1; then pnpm --filter @starlingai/core test; else corepack pnpm --filter @starlingai/core test; fi",
			"options": {
				"shell": {
					"executable": "bash",
					"args": [
						"-lc"
					]
				}
			},
			"isBackground": false,
			"problemMatcher": [],
			"group": "test"
		},
		{
			"label": "docker compose ps debug",
			"type": "shell",
			"command": "docker",
			"args": [
				"compose",
				"ps"
			],
			"windows": {
				"command": "docker",
				"args": [
					"compose",
					"ps"
				],
				"options": {
					"shell": {
						"executable": "cmd.exe",
						"args": [
							"/d",
							"/c"
						]
					}
				}
			},
			"isBackground": false
		},
		{
			"label": "gateway health curl debug",
			"type": "shell",
			"command": "curl",
			"args": [
				"-i",
				"http://localhost:8765/healthz"
			],
			"windows": {
				"command": "curl.exe",
				"args": [
					"-i",
					"http://localhost:8765/healthz"
				],
				"options": {
					"shell": {
						"executable": "cmd.exe",
						"args": [
							"/d",
							"/c"
						]
					}
				}
			},
			"isBackground": false
		},
		{
			"label": "web head curl debug",
			"type": "shell",
			"command": "curl",
			"args": [
				"-I",
				"http://localhost:3001/"
			],
			"windows": {
				"command": "curl.exe",
				"args": [
					"-I",
					"http://localhost:3001/"
				],
				"options": {
					"shell": {
						"executable": "cmd.exe",
						"args": [
							"/d",
							"/c"
						]
					}
				}
			},
			"isBackground": false
		},
		{
			"label": "run core tests (powershell)",
			"type": "shell",
			"command": "pnpm --filter @starlingai/core test"
		},
		{
			"label": "core tests powershell",
			"type": "shell",
			"command": "powershell.exe -NoProfile -Command \"cd F:\\StarlingAI; pnpm --filter @starlingai/core test\""
		},
		{
			"label": "core tests ps",
			"type": "shell",
			"command": "pnpm --filter @starlingai/core test",
			"isBackground": false
		},
		{
			"label": "gateway inspect debug",
			"type": "shell",
			"command": "docker",
			"args": [
				"inspect",
				"--format",
				"{{.State.Status}} {{.State.ExitCode}} {{.State.Error}}",
				"starlingai-gateway-1"
			],
			"windows": {
				"command": "docker",
				"args": [
					"inspect",
					"--format",
					"{{.State.Status}} {{.State.ExitCode}} {{.State.Error}}",
					"starlingai-gateway-1"
				],
				"options": {
					"shell": {
						"executable": "cmd.exe",
						"args": [
							"/d",
							"/c"
						]
					}
				}
			},
			"isBackground": false
		},
		{
			"label": "gateway logs debug cmd",
			"type": "shell",
			"command": "cmd.exe",
			"args": [
				"/d",
				"/c",
				"docker logs starlingai-gateway-1 --tail 200"
			],
			"windows": {
				"command": "cmd.exe",
				"args": [
					"/d",
					"/c",
					"docker logs starlingai-gateway-1 --tail 200"
