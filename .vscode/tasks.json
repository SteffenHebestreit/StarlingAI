{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "core test suite",
			"type": "shell",
			"command": "source \"$HOME/.nvm/nvm.sh\" >/dev/null 2>&1 || true; nvm use --silent default >/dev/null 2>&1 || true; if command -v pnpm >/dev/null 2>&1; then pnpm --filter ./packages/core test; else corepack pnpm --filter ./packages/core test; fi",
			"windows": {
				"command": "powershell.exe",
				"args": [
					"-NoProfile",
					"-Command",
					"Set-Location '${workspaceFolder}'; pnpm --filter ./packages/core test"
				],
				"options": {
					"shell": {
						"executable": "cmd.exe",
						"args": [
							"/d",
							"/c"
						]
					}
				}
			},
			"options": {
				"shell": {
					"executable": "bash",
					"args": [
						"-lc"
					]
				}
			},
			"isBackground": false,
			"problemMatcher": [],
			"group": "test"
		},
